@page "/empleados"
@attribute [Authorize(Roles = "Admin,Supervisor,Tecnologia")]
@using CreditFlow.Web.Features.Auth.Services
@using CreditFlow.Web.Features.Mantenimientos.Empleados.Models
@using CreditFlow.Web.Features.Mantenimientos.Empleados.Services
@using CreditFlow.Web.Features.Mantenimientos.Empleados.Components

<PageTitle>Mantenimiento de Empleados</PageTitle>

<h3>Empleados</h3>

<GridEstandar TItem="EmpleadoEdicionDto"
              @ref="gridEstandar"
              Data="@ListaEmpleados"
              IsLoading="@Cargando"
              EmptyText="No hay empleados registrados."
              ExportFileName="empleados"
              EditMode="DataGridEditMode.Single"
              RowRender="@OnRowRender"
              ShowAddButton="@esAdmin"
              AddDisabled="@(filaEnEdicion != null)"
              AddButtonTitle="Nuevo empleado"
              OnAdd="@NuevoEmpleadoAsync">
    <RadzenDataGridColumn TItem="EmpleadoEdicionDto" Title="" Sortable="false" Filterable="false" Width="90px" CssClass="celda-accion" Visible="@esAdmin" Frozen="true">
        <Template Context="empleado">
            <RadzenButton Icon="edit"
                          ButtonStyle="ButtonStyle.Primary"
                          Variant="Variant.Outlined"
                          Size="ButtonSize.ExtraSmall"
                          Disabled="@(filaEnEdicion != null)"
                          title="Editar empleado"
                          Click="@(() => EditarAsync(empleado))" />
        </Template>
        <EditTemplate Context="empleado">
            <div class="d-flex gap-1">
                <RadzenButton Icon="save"
                              ButtonStyle="ButtonStyle.Primary"
                              Variant="Variant.Outlined"
                              Size="ButtonSize.ExtraSmall"
                              Disabled="@Guardando"
                              title="Guardar cambios"
                              Click="@(() => GuardarAsync(empleado))" />
                <RadzenButton Icon="close"
                              ButtonStyle="ButtonStyle.Secondary"
                              Variant="Variant.Outlined"
                              Size="ButtonSize.ExtraSmall"
                              Disabled="@Guardando"
                              title="Cancelar edición"
                              Click="@(() => CancelarAsync(empleado))" />
            </div>
        </EditTemplate>
    </RadzenDataGridColumn>

    <RadzenDataGridColumn TItem="EmpleadoEdicionDto" Title="" Sortable="false" Filterable="false" Width="80px" Frozen="true">
        <Template Context="empleado">
            <AvatarEmpleado IdEmpleado="@empleado.IdEmpleado"
                            TieneFoto="@(!string.IsNullOrEmpty(empleado.FotoUrl))"
                            Iniciales="@ObtenerIniciales(empleado)"
                            Color="@ObtenerColorAvatar(empleado)" />
        </Template>
        <EditTemplate Context="empleado">
            <AvatarEmpleado IdEmpleado="@empleado.IdEmpleado"
                            TieneFoto="@(!string.IsNullOrEmpty(empleado.FotoUrl))"
                            PreviewUrl="@empleado.FotoPreviewUrl"
                            Iniciales="@ObtenerIniciales(empleado)"
                            Color="@ObtenerColorAvatar(empleado)"
                            Editable="true"
                            OnFotoSeleccionada="@(e => OnFotoSeleccionadaAsync(empleado, e))" />
        </EditTemplate>
    </RadzenDataGridColumn>

    <RadzenDataGridColumn TItem="EmpleadoEdicionDto" Property="@nameof(EmpleadoDto.CodigoUsuario)" Title="Usuario" Width="130px" Frozen="true">
        <Template Context="empleado">@(string.IsNullOrEmpty(empleado.CodigoUsuario) ? "-" : empleado.CodigoUsuario)</Template>
        <EditTemplate Context="empleado">@(string.IsNullOrEmpty(empleado.CodigoUsuario) ? "-" : empleado.CodigoUsuario)</EditTemplate>
    </RadzenDataGridColumn>

    <RadzenDataGridColumn TItem="EmpleadoEdicionDto" Property="@nameof(EmpleadoDto.Documento)" Title="Documento" Width="150px">
        <EditTemplate Context="empleado">
            <RadzenTextBox @bind-Value="empleado.Documento" Disabled="@(empleado.IdEmpleado != 0)" Style="width:100%" />
        </EditTemplate>
    </RadzenDataGridColumn>

    <RadzenDataGridColumn TItem="EmpleadoEdicionDto" Property="@nameof(EmpleadoDto.Nombres)" Title="Nombres" Width="160px">
        <EditTemplate Context="empleado">
            <RadzenTextBox @bind-Value="empleado.Nombres" Style="width:100%" />
        </EditTemplate>
    </RadzenDataGridColumn>

    <RadzenDataGridColumn TItem="EmpleadoEdicionDto" Title="Apellidos" Width="170px" Sortable="false" Filterable="false">
        <Template Context="empleado">@empleado.PrimerApellido @empleado.SegundoApellido</Template>
        <EditTemplate Context="empleado">
            <div class="d-flex gap-1">
                <RadzenTextBox @bind-Value="empleado.PrimerApellido" Placeholder="Primer apellido" Style="width:50%" />
                <RadzenTextBox @bind-Value="empleado.SegundoApellido" Placeholder="Segundo apellido" Style="width:50%" />
            </div>
        </EditTemplate>
    </RadzenDataGridColumn>

    <RadzenDataGridColumn TItem="EmpleadoEdicionDto" Property="@nameof(EmpleadoDto.Sexo)" Title="Sexo" Width="70px" Filterable="false">
        <EditTemplate Context="empleado">
            <RadzenNumeric TValue="int" @bind-Value="empleado.Sexo" Style="width:100%" />
        </EditTemplate>
    </RadzenDataGridColumn>

    <RadzenDataGridColumn TItem="EmpleadoEdicionDto" Property="@nameof(EmpleadoDto.CodAgencia)" Title="Agencia" Width="90px">
        <EditTemplate Context="empleado">
            <RadzenNumeric TValue="int" @bind-Value="empleado.CodAgencia" Style="width:100%" />
        </EditTemplate>
    </RadzenDataGridColumn>

    <RadzenDataGridColumn TItem="EmpleadoEdicionDto" Property="@nameof(EmpleadoDto.Correo)" Title="Correo" Width="220px" Filterable="false">
        <Template Context="empleado">
            <span title="@empleado.Correo" style="display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@empleado.Correo</span>
        </Template>
        <EditTemplate Context="empleado">
            <RadzenTextBox @bind-Value="empleado.Correo" Style="width:100%" />
        </EditTemplate>
    </RadzenDataGridColumn>

    <RadzenDataGridColumn TItem="EmpleadoEdicionDto" Property="@nameof(EmpleadoDto.Telefono)" Title="Teléfono" Width="130px" Filterable="false">
        <EditTemplate Context="empleado">
            <RadzenTextBox @bind-Value="empleado.Telefono" Style="width:100%" />
        </EditTemplate>
    </RadzenDataGridColumn>

    <RadzenDataGridColumn TItem="EmpleadoEdicionDto"
                           Title="Contraseña"
                           Width="160px"
                           Sortable="false"
                           Filterable="false"
                           Visible="@(filaEnEdicion?.IdEmpleado == 0)">
        <Template Context="empleado"></Template>
        <EditTemplate Context="empleado">
            @if (empleado.IdEmpleado == 0)
            {
                <RadzenPassword @bind-Value="empleado.Password" Placeholder="Contraseña" Style="width:100%" />
            }
        </EditTemplate>
    </RadzenDataGridColumn>

    <RadzenDataGridColumn TItem="EmpleadoEdicionDto" Property="@nameof(EmpleadoDto.Rol)" Title="Rol" Width="130px" Filterable="false">
        <Template Context="empleado">@(empleado.Rol ?? "-")</Template>
        <EditTemplate Context="empleado">
            <RadzenDropDown TValue="int"
                             @bind-Value="empleado.IdRol"
                             Data="@Roles"
                             TextProperty="@nameof(RoleDto.Nombre)"
                             ValueProperty="@nameof(RoleDto.IdRol)"
                             Placeholder="-- Seleccionar --"
                             Style="width:100%" />
        </EditTemplate>
    </RadzenDataGridColumn>

    <RadzenDataGridColumn TItem="EmpleadoEdicionDto" Property="@nameof(EmpleadoDto.Estado)" Title="Estado" Width="100px" Filterable="false">
        <Template Context="empleado">@(empleado.Estado == 1 ? "Activo" : "Inactivo")</Template>
        <EditTemplate Context="empleado">
            <RadzenDropDown TValue="int"
                             @bind-Value="empleado.Estado"
                             Data="@EstadoOpciones"
                             TextProperty="@nameof(OpcionEstado.Texto)"
                             ValueProperty="@nameof(OpcionEstado.Valor)"
                             Disabled="@(empleado.IdEmpleado == 0)"
                             Style="width:100%" />
        </EditTemplate>
    </RadzenDataGridColumn>
</GridEstandar>

@code {
    [Inject] private IEmpleadoService EmpleadoService { get; set; } = default!;
    [Inject] private IAuthService AuthService { get; set; } = default!;
    [Inject] private DialogService DialogService { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private record OpcionEstado(int Valor, string Texto);

    private static readonly List<OpcionEstado> EstadoOpciones = new()
    {
        new OpcionEstado(1, "Activo"),
        new OpcionEstado(0, "Inactivo")
    };

    private class EmpleadoEdicionDto : EmpleadoDto
    {
        public int IdRol { get; set; }

        public string? Password { get; set; }

        public IBrowserFile? FotoSeleccionada { get; set; }

        public string? FotoPreviewUrl { get; set; }
    }

    private GridEstandar<EmpleadoEdicionDto> gridEstandar = default!;

    private List<EmpleadoEdicionDto> ListaEmpleados { get; set; } = new();
    private List<RoleDto> Roles { get; set; } = new();

    private EmpleadoEdicionDto? filaEnEdicion;
    private EmpleadoEdicionDto? backupOriginal;

    private bool Cargando = true;
    private bool Guardando;
    private bool esAdmin;

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            esAdmin = authState.User.IsInRole("Admin");
        }

        Roles = await AuthService.ObtenerRolesAsync();
        await CargarEmpleadosAsync();
    }

    private async Task CargarEmpleadosAsync()
    {
        Cargando = true;
        var empleados = await EmpleadoService.ObtenerTodosAsync();
        ListaEmpleados = empleados.Select(MapearAEdicion).ToList();
        Cargando = false;
    }

    private EmpleadoEdicionDto MapearAEdicion(EmpleadoDto e) => new()
    {
        IdEmpleado = e.IdEmpleado,
        IdUsuario = e.IdUsuario,
        Documento = e.Documento,
        CodigoUsuario = e.CodigoUsuario,
        FotoUrl = e.FotoUrl,
        Nombres = e.Nombres,
        PrimerApellido = e.PrimerApellido,
        SegundoApellido = e.SegundoApellido,
        Sexo = e.Sexo,
        CodAgencia = e.CodAgencia,
        Correo = e.Correo,
        Telefono = e.Telefono,
        Estado = e.Estado,
        Rol = e.Rol,
        IdRol = Roles.FirstOrDefault(r => r.Nombre == e.Rol)?.IdRol ?? 0
    };

    private static readonly string[] ColoresAvatar =
    {
        "#142143", "#1a5d94", "#2c3f6b", "#0f3a5e", "#0f1a35"
    };

    private static string ObtenerIniciales(EmpleadoEdicionDto empleado)
    {
        var inicialNombre = string.IsNullOrWhiteSpace(empleado.Nombres) ? "" : empleado.Nombres.Trim()[0].ToString();
        var inicialApellido = string.IsNullOrWhiteSpace(empleado.PrimerApellido) ? "" : empleado.PrimerApellido.Trim()[0].ToString();
        return (inicialNombre + inicialApellido).ToUpperInvariant();
    }

    private static string ObtenerColorAvatar(EmpleadoEdicionDto empleado)
    {
        var clave = $"{empleado.Nombres}{empleado.PrimerApellido}";
        var indice = Math.Abs(clave.GetHashCode()) % ColoresAvatar.Length;
        return ColoresAvatar[indice];
    }

    private void OnRowRender(RowRenderEventArgs<EmpleadoEdicionDto> args)
    {
        if (filaEnEdicion is not { } fila || !ReferenceEquals(args.Data, fila))
            return;

        args.Attributes["style"] = fila.IdEmpleado == 0
            ? "background-color: #e6f7ec;"
            : "background-color: #e7f1fd;";
    }

    private async Task NuevoEmpleadoAsync()
    {
        var nuevo = new EmpleadoEdicionDto { Estado = 1 };
        filaEnEdicion = nuevo;
        await gridEstandar.Grid.InsertRow(nuevo);
    }

    private const long TamanoMaximoFotoBytes = 5 * 1024 * 1024; // 5MB

    private async Task OnFotoSeleccionadaAsync(EmpleadoEdicionDto empleado, InputFileChangeEventArgs e)
    {
        var archivo = e.File;

        if (archivo.Size > TamanoMaximoFotoBytes)
        {
            await DialogService.Alert("La foto no puede superar los 5MB.", "Error");
            return;
        }

        using var stream = archivo.OpenReadStream(TamanoMaximoFotoBytes);
        using var memoria = new MemoryStream();
        await stream.CopyToAsync(memoria);

        empleado.FotoSeleccionada = archivo;
        empleado.FotoPreviewUrl = $"data:{archivo.ContentType};base64,{Convert.ToBase64String(memoria.ToArray())}";
    }

    private async Task EditarAsync(EmpleadoEdicionDto empleado)
    {
        backupOriginal = ClonarValores(empleado);
        filaEnEdicion = empleado;
        await gridEstandar.Grid.EditRow(empleado);
    }

    private void CancelarAsync(EmpleadoEdicionDto empleado)
    {
        gridEstandar.Grid.CancelEditRow(empleado);

        if (empleado.IdEmpleado != 0 && backupOriginal is not null)
        {
            CopiarValores(backupOriginal, empleado);
        }

        empleado.FotoSeleccionada = null;
        empleado.FotoPreviewUrl = null;

        backupOriginal = null;
        filaEnEdicion = null;
    }

    private async Task GuardarAsync(EmpleadoEdicionDto empleado)
    {
        var esNuevo = empleado.IdEmpleado == 0;

        if (esNuevo && (string.IsNullOrWhiteSpace(empleado.Documento) || string.IsNullOrWhiteSpace(empleado.Password)))
        {
            await DialogService.Alert("Documento y contraseña son obligatorios.", "Error");
            return;
        }

        if (empleado.IdRol <= 0)
        {
            await DialogService.Alert("Debe seleccionar un rol.", "Error");
            return;
        }

        Guardando = true;
        bool exito;
        string? mensaje;

        if (esNuevo)
        {
            var request = new CrearEmpleadoRequest
            {
                Documento = empleado.Documento,
                Nombres = empleado.Nombres,
                PrimerApellido = empleado.PrimerApellido,
                SegundoApellido = empleado.SegundoApellido,
                Sexo = empleado.Sexo,
                CodAgencia = empleado.CodAgencia,
                Correo = empleado.Correo,
                Telefono = empleado.Telefono,
                Password = empleado.Password!,
                IdRol = empleado.IdRol,
                Foto = empleado.FotoSeleccionada
            };
            (exito, mensaje) = await EmpleadoService.CrearAsync(request);
        }
        else
        {
            var request = new ActualizarEmpleadoRequest
            {
                Nombres = empleado.Nombres,
                PrimerApellido = empleado.PrimerApellido,
                SegundoApellido = empleado.SegundoApellido,
                Sexo = empleado.Sexo,
                CodAgencia = empleado.CodAgencia,
                Correo = empleado.Correo,
                Telefono = empleado.Telefono,
                Estado = empleado.Estado,
                IdRol = empleado.IdRol,
                Foto = empleado.FotoSeleccionada
            };
            (exito, mensaje) = await EmpleadoService.ActualizarAsync(empleado.IdEmpleado, request);
        }

        Guardando = false;

        if (!exito)
        {
            await DialogService.Alert(mensaje ?? "Ocurrió un error al guardar.", "Error");
            return;
        }

        await gridEstandar.Grid.UpdateRow(empleado);
        backupOriginal = null;
        filaEnEdicion = null;

        await DialogService.Alert(esNuevo ? "Empleado creado correctamente." : "Empleado actualizado correctamente.", "Éxito");
        await CargarEmpleadosAsync();
    }

    private static EmpleadoEdicionDto ClonarValores(EmpleadoEdicionDto origen) => new()
    {
        IdEmpleado = origen.IdEmpleado,
        IdUsuario = origen.IdUsuario,
        Documento = origen.Documento,
        Nombres = origen.Nombres,
        PrimerApellido = origen.PrimerApellido,
        SegundoApellido = origen.SegundoApellido,
        Sexo = origen.Sexo,
        CodAgencia = origen.CodAgencia,
        Correo = origen.Correo,
        Telefono = origen.Telefono,
        Estado = origen.Estado,
        Rol = origen.Rol,
        IdRol = origen.IdRol
    };

    private static void CopiarValores(EmpleadoEdicionDto origen, EmpleadoEdicionDto destino)
    {
        destino.Nombres = origen.Nombres;
        destino.PrimerApellido = origen.PrimerApellido;
        destino.SegundoApellido = origen.SegundoApellido;
        destino.Sexo = origen.Sexo;
        destino.CodAgencia = origen.CodAgencia;
        destino.Correo = origen.Correo;
        destino.Telefono = origen.Telefono;
        destino.Estado = origen.Estado;
        destino.Rol = origen.Rol;
        destino.IdRol = origen.IdRol;
    }
}
