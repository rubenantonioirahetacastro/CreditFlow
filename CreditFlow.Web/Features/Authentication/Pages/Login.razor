@page "/login"
@layout LoginLayout
@using CreditFlow.Web.Features.Authentication.Components

@* Sin barra superior: el título solo va en la pestaña del navegador. *@
<PageTitle>Iniciar sesión · CrediFlow</PageTitle>

<div class="login-page">
    <AuthHero />

    <main class="login-page__panel">
        <LoginForm Error="@Error" />
    </main>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }
}
