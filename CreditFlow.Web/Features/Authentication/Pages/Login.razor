@page "/login"
@layout LoginLayout

<PageTitle>Iniciar sesión</PageTitle>

<CdsCard Padding="CdsCardPadding.Spacious" Class="login-card">
    <h3>Iniciar sesión</h3>

    @if (!string.IsNullOrEmpty(Error))
    {
        <div class="alert alert-danger" role="alert">@Error</div>
    }

    <form method="post" action="/login">
        <AntiforgeryToken />

        <div class="mb-3">
            <label class="form-label" for="documento">Documento</label>
            <CdsTextField NativeForm="true" id="documento" name="documento" autocomplete="username" required />
        </div>
        <div class="mb-3">
            <label class="form-label" for="password">Contraseña</label>
            <CdsPasswordField NativeForm="true" id="password" name="password" autocomplete="current-password" required />
        </div>
        <CdsButton Text="Ingresar" ButtonType="ButtonType.Submit" />
    </form>
</CdsCard>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }
}
