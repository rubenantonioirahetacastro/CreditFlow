@* Panel de marca de la pantalla de acceso: fondo oscuro con luces en movimiento, mensaje y beneficios en vidrio. *@
<aside class="auth-hero" aria-hidden="true">
    <span class="auth-hero__glow auth-hero__glow--primary"></span>
    <span class="auth-hero__glow auth-hero__glow--accent"></span>
    <span class="auth-hero__glow auth-hero__glow--soft"></span>
    <span class="auth-hero__grid"></span>

    <div class="auth-hero__content">
        <span class="auth-hero__mark">
            <img src="images/crediflow-mark.svg" alt="" />
        </span>

        <div class="auth-hero__message">
            <span class="auth-hero__eyebrow">Plataforma de otorgamiento de créditos</span>
            <span class="auth-hero__headline">Créditos que fluyen, decisiones con claridad.</span>
            <span class="auth-hero__text">Evalúa, aprueba y da seguimiento a cada crédito desde un solo lugar.</span>
        </div>

        <ul class="auth-hero__features">
            <li class="auth-hero__feature">
                <span class="auth-hero__feature-icon"><RadzenIcon Icon="bolt" /></span>
                <span>Evaluación y verificación en minutos</span>
            </li>
            <li class="auth-hero__feature">
                <span class="auth-hero__feature-icon"><RadzenIcon Icon="monitoring" /></span>
                <span>Cartera y desembolsos en tiempo real</span>
            </li>
            <li class="auth-hero__feature">
                <span class="auth-hero__feature-icon"><RadzenIcon Icon="verified_user" /></span>
                <span>Acceso seguro según tu rol</span>
            </li>
        </ul>

        <span class="auth-hero__footer">© @DateTime.Today.Year CrediFlow</span>
    </div>
</aside>
