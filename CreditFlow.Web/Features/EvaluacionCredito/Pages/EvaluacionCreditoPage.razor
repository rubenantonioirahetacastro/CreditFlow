@page "/otorgamiento/evaluacion/{NCodAge:int}/{NCodCred:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@using CreditFlow.Web.Features.EvaluacionCredito.Models
@using CreditFlow.Web.Features.EvaluacionCredito.Services
@using CreditFlow.Web.Shared.CatalogoCodigos.Models
@using CreditFlow.Web.Shared.CatalogoCodigos.Services

<PageTitle>Evaluación de crédito</PageTitle>

@if (cargando)
{
    <div style="padding:40px;text-align:center;color:#98a2b3;font:500 13px 'Plus Jakarta Sans',sans-serif;">Cargando expediente…</div>
}
else if (detalle is null)
{
    <div style="padding:40px;text-align:center;color:#912018;font:500 13px 'Plus Jakarta Sans',sans-serif;">No se pudo cargar la solicitud @NCodAge-@NCodCred.</div>
}
else
{
    <div style="min-height:100vh;display:flex;flex-direction:column;background:#eef1f5;font-family:'Plus Jakarta Sans',system-ui,sans-serif;color:#0c111d;">

        <header style="position:sticky;top:0;z-index:5;background:#fff;border-bottom:1px solid #e4e9f0;">
            <div style="max-width:1500px;margin:0 auto;padding:14px 28px;display:flex;align-items:center;gap:18px;flex-wrap:wrap;">
                <a href="/otorgamiento/procesamiento-datos/bandeja-verificacion" style="display:flex;align-items:center;gap:8px;padding:8px 12px;border:1px solid #dfe4eb;border-radius:10px;font:600 12.5px 'Plus Jakarta Sans',sans-serif;color:#475467;text-decoration:none;">← Bandeja</a>
                <div style="display:flex;align-items:center;gap:12px;min-width:0;">
                    <span style="width:40px;height:40px;flex:none;border-radius:999px;background:#14395c;color:#fff;display:grid;place-items:center;font:700 13px 'Plus Jakarta Sans',sans-serif;">@Iniciales(detalle.Cliente.NombreCompleto)</span>
                    <div style="min-width:0;">
                        <div style="display:flex;align-items:center;gap:9px;flex-wrap:wrap;">
                            <h1 style="margin:0;font:700 18px/1.25 'Plus Jakarta Sans',sans-serif;letter-spacing:-.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@detalle.Cliente.NombreCompleto</h1>
                            <span style="display:inline-flex;align-items:center;gap:6px;padding:4px 9px;border-radius:8px;background:#fff6ea;border:1px solid #f7900933;color:#93370d;font:600 11.5px 'Plus Jakarta Sans',sans-serif;">
                                <span style="width:6px;height:6px;border-radius:99px;background:#f79009;"></span>@(detalle.Credito.EstadoNombre ?? "Sin estado")
                            </span>
                        </div>
                        <div style="font:500 11.5px/1.5 'IBM Plex Mono',monospace;color:#98a2b3;">CRÉDITO @detalle.Credito.NCodAge-@detalle.Credito.NCodCred · @(detalle.Credito.Agencia ?? "—") · gestiona @(detalle.Credito.UsuarioGestion ?? "—") · @detalle.Credito.DFecVig.ToString("d/M/yyyy HH:mm")</div>
                    </div>
                </div>
                <div style="margin-left:auto;display:flex;align-items:center;gap:9px;">
                    <button type="button" @onclick="ConfigurarCalendario" title="Configurar el calendario con las condiciones de este crédito" style="padding:9px 17px;border:none;background:#0c1a2b;border-radius:10px;font:600 13px 'Plus Jakarta Sans',sans-serif;color:#fff;cursor:pointer;">Configurar calendario</button>
                </div>
            </div>
        </header>

        <div style="max-width:1500px;width:100%;margin:0 auto;box-sizing:border-box;padding:22px 28px 40px;display:grid;grid-template-columns:minmax(0,1fr) 384px;gap:20px;align-items:start;">

            <div style="display:flex;flex-direction:column;gap:20px;min-width:0;">

                <div style="background:#fff;border:1px solid #eaeef4;border-radius:16px;padding:22px;display:grid;grid-template-columns:minmax(0,1.15fr) 1px minmax(0,1fr);gap:24px;">
                    <div style="display:flex;flex-direction:column;gap:14px;min-width:0;">
                        <div class="kick" style="@KickStyle">Capacidad de pago declarada</div>
                        @if (detalle.CapacidadPago is { } cap)
                        {
                            <div style="display:flex;flex-direction:column;gap:2px;">
                                @foreach (var (label, valor, esIngreso) in FlujoFilas(cap))
                                {
                                    <div style="display:flex;align-items:center;gap:12px;padding:6px 0;">
                                        <span style="flex:1;font:500 12.5px 'Plus Jakarta Sans',sans-serif;color:#475467;">@label</span>
                                        <span style="font:500 13px 'IBM Plex Mono',monospace;color:@(esIngreso ? "#12b76a" : "#b42318");">@(esIngreso ? "" : "−")@valor.ToString("C2")</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div style="font:500 12.5px 'Plus Jakarta Sans',sans-serif;color:#98a2b3;">No se registró capacidad de pago en la solicitud.</div>
                        }
                    </div>

                    <div style="background:#eaeef4;"></div>

                    <div style="display:flex;flex-direction:column;gap:16px;min-width:0;">
                        <div class="kick" style="@KickStyle">Solicitud</div>
                        <div style="display:flex;align-items:flex-end;gap:10px;">
                            <div style="font:600 34px/1 'IBM Plex Mono',monospace;letter-spacing:-.03em;">@detalle.Credito.NPrestamo.ToString("C2")</div>
                            <div style="padding-bottom:5px;font:500 12.5px 'Plus Jakarta Sans',sans-serif;color:#667085;">solicitado</div>
                        </div>
                        <div style="height:1px;background:#eaeef4;"></div>
                        <div class="kick" style="@KickStyle">Condiciones propuestas</div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:13px 12px;">
                            @foreach (var (k, v) in Condiciones())
                            {
                                <div style="display:flex;flex-direction:column;gap:2px;">
                                    <div style="font:600 10.5px 'Plus Jakarta Sans',sans-serif;letter-spacing:.07em;text-transform:uppercase;color:#98a2b3;">@k</div>
                                    <div style="font:500 13px 'IBM Plex Mono',monospace;">@v</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div style="background:#fff;border:1px solid #eaeef4;border-radius:16px;overflow:hidden;">
                    <div style="display:flex;gap:2px;padding:0 10px;border-bottom:1px solid #eaeef4;overflow-x:auto;">
                        @foreach (var t in TabsDisponibles())
                        {
                            var on = tabActual == t;
                            <button @onclick="() => tabActual = t" style="display:inline-flex;align-items:center;gap:7px;flex:none;padding:14px 12px;border:none;background:transparent;border-bottom:2px solid @(on ? "#0c1a2b" : "transparent");color:@(on ? "#0c111d" : "#667085");font:600 12.5px 'Plus Jakarta Sans',sans-serif;cursor:pointer;white-space:nowrap;">@t</button>
                        }
                    </div>
                    <div style="padding:20px 22px;display:flex;flex-direction:column;gap:14px;">
                        @if (tabActual == "Garantía")
                        {
                            @if (!TieneGarantia())
                            {
                                <div style="font:500 12.5px 'Plus Jakarta Sans',sans-serif;color:#98a2b3;">No se registraron garantías.</div>
                            }
                            else
                            {
                                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:13px 12px;">
                                    <Campo Etiqueta="Tipo de garantía" Valor="@NombreTipoGarantia()" />
                                    <Campo Etiqueta="Marca" Valor="@NombreMarcaGarantia()" />
                                    <Campo Etiqueta="Año" Valor="@NombreAnioGarantia()" />
                                    <Campo Etiqueta="Valor verificado" Valor="@ValorGarantia()" />
                                </div>

                                @if (detalle.Garantia.ValorTotal > 0)
                                {
                                    <div style="font:600 12.5px 'Plus Jakarta Sans',sans-serif;color:#475467;">Cobertura @(detalle.Garantia.CoberturaPorcentaje?.ToString("0.0") ?? "—")%</div>
                                }

                                @if (detalle.Garantia.Fotos.Count > 0)
                                {
                                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;">
                                        @foreach (var f in detalle.Garantia.Fotos)
                                        {
                                            <FotoCard TipoFoto="garantia" IdFoto="@f.IdFoto" ObtenerFoto="EvaluacionCreditoService.ObtenerFotoDataUrlAsync" />
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div style="font:500 12.5px 'Plus Jakarta Sans',sans-serif;color:#98a2b3;">Las fotografías todavía no han sido agregadas.</div>
                                }
                            }
                        }
                        else if (tabActual == "Referencia")
                        {
                            @if (detalle.Fiador is { } fiador)
                            {
                                <div style="display:grid;grid-template-columns:1fr 1fr;gap:13px 12px;">
                                    <Campo Etiqueta="Nombre" Valor="@fiador.NombreCompleto" />
                                    <Campo Etiqueta="Documento" Valor="@fiador.CDocumento" />
                                    <Campo Etiqueta="Dirección" Valor="@fiador.CDireccion" />
                                    <Campo Etiqueta="Celular" Valor="@fiador.CCelular" />
                                </div>
                            }
                            else
                            {
                                <div style="font:500 12.5px 'Plus Jakarta Sans',sans-serif;color:#98a2b3;">No se registró fiador o referencia.</div>
                            }
                        }
                        else if (tabActual == "Verificación")
                        {
                            @if (detalle.Verificaciones.Count == 0)
                            {
                                <div style="font:500 12.5px 'Plus Jakarta Sans',sans-serif;color:#98a2b3;">Todavía no hay verificaciones registradas para esta solicitud.</div>
                            }
                            else
                            {
                                @foreach (var v in detalle.Verificaciones)
                                {
                                    <div style="display:grid;grid-template-columns:minmax(0,1fr) 150px 130px;align-items:center;gap:12px;padding:11px 0;border-top:1px solid #f2f4f7;">
                                        <div style="font:600 13px 'Plus Jakarta Sans',sans-serif;">@v.CNombre</div>
                                        <div style="font:500 12.5px 'IBM Plex Mono',monospace;color:#475467;">@v.DFecha.ToString("d/M/yyyy HH:mm")</div>
                                        <a target="_blank" href="https://www.google.com/maps?q=@v.NLatitud,@v.NLongitud" style="font:600 12px 'Plus Jakarta Sans',sans-serif;">Ver ubicación</a>
                                    </div>
                                }
                            }
                        }
                        else if (tabActual == "Negocio")
                        {
                            @if (detalle.Negocio is { } negocio)
                            {
                                <div style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:13px 12px;">
                                    <Campo Etiqueta="Nombre" Valor="@negocio.CNombre" />
                                    <div style="display:flex;flex-direction:column;gap:2px;">
                                        <div style="font:600 10.5px 'Plus Jakarta Sans',sans-serif;letter-spacing:.07em;text-transform:uppercase;color:#98a2b3;">Dirección negocio</div>
                                        @if (UrlUbicacionNegocio(negocio.CGeolocalizacion) is { } urlUbicacion)
                                        {
                                            <a href="@urlUbicacion" target="_blank" rel="noopener noreferrer" style="font:600 13px 'Plus Jakarta Sans',sans-serif;color:#0875c1;text-decoration:none;">@(string.IsNullOrWhiteSpace(negocio.CDireccion) ? "Ver ubicación" : negocio.CDireccion)</a>
                                        }
                                        else
                                        {
                                            <div style="font:500 13px 'Plus Jakarta Sans',sans-serif;color:#0c111d;">@(string.IsNullOrWhiteSpace(negocio.CDireccion) ? "—" : negocio.CDireccion)</div>
                                        }
                                    </div>
                                    <Campo Etiqueta="Horario" Valor="@HorarioNegocio(negocio)" />
                                    <Campo Etiqueta="Teléfono" Valor="@negocio.CTelefono" />
                                    <Campo Etiqueta="Tipo de negocio" Valor="@NombreTipoNegocio(negocio)" />
                                </div>
                                @if (negocio.Fotos.Count > 0)
                                {
                                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;margin-top:6px;">
                                        @foreach (var f in negocio.Fotos)
                                        {
                                            <FotoCard TipoFoto="negocio" IdFoto="@f.IdFoto" ObtenerFoto="EvaluacionCreditoService.ObtenerFotoDataUrlAsync" />
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div style="font:500 12.5px 'Plus Jakarta Sans',sans-serif;color:#98a2b3;">No se registró negocio.</div>
                            }
                        }
                        else if (tabActual == "Confirmación residencia")
                        {
                            @if (detalle.Documentacion.Fotos.Count == 0)
                            {
                                <div style="font:500 12.5px 'Plus Jakarta Sans',sans-serif;color:#98a2b3;">No hay documentos adjuntos.</div>
                            }
                            else
                            {
                                <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px;">
                                    @foreach (var f in detalle.Documentacion.Fotos)
                                    {
                                        <FotoCard TipoFoto="documentacion" IdFoto="@f.IdFoto" ObtenerFoto="EvaluacionCreditoService.ObtenerFotoDataUrlAsync" Pie="@NombreDocumentoResidencia(f)" />
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;align-items:start;">
                    <div style="background:#fff;border:1px solid #eaeef4;border-radius:16px;padding:18px 20px;display:flex;flex-direction:column;gap:13px;">
                        <div class="kick" style="@KickStyle">Cliente</div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:13px 12px;">
                            <Campo Etiqueta="Documento" Valor="@detalle.Cliente.CDocumento" />
                            <Campo Etiqueta="Vence" Valor="@detalle.Cliente.DFechaVencimientoDocumento.ToString("d/M/yyyy")" />
                            <Campo Etiqueta="Edad" Valor="@(detalle.Cliente.Edad?.ToString() ?? "—")" />
                            <Campo Etiqueta="Celular" Valor="@detalle.Cliente.CCelular" />
                            <Campo Etiqueta="Correo" Valor="@(detalle.Cliente.CCorreo ?? "—")" />
                        </div>
                    </div>

                    <div style="background:#fff;border:1px solid #eaeef4;border-radius:16px;padding:18px 20px;display:flex;flex-direction:column;gap:12px;">
                        <div class="kick" style="@KickStyle">Historial del expediente</div>
                        <div style="max-height:112px;overflow-y:auto;scrollbar-gutter:stable;padding-right:6px;">
                            @foreach (var (nombre, fecha) in Historial())
                            {
                                <div style="min-height:56px;box-sizing:border-box;display:grid;grid-template-columns:12px minmax(0,1fr);gap:11px;align-items:start;">
                                    <div style="display:flex;flex-direction:column;align-items:center;gap:3px;padding-top:4px;">
                                        <span style="width:11px;height:11px;border-radius:99px;background:#f79009;border:2px solid #f79009;"></span>
                                    </div>
                                    <div style="padding-bottom:11px;">
                                        <div style="font:600 13px 'Plus Jakarta Sans',sans-serif;">@nombre</div>
                                        <div style="font:500 11.5px 'IBM Plex Mono',monospace;color:#98a2b3;">@fecha</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div style="display:flex;flex-direction:column;gap:20px;position:sticky;top:88px;max-height:calc(100vh - 108px);overflow:auto;padding-right:2px;">

                <div style="background:#fff;border:1px solid #eaeef4;border-radius:16px;padding:18px 20px;display:flex;flex-direction:column;gap:14px;">
                    <div class="kick" style="@KickStyle">Decisión</div>
                    <div style="display:flex;flex-direction:column;gap:6px;">
                        @foreach (var estado in estadosCatalogo)
                        {
                            var on = estadoElegido == estado.NValor;
                            var color = ColorEstado(estado.CNomCod);
                            var deshabilitado = estado.NValor == EstadoAprobado && !EstaVerificado();
                            <button @onclick="() => estadoElegido = estado.NValor" disabled="@deshabilitado" title="@(deshabilitado ? "La solicitud debe estar verificada antes de aprobarse" : null)" style="display:flex;align-items:flex-start;gap:10px;width:100%;box-sizing:border-box;padding:11px 12px;border:1px solid @(on ? color + "66" : "#eaeef4");border-radius:12px;background:@(on ? color + "12" : "#fff");cursor:@(deshabilitado ? "not-allowed" : "pointer");opacity:@(deshabilitado ? ".52" : "1");">
                                <span style="width:16px;height:16px;flex:none;margin-top:2px;border-radius:99px;border:@(on ? "5px solid " + color : "1.5px solid #cdd5e0");background:#fff;box-sizing:border-box;"></span>
                                <span style="flex:1;text-align:left;font:600 13.5px 'Plus Jakarta Sans',sans-serif;">@estado.CNomCod</span>
                            </button>
                        }
                    </div>
                    <textarea @bind="comentario" placeholder="Comentario de la decisión (queda en el expediente)" style="min-height:66px;resize:vertical;padding:10px 12px;border:1px solid #e4e9f0;border-radius:10px;font:500 12.5px 'Plus Jakarta Sans',sans-serif;outline:none;"></textarea>
                    @if (mensajeError is not null)
                    {
                        <div style="font:500 12px 'Plus Jakarta Sans',sans-serif;color:#912018;">@mensajeError</div>
                    }
                    <button @onclick="() => Guardar(estadoElegido)" disabled="@(estadoElegido is null || guardando)" style="padding:12px;border:none;border-radius:11px;background:#0c1a2b;color:#fff;font:700 13.5px 'Plus Jakarta Sans',sans-serif;cursor:pointer;">@(guardando ? "Guardando…" : "Guardar decisión")</button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int NCodAge { get; set; }
    [Parameter] public int NCodCred { get; set; }

    [Inject] private IEvaluacionCreditoService EvaluacionCreditoService { get; set; } = default!;
    [Inject] private ObtenerCatalogoCodigos ObtenerCatalogoCodigos { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private const int CodigoCatalogoEstadosCredito = 116;
    private const int EstadoEnAnalisis = 2;
    private const int EstadoAprobado = 3;
    private const int EstadoCancelado = 50;

    private const string KickStyle = "font:600 11px 'Plus Jakarta Sans',sans-serif;letter-spacing:.09em;text-transform:uppercase;color:#98a2b3;";

    private EvaluacionCreditoDetalleDto? detalle;
    private List<CatalogoCodigoDto> estadosCatalogo = new();
    private bool cargando = true;
    private bool guardando;
    private string? mensajeError;
    private int? estadoElegido;
    private string comentario = string.Empty;
    private string tabActual = "Negocio";

    protected override async Task OnInitializedAsync()
    {
        var catalogoTask = ObtenerCatalogoCodigos.ObtenerCatalogoCodigo(CodigoCatalogoEstadosCredito);
        var detalleTask = EvaluacionCreditoService.ObtenerDetalleCompletoAsync(NCodAge, NCodCred);

        var catalogo = await catalogoTask;
        estadosCatalogo = catalogo
            .Where(c => c.NValor is EstadoEnAnalisis or EstadoAprobado or EstadoCancelado)
            .OrderBy(c => c.NValor switch
            {
                EstadoEnAnalisis => 0,
                EstadoAprobado => 1,
                EstadoCancelado => 2,
                _ => 3,
            })
            .ToList();
        detalle = await detalleTask;
        estadoElegido = estadosCatalogo.Any(e => e.NValor == detalle?.Credito.NEstado)
            ? detalle?.Credito.NEstado
            : null;

        cargando = false;
    }

    private async Task Guardar(int? nuevoEstado)
    {
        if (nuevoEstado is null || detalle is null) return;

        guardando = true;
        mensajeError = null;
        var (exito, mensaje) = await EvaluacionCreditoService.ActualizarEvaluacionAsync(NCodAge, NCodCred, nuevoEstado.Value);
        guardando = false;

        if (!exito)
        {
            mensajeError = mensaje ?? "No se pudo guardar la decisión.";
            return;
        }

        NavigationManager.NavigateTo("/otorgamiento/procesamiento-datos/bandeja-verificacion");
    }

    private void ConfigurarCalendario()
    {
        if (detalle is null)
            return;

        var credito = detalle.Credito;
        var invariant = System.Globalization.CultureInfo.InvariantCulture;
        var parameters = new List<string>
        {
            $"agencyCode={credito.NCodAge}",
            $"creditCode={credito.NCodCred}",
            $"product={credito.NProd}",
            $"subProduct={credito.NSubProd}",
            $"amount={credito.NPrestamo.ToString(invariant)}",
            $"installments={credito.NNroCuotas}",
            $"startDate={credito.DFecVig:yyyy-MM-dd}"
        };

        if (credito.NCodLinea.HasValue)
            parameters.Add($"creditLineCode={credito.NCodLinea.Value}");

        if (credito.NTasaComp.HasValue)
            parameters.Add($"rate={credito.NTasaComp.Value.ToString(invariant)}");

        NavigationManager.NavigateTo($"/simulador-credito?{string.Join("&", parameters)}");
    }

    private static string Iniciales(string nombreCompleto)
    {
        var partes = nombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var a = partes.Length > 0 ? partes[0][0].ToString() : "";
        var b = partes.Length > 1 ? partes[1][0].ToString() : "";
        return (a + b).ToUpperInvariant();
    }

    private static string ColorEstado(string nombre) => nombre switch
    {
        "Aprobado" => "#12b76a",
        "Verificado" => "#2e90fa",
        "En Analisís" => "#f79009",
        _ => "#667085",
    };

    private bool EstaVerificado() => detalle?.Verificaciones.Count > 0;

    private IEnumerable<(string Label, decimal Valor, bool EsIngreso)> FlujoFilas(CapacidadPagoEvaluacionDto c)
    {
        yield return ("Otros ingresos declarados", c.DOtrosIngresos, true);
        yield return ("Gastos de educación", c.DGastosEducacion, false);
        yield return ("Gastos de alimentación", c.DGastosAlimentacion, false);
        yield return ("Gastos de salud", c.DGastosSalud, false);
        yield return ("Otros gastos", c.DOtrosGastos, false);
    }

    private IEnumerable<(string K, string V)> Condiciones()
    {
        if (detalle is null) yield break;

        yield return ("Subproducto", detalle.Credito.SubProducto ?? "—");
        yield return ("Plazo", $"{detalle.Credito.PlazoMeses} meses");
        yield return ("Cuotas", detalle.Credito.NNroCuotas.ToString());
        yield return ("Tasa", detalle.Credito.NTasaComp is { } tasa ? $"{tasa:0.00} %" : "—");
    }

    private IEnumerable<string> TabsDisponibles()
    {
        yield return "Negocio";
        yield return "Confirmación residencia";
        yield return "Referencia";
        yield return "Garantía";
        yield return "Verificación";
    }

    private bool TieneGarantia() => detalle is not null &&
        (detalle.Garantia.NTipoGarantia > 0 ||
         detalle.Garantia.NMarca > 0 ||
         detalle.Garantia.NAnio > 0 ||
         detalle.Garantia.ValorTotal > 0 ||
         detalle.Garantia.Fotos.Count > 0);

    private string NombreTipoGarantia() => detalle?.Garantia.TipoGarantia
        ?? (detalle?.Garantia.NTipoGarantia > 0 ? detalle.Garantia.NTipoGarantia.ToString() : "Pendiente");

    private string NombreMarcaGarantia() => detalle?.Garantia.Marca
        ?? (detalle?.Garantia.NMarca > 0 ? detalle.Garantia.NMarca.ToString() : "Pendiente");

    private string NombreAnioGarantia() => detalle?.Garantia.Anio
        ?? (detalle?.Garantia.NAnio > 0 ? detalle.Garantia.NAnio.ToString() : "Pendiente");

    private string ValorGarantia() => detalle?.Garantia.ValorTotal > 0
        ? detalle.Garantia.ValorTotal.ToString("C2")
        : "Pendiente de verificación";

    private static string NombreDocumentoResidencia(FotoEvaluacionDto foto) =>
        foto.TipoFotoNombre ?? (foto.TipoFoto > 0 ? $"Documento {foto.TipoFoto}" : "Documento de residencia");

    private static string? UrlUbicacionNegocio(string? coordenadas)
    {
        if (string.IsNullOrWhiteSpace(coordenadas)) return null;
        return $"https://www.google.com/maps?q={Uri.EscapeDataString(coordenadas.Trim())}";
    }

    private static string NombreTipoNegocio(NegocioEvaluacionDto negocio) =>
        negocio.TipoNegocio ?? (negocio.CSector > 0 ? negocio.CSector.ToString() : "—");

    private static string HorarioNegocio(NegocioEvaluacionDto negocio)
    {
        if (string.IsNullOrWhiteSpace(negocio.THoraInicio) && string.IsNullOrWhiteSpace(negocio.THoraCierre))
            return "—";

        return $"{negocio.THoraInicio ?? "—"} – {negocio.THoraCierre ?? "—"}";
    }

    private IEnumerable<(string Nombre, string Fecha)> Historial()
    {
        if (detalle is null) yield break;

        var esVerificado = detalle.Credito.EstadoNombre?.Contains(
            "Verific",
            StringComparison.OrdinalIgnoreCase) == true;

        if (!string.Equals(detalle.Credito.EstadoNombre, "Solicitado", StringComparison.OrdinalIgnoreCase) &&
            (!esVerificado || detalle.Verificaciones.Count == 0))
        {
            yield return (detalle.Credito.EstadoNombre ?? "Estado actual", "Actual");
        }

        foreach (var v in detalle.Verificaciones.OrderByDescending(v => v.DFecha))
        {
            yield return ($"Verificado por {v.CNombre}", v.DFecha.ToString("d/M/yyyy HH:mm"));
        }

        yield return ("Solicitado", detalle.Credito.DFecVig.ToString("d/M/yyyy HH:mm"));
    }
}
