@page "/"
@attribute [Authorize]
@using System.Globalization
@using CreditFlow.Web.Core.Utils.Format
@using CreditFlow.Web.Features.Dashboard.Models
@using CreditFlow.Web.Features.Dashboard.Services
@using CreditFlow.Web.Features.Dashboard.Components
@inject IDashboardService DashboardService
@inject ICdsNotificationService Notifications

<CdsPageHeader Title="Panel de control"
               Icon="home"
               ShowHome="false"
               Description="Indicadores clave de la cartera de créditos." />

@if (cargando && resumen is null)
{
    <CdsPageState Kind="CdsPageStateKind.Loading"
                  Title="Cargando panel de control…" />
}
else if (resumen is null)
{
    <CdsPageState Kind="CdsPageStateKind.Error"
                  Title="No pudimos cargar el panel"
                  Message="@errorCarga"
                  OnAction="@CargarAsync" />
}
else
{
    <div class="cds-page home-page">

        @* Resumen: mismo patrón de indicadores con ícono que la Bandeja y la Evaluación. *@
        <CdsCard Padding="CdsCardPadding.None" Class="home-section">
            <CdsCardHeader Title="Resumen de cartera" Badge="@($"Actualizado {ultimaActualizacion.ToString("d MMM, HH:mm", Cultura)}")">
                <Actions>
                    <CdsButton Text="@(cargando ? "Actualizando…" : "Actualizar")"
                               Icon="refresh"
                               Variant="Variant.Outlined"
                               ButtonStyle="ButtonStyle.Base"
                               Size="ButtonSize.Small"
                               Disabled="@cargando"
                               Click="@CargarAsync" />
                </Actions>
            </CdsCardHeader>
            <div class="home-section__body">
                <div class="home-kpis">
                    <CdsKpi Icon="account_balance_wallet" Label="Cartera vigente" Value="@Money((decimal)animCarteraVigente)"
                            Description="@($"{resumen.Kpis.CreditosActivos} créditos activos")" Strong="true" />
                    <CdsKpi Icon="savings" Label="Monto colocado (histórico)" Value="@Money((decimal)animMontoColocado)"
                            Description="@($"{resumen.Kpis.CreditosTotales} créditos totales")" Strong="true" />
                    <CdsKpi Icon="warning" Label="Cartera en riesgo" Value="@Money((decimal)animCarteraRiesgo)"
                            Description="@($"{animPorcentajeMorosidad:0.00} % de morosidad")" Strong="true" />
                    <CdsKpi Icon="percent" Label="Tasa promedio ponderada" Value="@($"{animTasa:0.00} %")"
                            Description="Sobre saldo vigente" Strong="true" />
                    <CdsKpi Icon="trending_up" Label="Nuevos últimos 30 días" Value="@(((int)Math.Round(animNuevos30)).ToString())"
                            Description="@($"{Money((decimal)animMonto30)} colocados")" Strong="true" />
                </div>
            </div>
        </CdsCard>

        <div class="home-grid">
            <CdsCard Padding="CdsCardPadding.None" Class="home-section">
                <CdsCardHeader Title="Colocación mensual" Badge="Últimos 12 meses" />
                <div class="home-section__body">
                    <RadzenChart class="home-chart" Culture="@Cultura" Animate="true" AnimationDuration="700" AnimateDataUpdates="true">
                        <RadzenColumnSeries Data="@ColocacionMensual()" CategoryProperty="Etiqueta" ValueProperty="Monto"
                                            Title="Monto colocado" Fill="var(--cds-primary)" StrokeWidth="0">
                            <RadzenColumnOptions Radius="4" Margin="6" />
                            <RadzenSeriesDataLabels Visible="true" />
                        </RadzenColumnSeries>
                        @* Polígono de frecuencias: une el extremo de cada columna; misma medida y mismo eje. *@
                        <RadzenLineSeries Data="@ColocacionMensual()" CategoryProperty="Etiqueta" ValueProperty="Monto"
                                          Title="Polígono de frecuencias" Stroke="var(--cds-primary-dark)" StrokeWidth="2"
                                          Interpolation="Interpolation.Spline">
                            <RadzenMarkers MarkerType="MarkerType.Circle" Size="8" Fill="var(--cds-white)" Stroke="var(--cds-primary-dark)" StrokeWidth="2" />
                            <RadzenSeriesDataLabels Visible="false" />
                        </RadzenLineSeries>
                        <RadzenCategoryAxis />
                        <RadzenValueAxis Formatter="@FormatoMonto">
                            <RadzenAxisTitle Text="Monto colocado (USD)" />
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                        <RadzenLegend Position="LegendPosition.Bottom" />
                    </RadzenChart>
                </div>
            </CdsCard>

            <CdsCard Padding="CdsCardPadding.None" Class="home-section">
                <CdsCardHeader Title="Cartera por estado" Badge="Monto colocado" />
                <div class="home-section__body">
                    <RadzenChart class="home-chart" Culture="@Cultura" Animate="true" AnimationDuration="700" AnimateDataUpdates="true">
                        <RadzenBarSeries Data="@Ordenado(resumen.PorEstado)" CategoryProperty="Etiqueta" ValueProperty="Monto"
                                         Title="Monto" Fill="var(--cds-primary)" StrokeWidth="0">
                            <RadzenBarOptions Radius="4" Margin="6" />
                            <RadzenSeriesDataLabels Visible="false" />
                        </RadzenBarSeries>
                        <RadzenCategoryAxis />
                        <RadzenValueAxis Formatter="@FormatoMonto">
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                        <RadzenLegend Visible="false" />
                    </RadzenChart>
                </div>
            </CdsCard>

            <CdsCard Padding="CdsCardPadding.None" Class="home-section">
                <CdsCardHeader Title="Por subproducto" Badge="Monto colocado" />
                <div class="home-section__body">
                    <RadzenChart class="home-chart" Culture="@Cultura" Animate="true" AnimationDuration="700" AnimateDataUpdates="true">
                        <RadzenColumnSeries Data="@resumen.PorSubProducto" CategoryProperty="Etiqueta" ValueProperty="Monto"
                                            Title="Monto colocado" Fill="var(--cds-primary)" StrokeWidth="0">
                            <RadzenColumnOptions Radius="4" Margin="6" />
                            <RadzenSeriesDataLabels Visible="true" />
                        </RadzenColumnSeries>
                        @* Polígono de frecuencias: une el extremo de cada columna; misma medida y mismo eje. *@
                        <RadzenLineSeries Data="@resumen.PorSubProducto" CategoryProperty="Etiqueta" ValueProperty="Monto"
                                          Title="Polígono de frecuencias" Stroke="var(--cds-primary-dark)" StrokeWidth="2"
                                          Interpolation="Interpolation.Spline">
                            <RadzenMarkers MarkerType="MarkerType.Circle" Size="8" Fill="var(--cds-white)" Stroke="var(--cds-primary-dark)" StrokeWidth="2" />
                            <RadzenSeriesDataLabels Visible="false" />
                        </RadzenLineSeries>
                        <RadzenCategoryAxis />
                        <RadzenValueAxis Formatter="@FormatoMonto">
                            <RadzenAxisTitle Text="Monto colocado (USD)" />
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                        <RadzenLegend Position="LegendPosition.Bottom" />
                    </RadzenChart>
                </div>
            </CdsCard>

            <CdsCard Padding="CdsCardPadding.None" Class="home-section">
                <CdsCardHeader Title="Por agencia" Badge="@($"Monto colocado · {resumen.PorAgencia.Count} agencias")" />
                <div class="home-section__body">
                    @* Hasta ~30 agencias: ranking con barras en lugar de gráfico, para que todas sean legibles. *@
                    <RankingList Items="@resumen.PorAgencia.Select(a => new RankingItem(string.IsNullOrWhiteSpace(a.Etiqueta) ? "Sin Agencia" : a.Etiqueta, a.Monto))"
                                 Format="@(v => v.ToString("C0", Cultura))"
                                 AriaLabel="Monto colocado por agencia" />
                </div>
            </CdsCard>

            <CdsCard Padding="CdsCardPadding.None" Class="home-section">
                <CdsCardHeader Title="Distribución de mora" Badge="Créditos activos por días de atraso" />
                <div class="home-section__body">
                    <RadzenChart class="home-chart" Culture="@Cultura" Animate="true" AnimationDuration="700" AnimateDataUpdates="true">
                        <RadzenColumnSeries Data="@resumen.DistribucionMora" CategoryProperty="Rango" ValueProperty="Cantidad"
                                            Title="Créditos" Fill="var(--cds-primary)" StrokeWidth="0">
                            <RadzenColumnOptions Radius="4" Margin="6" />
                            <RadzenSeriesDataLabels Visible="true" />
                        </RadzenColumnSeries>
                        @* Polígono de frecuencias sobre el histograma de días de atraso. *@
                        <RadzenLineSeries Data="@resumen.DistribucionMora" CategoryProperty="Rango" ValueProperty="Cantidad"
                                          Title="Polígono de frecuencias" Stroke="var(--cds-primary-dark)" StrokeWidth="2"
                                          Interpolation="Interpolation.Spline">
                            <RadzenMarkers MarkerType="MarkerType.Circle" Size="8" Fill="var(--cds-white)" Stroke="var(--cds-primary-dark)" StrokeWidth="2" />
                            <RadzenSeriesDataLabels Visible="false" />
                        </RadzenLineSeries>
                        <RadzenCategoryAxis />
                        <RadzenValueAxis>
                            <RadzenAxisTitle Text="Cantidad de créditos" />
                            <RadzenGridLines Visible="true" />
                        </RadzenValueAxis>
                        <RadzenLegend Position="LegendPosition.Bottom" />
                    </RadzenChart>
                </div>
            </CdsCard>

            <CdsCard Padding="CdsCardPadding.None" Class="home-section">
                <CdsCardHeader Title="Créditos de mayor monto" Badge="@($"Top {resumen.TopCreditos.Count}")" />
                <div class="home-section__body">
                    @if (resumen.TopCreditos.Count == 0)
                    {
                        <div class="home-empty">Sin créditos registrados.</div>
                    }
                    else
                    {
                        <ol class="home-top">
                            @foreach (var t in resumen.TopCreditos)
                            {
                                <li class="home-top__row">
                                    <a class="cds-link home-top__code" href="@($"/otorgamiento/evaluacion/{t.NCodAge}/{t.NCodCred}")">@t.NCodAge-@t.NCodCred</a>
                                    <span class="home-top__info">
                                        <span class="home-top__name">@NameFormatter.ToDisplayName(t.Cliente)</span>
                                        <span class="home-top__meta">@(string.IsNullOrWhiteSpace(t.Agencia) ? "Sin Agencia" : t.Agencia) · @(t.Estado ?? "Sin estado")</span>
                                    </span>
                                    <span class="home-top__amount">@Money(t.Monto)</span>
                                </li>
                            }
                        </ol>
                    }
                </div>
            </CdsCard>
        </div>
    </div>
}

@code {
    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-SV");

    private DashboardResumenResponse? resumen;
    private bool cargando = true;
    private string? errorCarga;
    private DateTime ultimaActualizacion;

    private double animCarteraVigente;
    private double animMontoColocado;
    private double animCarteraRiesgo;
    private double animPorcentajeMorosidad;
    private double animTasa;
    private double animNuevos30;
    private double animMonto30;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var teniaDatos = resumen is not null;
        cargando = true;
        StateHasChanged();

        var result = await DashboardService.ObtenerResumenAsync();
        if (result.IsSuccess && result.Data is not null)
        {
            resumen = result.Data;
            errorCarga = null;
            ultimaActualizacion = DateTime.Now;
        }
        else if (teniaDatos)
        {
            Notifications.Error("No se pudo actualizar", result.Message);
        }
        else
        {
            errorCarga = result.Message ?? "No se pudo cargar la información del panel.";
        }

        cargando = false;
        StateHasChanged();

        if (result.IsSuccess && resumen is not null)
        {
            _ = AnimarKpisAsync(resumen);
        }
    }

    private static readonly string[] MesesCortos = ["Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic"];

    private sealed record MesColocacion(string Etiqueta, decimal Monto);

    /// <summary>
    /// Eje de meses con el año separado: cada mes muestra su nombre corto y el año solo aparece donde empieza
    /// (primer mes del gráfico y cada enero): «Sep 2025, Oct, Nov, Dic, Ene 2026, Feb…».
    /// </summary>
    private List<MesColocacion> ColocacionMensual() =>
        (resumen?.ColocacionMensual ?? [])
            .Select((m, i) => new MesColocacion(
                m.Mes is >= 1 and <= 12
                    ? (i == 0 || m.Mes == 1 ? $"{MesesCortos[m.Mes - 1]} {m.Anio}" : MesesCortos[m.Mes - 1])
                    : m.Periodo,
                m.Monto))
            .ToList();

    // Barras horizontales: de mayor a menor, leídas de arriba hacia abajo.
    private static List<DistribucionItem> Ordenado(IEnumerable<DistribucionItem> items) =>
        items.OrderBy(i => i.Monto).ToList();

    private async Task AnimarKpisAsync(DashboardResumenResponse datos)
    {
        var kpis = datos.Kpis;
        await Task.WhenAll(
            AnimarAsync(v => animCarteraVigente = v, (double)kpis.CarteraVigente),
            AnimarAsync(v => animMontoColocado = v, (double)kpis.MontoColocadoTotal),
            AnimarAsync(v => animCarteraRiesgo = v, (double)kpis.CarteraEnRiesgo),
            AnimarAsync(v => animPorcentajeMorosidad = v, (double)kpis.PorcentajeMorosidad),
            AnimarAsync(v => animTasa = v, (double)kpis.TasaPromedioPonderada),
            AnimarAsync(v => animNuevos30 = v, kpis.CreditosUltimos30Dias),
            AnimarAsync(v => animMonto30 = v, (double)kpis.MontoUltimos30Dias)
        );
    }

    private async Task AnimarAsync(Action<double> setter, double destino, int pasos = 26, int delayMs = 16)
    {
        setter(0);
        StateHasChanged();
        for (var i = 1; i <= pasos; i++)
        {
            var t = 1 - Math.Pow(1 - (double)i / pasos, 3);
            setter(destino * t);
            StateHasChanged();
            await Task.Delay(delayMs);
        }
        setter(destino);
        StateHasChanged();
    }

    private static string Money(decimal v) => v.ToString("C2", Cultura);

    // Radzen formatea las etiquetas de datos con la cultura invariante («¤»); este formateador fija «$» (es-SV)
    // para el eje, las etiquetas y los tooltips.
    private static string FormatoMonto(object valor) => Convert.ToDecimal(valor, Cultura).ToString("C0", Cultura);
}
