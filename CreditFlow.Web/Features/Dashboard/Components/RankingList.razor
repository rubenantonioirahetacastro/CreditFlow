@* Ranking con barras proporcionales: legible con muchas categorías (p. ej. 30 agencias), a diferencia de un gráfico de barras. *@
<ol class="ranking" aria-label="@AriaLabel">
    @for (var i = 0; i < ordenados.Count; i++)
    {
        var item = ordenados[i];
        <li class="ranking__row" style="--ranking-bar:@Porcentaje(item.Value)%">
            <span class="ranking__pos">@(i + 1)</span>
            <span class="ranking__label" title="@item.Label">@item.Label</span>
            <span class="ranking__bar" aria-hidden="true"><span class="ranking__fill"></span></span>
            <span class="ranking__value">@Format(item.Value)</span>
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired] public IEnumerable<RankingItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public Func<decimal, string> Format { get; set; } = default!;
    [Parameter] public string? AriaLabel { get; set; }

    private List<RankingItem> ordenados = [];
    private decimal maximo;

    protected override void OnParametersSet()
    {
        ordenados = Items.OrderByDescending(i => i.Value).ToList();
        maximo = ordenados.Count == 0 ? 0 : ordenados.Max(i => i.Value);
    }

    private string Porcentaje(decimal valor) =>
        (maximo <= 0 ? 0 : Math.Round(valor / maximo * 100, 1))
            .ToString(System.Globalization.CultureInfo.InvariantCulture);
}
