@page "/empleados"
@attribute [Authorize(Policy = AuthorizationPolicies.Maintenance)]
@using CreditFlow.Web.Core.Utils.Format
@using CreditFlow.Web.Features.Maintenance.Employee.Components

<CdsPageHeader Title="Empleados"
               Icon="badge"
               Path="@(new PagePathItem[] { "Mantenimientos" })"
               Description="Administra los empleados, sus roles y accesos." />

@if (cargando && empleados.Count == 0)
{
    <CdsPageState Kind="CdsPageStateKind.Loading" Title="Cargando empleados…" />
}
else if (errorCarga is not null && empleados.Count == 0)
{
    <CdsPageState Kind="CdsPageStateKind.Error"
                  Title="No pudimos cargar los empleados"
                  Message="@errorCarga"
                  OnAction="@CargarAsync" />
}
else
{
    <div class="cds-page cds-page--fill emp-page" @ref="paginaRootRef">
        <CdsCard>
            <CdsKpiRow>
                <CdsKpi Icon="groups" Label="Empleados" Value="@empleados.Count.ToString()" Strong="true" />
                <CdsKpi Icon="how_to_reg" Label="Activos" Value="@Activos.ToString()" Strong="true" />
                <CdsKpi Icon="person_off" Label="Inactivos" Value="@((empleados.Count - Activos).ToString())" Strong="true" />
                <CdsKpi Icon="store" Label="Agencias con personal" Value="@AgenciasConPersonal.ToString()" Strong="true" />
            </CdsKpiRow>
        </CdsCard>

        <CdsListCard Title="Personal" Badge="@($"{EmpleadosFiltrados.Count} empleados")">
            <Actions>
                <CdsExportButton Format="CdsExportFormat.Excel"
                                 Disabled="@(EmpleadosFiltrados.Count == 0)"
                                 Click="@(() => grilla.ExportarExcelAsync())" />
                @if (puedeEditar)
                {
                    <CdsButton Text="Nuevo empleado"
                               Icon="person_add"
                               Size="ButtonSize.Small"
                               Click="@(() => AbrirFormulario(null))" />
                }
            </Actions>
            <Filters>
                <CdsTabs AriaLabel="Filtrar empleados por estado">
                    <CdsTab Text="Todos" Count="@empleados.Count" Selected="@(filtroEstado == FiltroEstado.Todos)" OnClick="@(() => filtroEstado = FiltroEstado.Todos)" />
                    <CdsTab Text="Activos" Count="@Activos" Selected="@(filtroEstado == FiltroEstado.Activos)" OnClick="@(() => filtroEstado = FiltroEstado.Activos)" />
                    <CdsTab Text="Inactivos" Count="@(empleados.Count - Activos)" Selected="@(filtroEstado == FiltroEstado.Inactivos)" OnClick="@(() => filtroEstado = FiltroEstado.Inactivos)" />
                </CdsTabs>
            </Filters>
            <Search>
                <CdsTextField NativeForm="true"
                              Value="@filtroTexto"
                              ValueChanged="@(v => filtroTexto = v)"
                              Placeholder="Buscar por nombre, usuario, documento o correo"
                              aria-label="Buscar empleado" />
            </Search>
            <ChildContent>
                <GridEstandar @ref="grilla"
                              TItem="EmpleadoListItem"
                              Data="@EmpleadosFiltrados"
                              EmptyText="@(empleados.Count == 0 ? "Aún no hay empleados registrados." : "No hay empleados que coincidan con el filtro.")"
                              ExportFileName="empleados"
                              ShowAddButton="false"
                              ShowExportButton="false"
                              FillHeight="true">
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.CodigoUsuario)" Title="Usuario" Width="140px" Frozen="true" TextAlign="TextAlign.Left" CssClass="emp-col-usuario">
                        <Template Context="empleado"><span class="cds-mono">@empleado.CodigoUsuario</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.NombreCompleto)" Title="Nombre" Width="260px" Frozen="true" TextAlign="TextAlign.Left">
                        <Template Context="empleado">
                            <EmployeeNameCell Empleado="@empleado" ObtenerFotoDataUrl="@EmpleadoService.ObtenerFotoDataUrlAsync" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.Documento)" Title="Documento" Width="130px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.AgenciaNombre)" Title="Agencia" Width="170px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.RolNombre)" Title="Rol" Width="170px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.Correo)" Title="Correo" Width="230px" TextAlign="TextAlign.Center">
                        <Template Context="empleado"><CdsTruncatedText Text="@empleado.Correo" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.Telefono)" Title="Teléfono" Width="120px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.EstadoTexto)" Title="Estado" Width="140px" TextAlign="TextAlign.Center">
                        <Template Context="empleado">
                            @if (puedeEditar)
                            {
                                <CdsSwitch Value="@empleado.Activo"
                                           Text="@empleado.EstadoTexto"
                                           AriaLabel="@($"Estado de {empleado.NombreCompleto}")"
                                           Disabled="@guardando"
                                           ValueChanged="@(activo => CambiarEstadoAsync(empleado, activo))" />
                            }
                            else
                            {
                                @empleado.EstadoTexto
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Title="Acciones" Width="100px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center" Visible="@puedeEditar">
                        <Template Context="empleado">
                            <CdsButton Icon="edit"
                                       Variant="Variant.Text"
                                       ButtonStyle="ButtonStyle.Base"
                                       Size="ButtonSize.ExtraSmall"
                                       title="Editar empleado"
                                       aria-label="@($"Editar {empleado.NombreCompleto}")"
                                       Click="@(() => AbrirFormulario(empleado.Empleado))" />
                        </Template>
                    </RadzenDataGridColumn>
                </GridEstandar>
            </ChildContent>
        </CdsListCard>
    </div>
}

<EmployeeDrawer Open="@formularioAbierto"
                Empleado="@empleadoEnEdicion"
                Agencias="@agencias"
                Roles="@roles"
                Guardando="@guardando"
                ObtenerFotoDataUrl="@EmpleadoService.ObtenerFotoDataUrlAsync"
                OnClose="@(() => formularioAbierto = false)"
                OnSave="@GuardarAsync" />

<CdsUndoToast Visible="@avisoVisible"
              Version="@avisoVersion"
              Message="@avisoMensaje"
              OnUndo="@(accionDeshacer is null ? default : EventCallback.Factory.Create(this, DeshacerAsync))"
              OnClose="@(() => avisoVisible = false)" />

@code {
    [Inject] private IEmpleadoService EmpleadoService { get; set; } = default!;
    [Inject] private IRoleService RoleService { get; set; } = default!;
    [Inject] private IAgenciaService AgenciaService { get; set; } = default!;
    [Inject] private ICdsNotificationService Notifications { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private enum FiltroEstado { Todos, Activos, Inactivos }

    private ElementReference paginaRootRef;
    private GridEstandar<EmpleadoListItem> grilla = default!;

    private List<EmpleadoListItem> empleados = [];
    private List<AgenciaDto> agencias = [];
    private List<RoleDto> roles = [];
    private bool cargando = true;
    private string? errorCarga;
    private bool guardando;
    private bool puedeEditar;

    private FiltroEstado filtroEstado = FiltroEstado.Todos;
    private string filtroTexto = string.Empty;

    private bool formularioAbierto;
    private EmpleadoDto? empleadoEnEdicion;

    // Aviso con «Deshacer»: guarda la acción inversa del último cambio (nula si no se puede deshacer).
    private bool avisoVisible;
    private int avisoVersion;
    private string avisoMensaje = string.Empty;
    private Func<Task<(bool Exito, string? Mensaje)>>? accionDeshacer;

    private int Activos => empleados.Count(e => e.Activo);

    private int AgenciasConPersonal => empleados.Where(e => e.Activo && e.Empleado.CodAgencia > 0)
        .Select(e => e.Empleado.CodAgencia)
        .Distinct()
        .Count();

    private List<EmpleadoListItem> EmpleadosFiltrados =>
        empleados
            .Where(e => filtroEstado switch
            {
                FiltroEstado.Activos => e.Activo,
                FiltroEstado.Inactivos => !e.Activo,
                _ => true
            })
            .Where(e => string.IsNullOrWhiteSpace(filtroTexto) || e.Coincide(filtroTexto.Trim()))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            puedeEditar = RoleAuthorization.HasAnyRoleId(authState.User, RoleIds.MaintenanceEditAccess);
        }

        await CargarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.FitAsync(paginaRootRef);
    }

    private async Task CargarAsync()
    {
        cargando = true;

        var empleadosTask = EmpleadoService.ObtenerTodosAsync();
        var agenciasTask = AgenciaService.ObtenerTodasAsync();
        var rolesTask = RoleService.ObtenerTodosAsync();
        await Task.WhenAll(empleadosTask, agenciasTask, rolesTask);

        var empleadosResult = await empleadosTask;
        var agenciasResult = await agenciasTask;
        var rolesResult = await rolesTask;

        // Agencias y roles son secundarios: si fallan, el listado se muestra igual y se avisa.
        if (agenciasResult.IsSuccess)
            agencias = (agenciasResult.Data ?? []).OrderBy(a => a.Nombre).ToList();
        if (rolesResult.IsSuccess)
            roles = rolesResult.Data ?? [];
        if (!agenciasResult.IsSuccess || !rolesResult.IsSuccess)
            Notifications.Error("No se pudieron cargar las agencias o los roles", agenciasResult.Message ?? rolesResult.Message);

        if (empleadosResult.IsSuccess)
        {
            var nombresAgencia = agencias.ToDictionary(a => a.NCodAge, a => a.Nombre);
            empleados = (empleadosResult.Data ?? [])
                .Select(e => EmpleadoListItem.Crear(e, nombresAgencia))
                .OrderBy(e => e.NombreCompleto)
                .ToList();
            errorCarga = null;
        }
        else if (empleados.Count > 0)
        {
            Notifications.Error("No se pudieron actualizar los empleados", empleadosResult.Message);
        }
        else
        {
            errorCarga = empleadosResult.Message ?? "No se pudieron cargar los empleados.";
        }

        cargando = false;
    }

    private void AbrirFormulario(EmpleadoDto? empleado)
    {
        empleadoEnEdicion = empleado;
        formularioAbierto = true;
    }

    private async Task GuardarAsync(EmpleadoFormulario formulario)
    {
        var anterior = empleadoEnEdicion;
        var nombre = NameFormatter.ToDisplayName($"{formulario.Nombres} {formulario.PrimerApellido}");

        guardando = true;
        var (exito, mensaje) = anterior is null
            ? await EmpleadoService.CrearAsync(formulario.ACrear())
            : await EmpleadoService.ActualizarAsync(anterior.IdEmpleado, formulario.AActualizar());
        guardando = false;

        if (!exito)
        {
            Notifications.Error("No se pudo guardar el empleado", mensaje);
            return;
        }

        formularioAbierto = false;
        await CargarAsync();

        // Crear no se puede deshacer: la API solo da de baja (y el documento queda ocupado).
        MostrarAviso(
            anterior is null ? $"Empleado «{nombre}» creado" : $"Empleado «{nombre}» actualizado",
            anterior is null
                ? null
                : () => EmpleadoService.ActualizarAsync(anterior.IdEmpleado, ARestaurar(anterior)));
    }

    private async Task CambiarEstadoAsync(EmpleadoListItem item, bool activo)
    {
        var anterior = item.Empleado;
        var request = ARestaurar(anterior);
        request.Estado = activo ? EmpleadoConvenciones.EstadoActivo : EmpleadoConvenciones.EstadoInactivo;

        guardando = true;
        var (exito, mensaje) = await EmpleadoService.ActualizarAsync(anterior.IdEmpleado, request);
        guardando = false;

        if (!exito)
        {
            Notifications.Error("No se pudo cambiar el estado", mensaje);
            await CargarAsync();
            return;
        }

        await CargarAsync();
        MostrarAviso(
            $"«{item.NombreCompleto}» {(activo ? "activado" : "desactivado")}",
            () => EmpleadoService.ActualizarAsync(anterior.IdEmpleado, ARestaurar(anterior)));
    }

    /// <summary>Petición que deja el empleado como estaba (sin foto: la foto anterior no se puede restaurar).</summary>
    private static ActualizarEmpleadoRequest ARestaurar(EmpleadoDto empleado)
    {
        var request = EmpleadoFormulario.Desde(empleado).AActualizar();
        request.Estado = empleado.Estado;
        return request;
    }

    private void MostrarAviso(string mensaje, Func<Task<(bool Exito, string? Mensaje)>>? deshacer)
    {
        avisoMensaje = mensaje;
        accionDeshacer = deshacer;
        avisoVersion++;
        avisoVisible = true;
    }

    private async Task DeshacerAsync()
    {
        avisoVisible = false;
        if (accionDeshacer is null)
            return;

        var (exito, mensaje) = await accionDeshacer();
        accionDeshacer = null;
        if (!exito)
        {
            Notifications.Error("No se pudo deshacer el cambio", mensaje);
            return;
        }

        await CargarAsync();
        Notifications.Info("Cambio deshecho");
    }
}
