@page "/empleados"
@attribute [Authorize(Policy = AuthorizationPolicies.Maintenance)]
@using CreditFlow.Web.Features.Maintenance.Employee.Components
@using CreditFlow.Web.Core.Utils.Format

<CdsPageHeader Title="Empleados"
               Icon="badge"
               Path="@(new PagePathItem[] { "Mantenimientos" })"
               Description="Administra los empleados, sus roles y accesos." />

@if (cargando && empleados.Count == 0)
{
    <CdsPageState Kind="CdsPageStateKind.Loading" Title="Cargando empleados…" />
}
else if (errorCarga is not null && empleados.Count == 0)
{
    <CdsPageState Kind="CdsPageStateKind.Error"
                  Title="No pudimos cargar los empleados"
                  Message="@errorCarga"
                  OnAction="@CargarAsync" />
}
else
{
    <div class="cds-page cds-page--fill emp-page" @ref="paginaRootRef">
        <EmployeeSummary Total="@empleados.Count"
                         Activos="@Activos"
                         Inactivos="@(empleados.Count - Activos)"
                         Agencias="@AgenciasConPersonal" />

        <CdsCard Padding="CdsCardPadding.None" Class="emp-table-card">
            <CdsCardHeader Title="Listado de empleados" Badge="@($"{EmpleadosFiltrados.Count} empleados")">
                <Actions>
                    <CdsExportButton Format="CdsExportFormat.Excel"
                                     Disabled="@(EmpleadosFiltrados.Count == 0)"
                                     Click="@(() => grilla.ExportarExcelAsync())" />
                    @if (esAdmin)
                    {
                        <CdsButton Text="Nuevo empleado"
                                   Icon="person_add"
                                   Size="ButtonSize.Small"
                                   Click="@(() => AbrirPanel(null))" />
                    }
                </Actions>
            </CdsCardHeader>

            <div class="emp-filters">
                <CdsTabs AriaLabel="Filtrar empleados por estado">
                    <CdsTab Text="Todos" Count="@empleados.Count" Selected="@(filtroEstado == FiltroEstado.Todos)" OnClick="@(() => filtroEstado = FiltroEstado.Todos)" />
                    <CdsTab Text="Activos" Count="@Activos" Selected="@(filtroEstado == FiltroEstado.Activos)" OnClick="@(() => filtroEstado = FiltroEstado.Activos)" />
                    <CdsTab Text="Inactivos" Count="@(empleados.Count - Activos)" Selected="@(filtroEstado == FiltroEstado.Inactivos)" OnClick="@(() => filtroEstado = FiltroEstado.Inactivos)" />
                </CdsTabs>
                <div class="emp-filters__search">
                    <CdsTextField NativeForm="true"
                                  Value="@filtroTexto"
                                  ValueChanged="@(v => filtroTexto = v)"
                                  Placeholder="Buscar por nombre, usuario o documento"
                                  aria-label="Buscar empleados" />
                </div>
            </div>

            <div class="emp-grid">
                <GridEstandar @ref="grilla"
                              TItem="EmpleadoListItem"
                              Data="@EmpleadosFiltrados"
                              EmptyText="@(empleados.Count == 0 ? "Aún no hay empleados registrados." : "No hay empleados que coincidan con el filtro.")"
                              ExportFileName="empleados"
                              ShowAddButton="false"
                              ShowExportButton="false"
                              FillHeight="true"
                              SelectionMode="DataGridSelectionMode.Single"
                              RowSelect="@(item => AbrirPanel(item))">
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.UsuarioVisible)" Title="Usuario" Width="145px" Filterable="false" Frozen="true" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <span class="cds-mono">@item.UsuarioVisible</span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.NombreVisible)" Title="Nombre" Width="260px" Frozen="true" TextAlign="TextAlign.Left">
                        <Template Context="item">
                            <span class="emp-person">
                                <Avatar Id="@item.IdEmpleado"
                                        Tamano="32"
                                        TieneFoto="@item.TieneFoto"
                                        Iniciales="@item.Iniciales"
                                        Color="@item.ColorAvatar"
                                        ObtenerFotoDataUrl="@EmpleadoService.ObtenerFotoDataUrlAsync" />
                                <CdsTruncatedText Text="@item.NombreVisible" />
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.DocumentoVisible)" Title="Documento" Width="175px" Filterable="false" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.AgenciaVisible)" Title="Agencia" Width="170px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.RolVisible)" Title="Rol" Width="170px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.CorreoVisible)" Title="Correo" Width="240px" Filterable="false" TextAlign="TextAlign.Center">
                        <Template Context="item">
                            <CdsTruncatedText Text="@item.CorreoVisible" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.TelefonoVisible)" Title="Teléfono" Width="110px" Filterable="false" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Property="@nameof(EmpleadoListItem.EstadoVisible)" Title="Estado" Width="100px" Filterable="false" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="EmpleadoListItem" Title="Acciones" Width="125px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center" Visible="@esAdmin" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                        <Template Context="item">
                            @* stopPropagation: la fila también abre el panel; evita abrirlo dos veces. *@
                            <span @onclick:stopPropagation="true">
                                <CdsButton Icon="edit"
                                           Variant="Variant.Text"
                                           ButtonStyle="ButtonStyle.Base"
                                           Size="ButtonSize.ExtraSmall"
                                           title="@($"Editar a {item.NombreVisible}")"
                                           aria-label="@($"Editar a {item.NombreVisible}")"
                                           Click="@(() => AbrirPanel(item))" />
                            </span>
                        </Template>
                    </RadzenDataGridColumn>
                </GridEstandar>
            </div>
        </CdsCard>
    </div>
}

<EmployeeDrawer Open="@panelAbierto"
                Empleado="@empleadoEnEdicion"
                Agencias="@agencias"
                Roles="@roles"
                Guardando="@guardando"
                ObtenerFotoDataUrl="@EmpleadoService.ObtenerFotoDataUrlAsync"
                OnClose="@(() => panelAbierto = false)"
                OnSave="@GuardarAsync" />

<CdsUndoToast Visible="@avisoVisible"
              Version="@avisoVersion"
              Message="@avisoMensaje"
              OnUndo="@(accionDeshacer is null ? default : EventCallback.Factory.Create(this, DeshacerAsync))"
              OnClose="@(() => avisoVisible = false)" />

@code {
    [Inject] private IEmpleadoService EmpleadoService { get; set; } = default!;
    [Inject] private IRoleService RoleService { get; set; } = default!;
    [Inject] private IAgenciaService AgenciaService { get; set; } = default!;
    [Inject] private ICdsNotificationService Notifications { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private enum FiltroEstado { Todos, Activos, Inactivos }

    private ElementReference paginaRootRef;
    private GridEstandar<EmpleadoListItem> grilla = default!;

    private List<EmpleadoListItem> empleados = [];
    private List<RoleDto> roles = [];
    private List<AgenciaDto> agencias = [];

    private bool cargando = true;
    private string? errorCarga;
    private bool guardando;
    private bool esAdmin;

    private FiltroEstado filtroEstado = FiltroEstado.Todos;
    private string filtroTexto = string.Empty;

    private bool panelAbierto;
    private EmpleadoDto? empleadoEnEdicion;

    // Aviso con «Deshacer»: guarda la acción inversa del último cambio (nula si no se puede deshacer).
    private bool avisoVisible;
    private int avisoVersion;
    private string avisoMensaje = string.Empty;
    private Func<Task<(bool Exito, string? Mensaje)>>? accionDeshacer;

    private int Activos => empleados.Count(e => e.Activo);

    private int AgenciasConPersonal => empleados
        .Where(e => e.Activo && e.Empleado.CodAgencia > 0)
        .Select(e => e.Empleado.CodAgencia)
        .Distinct()
        .Count();

    private List<EmpleadoListItem> EmpleadosFiltrados
    {
        get
        {
            var texto = filtroTexto.Trim();
            var digitos = DigitFormatter.OnlyDigits(texto, 14);
            return empleados
                .Where(e => filtroEstado switch
                {
                    FiltroEstado.Activos => e.Activo,
                    FiltroEstado.Inactivos => !e.Activo,
                    _ => true
                })
                .Where(e => texto.Length == 0 ||
                            e.NombreVisible.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                            e.UsuarioVisible.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                            e.CorreoVisible.Contains(texto, StringComparison.OrdinalIgnoreCase) ||
                            (digitos.Length > 0 && e.Empleado.Documento.Contains(digitos)))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            esAdmin = RoleAuthorization.HasAnyRoleId(authState.User, RoleIds.GlobalAdministrators);
        }

        await CargarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.FitAsync(paginaRootRef);
    }

    private async Task CargarAsync()
    {
        cargando = true;

        var empleadosTask = EmpleadoService.ObtenerTodosAsync();
        var rolesTask = RoleService.ObtenerTodosAsync();
        var agenciasTask = AgenciaService.ObtenerTodasAsync();
        await Task.WhenAll(empleadosTask, rolesTask, agenciasTask);

        var rolesResult = await rolesTask;
        if (rolesResult.IsSuccess)
            roles = rolesResult.Data ?? [];

        // Sin agencias la tabla muestra el código; no impide trabajar.
        var agenciasResult = await agenciasTask;
        if (agenciasResult.IsSuccess)
            agencias = (agenciasResult.Data ?? []).OrderBy(a => a.Nombre).ToList();

        var empleadosResult = await empleadosTask;
        if (empleadosResult.IsSuccess)
        {
            var nombresAgencia = agencias.ToDictionary(a => a.NCodAge, a => NameFormatter.ToDisplayName(a.Nombre));
            empleados = (empleadosResult.Data ?? [])
                .Select(e => new EmpleadoListItem(e, nombresAgencia.GetValueOrDefault(e.CodAgencia)))
                .OrderBy(e => e.NombreVisible)
                .ToList();
            errorCarga = null;
        }
        else if (empleados.Count > 0)
        {
            Notifications.Error("No se pudieron actualizar los empleados", empleadosResult.Message);
        }
        else
        {
            errorCarga = empleadosResult.Message ?? "No se pudieron cargar los empleados.";
        }

        if (empleadosResult.IsSuccess && !rolesResult.IsSuccess)
            Notifications.Error("No se pudieron cargar los roles", rolesResult.Message);

        cargando = false;
    }

    private void AbrirPanel(EmpleadoListItem? item)
    {
        if (!esAdmin)
            return;

        empleadoEnEdicion = item?.Empleado;
        panelAbierto = true;
    }

    private async Task GuardarAsync(EmpleadoFormModel modelo)
    {
        var anterior = empleadoEnEdicion;
        var nombre = NameFormatter.ToDisplayName($"{modelo.Nombres} {modelo.PrimerApellido}");

        guardando = true;
        var (exito, mensaje) = modelo.EsNuevo
            ? await EmpleadoService.CrearAsync(modelo.ACrear())
            : await EmpleadoService.ActualizarAsync(modelo.IdEmpleado, modelo.AActualizar());
        guardando = false;

        if (!exito)
        {
            Notifications.Error("No se pudo guardar el empleado", mensaje);
            return;
        }

        panelAbierto = false;
        await CargarAsync();

        if (anterior is null)
        {
            // Crear no se deshace: la API solo da de baja lógica y el usuario ya quedó creado.
            MostrarAviso($"Empleado «{nombre}» creado", null);
            return;
        }

        var cambioEstado = EmpleadoConvenciones.EsActivo(anterior) != modelo.Activo;
        MostrarAviso(
            cambioEstado ? $"«{nombre}» {(modelo.Activo ? "activado" : "desactivado")}" : $"Empleado «{nombre}» actualizado",
            // La foto no se restaura: el formulario solo envía una foto nueva cuando se elige una.
            () => EmpleadoService.ActualizarAsync(anterior.IdEmpleado, EmpleadoFormModel.Desde(anterior).AActualizar()));
    }

    private void MostrarAviso(string mensaje, Func<Task<(bool Exito, string? Mensaje)>>? deshacer)
    {
        avisoMensaje = mensaje;
        accionDeshacer = deshacer;
        avisoVersion++;
        avisoVisible = true;
    }

    private async Task DeshacerAsync()
    {
        avisoVisible = false;
        if (accionDeshacer is null)
            return;

        var (exito, mensaje) = await accionDeshacer();
        accionDeshacer = null;
        if (!exito)
        {
            Notifications.Error("No se pudo deshacer el cambio", mensaje);
            return;
        }

        await CargarAsync();
        Notifications.Info("Cambio deshecho");
    }
}
