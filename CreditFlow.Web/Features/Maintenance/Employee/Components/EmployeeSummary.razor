@* Resumen de la página: cuatro indicadores con ícono, del mismo ancho y separados por líneas verticales. *@
<CdsCard>
    <div class="employee-summary">
        <CdsKpi Icon="groups" Label="Empleados" Value="@Total.ToString()" Strong="true" />
        <CdsKpi Icon="how_to_reg" Label="Activos" Value="@Activos.ToString()" Strong="true" />
        <CdsKpi Icon="person_off" Label="Inactivos" Value="@Inactivos.ToString()" Strong="true" />
        <CdsKpi Icon="store" Label="Agencias con personal" Value="@Agencias.ToString()" Strong="true" />
    </div>
</CdsCard>

@code {
    [Parameter] public int Total { get; set; }
    [Parameter] public int Activos { get; set; }
    [Parameter] public int Inactivos { get; set; }
    [Parameter] public int Agencias { get; set; }
}
