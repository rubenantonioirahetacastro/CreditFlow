@page "/roles"
@attribute [Authorize(Policy = AuthorizationPolicies.Maintenance)]
@using CreditFlow.Web.Features.Maintenance.Role.Components

<CdsPageHeader Title="Roles"
               Icon="admin_panel_settings"
               Path="@(new PagePathItem[] { "Mantenimientos" })"
               Description="Administra los roles y sus permisos." />

@if (cargando && roles.Count == 0)
{
    <CdsPageState Kind="CdsPageStateKind.Loading" Title="Cargando roles…" />
}
else if (errorCarga is not null && roles.Count == 0)
{
    <CdsPageState Kind="CdsPageStateKind.Error"
                  Title="No pudimos cargar los roles"
                  Message="@errorCarga"
                  OnAction="@CargarAsync" />
}
else
{
    <div class="cds-page cds-page--fill role-page" @ref="paginaRootRef">
        <CdsCard>
            <CdsKpiRow Columns="3">
                <CdsKpi Icon="admin_panel_settings" Label="Roles" Value="@roles.Count.ToString()" Strong="true" />
                <CdsKpi Icon="check_circle" Label="Activos" Value="@Activos.ToString()" Strong="true" />
                <CdsKpi Icon="block" Label="Inactivos" Value="@((roles.Count - Activos).ToString())" Strong="true" />
            </CdsKpiRow>
        </CdsCard>

        <CdsListCard Title="Roles del sistema" Badge="@($"{RolesFiltrados.Count} roles")">
            <Actions>
                <CdsExportButton Format="CdsExportFormat.Excel"
                                 Disabled="@(RolesFiltrados.Count == 0)"
                                 Click="@(() => grilla.ExportarExcelAsync())" />
                <CdsButton Text="Nuevo rol"
                           Icon="add"
                           Size="ButtonSize.Small"
                           Click="@(() => AbrirFormulario(null))" />
            </Actions>
            <Filters>
                <CdsTabs AriaLabel="Filtrar roles por estado">
                    <CdsTab Text="Todos" Count="@roles.Count" Selected="@(filtroEstado == FiltroEstado.Todos)" OnClick="@(() => filtroEstado = FiltroEstado.Todos)" />
                    <CdsTab Text="Activos" Count="@Activos" Selected="@(filtroEstado == FiltroEstado.Activos)" OnClick="@(() => filtroEstado = FiltroEstado.Activos)" />
                    <CdsTab Text="Inactivos" Count="@(roles.Count - Activos)" Selected="@(filtroEstado == FiltroEstado.Inactivos)" OnClick="@(() => filtroEstado = FiltroEstado.Inactivos)" />
                </CdsTabs>
            </Filters>
            <Search>
                <CdsTextField NativeForm="true"
                              Value="@filtroTexto"
                              ValueChanged="@(v => filtroTexto = v)"
                              Placeholder="Buscar por nombre o descripción"
                              aria-label="Buscar rol" />
            </Search>
            <ChildContent>
                <GridEstandar @ref="grilla"
                              TItem="RoleListItem"
                              Data="@RolesFiltrados"
                              EmptyText="@(roles.Count == 0 ? "Aún no hay roles registrados." : "No hay roles que coincidan con el filtro.")"
                              ExportFileName="roles"
                              ShowAddButton="false"
                              ShowExportButton="false"
                              FillHeight="true">
                    <RadzenDataGridColumn TItem="RoleListItem" Property="@nameof(RoleListItem.IdRol)" Title="Código" Width="100px" Frozen="true" TextAlign="TextAlign.Center">
                        <Template Context="rol"><span class="cds-mono">@rol.IdRol</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RoleListItem" Property="@nameof(RoleListItem.Nombre)" Title="Nombre" Width="220px" Frozen="true" TextAlign="TextAlign.Left" />
                    <RadzenDataGridColumn TItem="RoleListItem" Property="@nameof(RoleListItem.Descripcion)" Title="Descripción" MinWidth="260px" TextAlign="TextAlign.Left">
                        <Template Context="rol"><CdsTruncatedText Text="@rol.Descripcion" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RoleListItem" Property="@nameof(RoleListItem.EstadoTexto)" Title="Estado" Width="140px" TextAlign="TextAlign.Center">
                        <Template Context="rol">
                            <CdsSwitch Value="@rol.Activo"
                                       Text="@rol.EstadoTexto"
                                       AriaLabel="@($"Estado de {rol.Nombre}")"
                                       Disabled="@guardando"
                                       ValueChanged="@(activo => CambiarEstadoAsync(rol, activo))" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RoleListItem" Title="Acciones" Width="100px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center">
                        <Template Context="rol">
                            <CdsButton Icon="edit"
                                       Variant="Variant.Text"
                                       ButtonStyle="ButtonStyle.Base"
                                       Size="ButtonSize.ExtraSmall"
                                       title="Editar rol"
                                       aria-label="@($"Editar {rol.Nombre}")"
                                       Click="@(() => AbrirFormulario(rol.Rol))" />
                        </Template>
                    </RadzenDataGridColumn>
                </GridEstandar>
            </ChildContent>
        </CdsListCard>
    </div>
}

<RoleDrawer Open="@formularioAbierto"
            Rol="@rolEnEdicion"
            NombresExistentes="@NombresOtrosRoles"
            Guardando="@guardando"
            OnClose="@(() => formularioAbierto = false)"
            OnSave="@GuardarAsync" />

<CdsUndoToast Visible="@avisoVisible"
              Version="@avisoVersion"
              Message="@avisoMensaje"
              OnUndo="@(accionDeshacer is null ? default : EventCallback.Factory.Create(this, DeshacerAsync))"
              OnClose="@(() => avisoVisible = false)" />

@code {
    // Crear y editar roles usa la misma política de la página (Maintenance), igual que la API.
    [Inject] private IRoleService RoleService { get; set; } = default!;
    [Inject] private ICdsNotificationService Notifications { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private enum FiltroEstado { Todos, Activos, Inactivos }

    private ElementReference paginaRootRef;
    private GridEstandar<RoleListItem> grilla = default!;

    private List<RoleListItem> roles = [];
    private bool cargando = true;
    private string? errorCarga;
    private bool guardando;

    private FiltroEstado filtroEstado = FiltroEstado.Todos;
    private string filtroTexto = string.Empty;

    private bool formularioAbierto;
    private RoleDto? rolEnEdicion;

    // Aviso con «Deshacer»: guarda la acción inversa del último cambio (nula si no se puede deshacer).
    private bool avisoVisible;
    private int avisoVersion;
    private string avisoMensaje = string.Empty;
    private Func<Task<(bool Exito, string? Mensaje)>>? accionDeshacer;

    private int Activos => roles.Count(r => r.Activo);

    private List<string> NombresOtrosRoles => roles
        .Where(r => r.IdRol != (rolEnEdicion?.IdRol ?? 0))
        .Select(r => r.Nombre)
        .ToList();

    private List<RoleListItem> RolesFiltrados =>
        roles
            .Where(r => filtroEstado switch
            {
                FiltroEstado.Activos => r.Activo,
                FiltroEstado.Inactivos => !r.Activo,
                _ => true
            })
            .Where(r => string.IsNullOrWhiteSpace(filtroTexto) || r.Coincide(filtroTexto.Trim()))
            .ToList();

    protected override Task OnInitializedAsync() => CargarAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.FitAsync(paginaRootRef);
    }

    private async Task CargarAsync()
    {
        cargando = true;
        var result = await RoleService.ObtenerTodosAsync();
        if (result.IsSuccess)
        {
            roles = (result.Data ?? [])
                .Select(r => new RoleListItem { Rol = r })
                .OrderBy(r => r.Nombre)
                .ToList();
            errorCarga = null;
        }
        else if (roles.Count > 0)
        {
            Notifications.Error("No se pudieron actualizar los roles", result.Message);
        }
        else
        {
            errorCarga = result.Message ?? "No se pudieron cargar los roles.";
        }

        cargando = false;
    }

    private void AbrirFormulario(RoleDto? rol)
    {
        rolEnEdicion = rol;
        formularioAbierto = true;
    }

    private async Task GuardarAsync(RoleDto rol)
    {
        var anterior = rolEnEdicion;
        guardando = true;
        var (exito, mensaje) = anterior is null
            ? await RoleService.CrearAsync(new CrearRoleRequest { Nombre = rol.Nombre, Descripcion = rol.Descripcion })
            : await RoleService.ActualizarAsync(anterior.IdRol, ARequest(rol));
        guardando = false;

        if (!exito)
        {
            Notifications.Error("No se pudo guardar el rol", mensaje);
            return;
        }

        formularioAbierto = false;
        await CargarAsync();

        // Crear no se puede deshacer: la API no permite eliminar roles.
        MostrarAviso(
            anterior is null ? $"Rol «{rol.Nombre}» creado" : $"Rol «{rol.Nombre}» actualizado",
            anterior is null ? null : () => RoleService.ActualizarAsync(anterior.IdRol, ARequest(anterior)));
    }

    private async Task CambiarEstadoAsync(RoleListItem item, bool activo)
    {
        var anterior = item.Rol;
        var request = ARequest(anterior);
        request.Activo = activo;

        guardando = true;
        var (exito, mensaje) = await RoleService.ActualizarAsync(anterior.IdRol, request);
        guardando = false;

        await CargarAsync();
        if (!exito)
        {
            Notifications.Error("No se pudo cambiar el estado", mensaje);
            return;
        }

        MostrarAviso(
            $"«{item.Nombre}» {(activo ? "activado" : "desactivado")}",
            () => RoleService.ActualizarAsync(anterior.IdRol, ARequest(anterior)));
    }

    private static ActualizarRoleRequest ARequest(RoleDto rol) => new()
    {
        Nombre = rol.Nombre,
        Descripcion = rol.Descripcion,
        Activo = rol.Activo
    };

    private void MostrarAviso(string mensaje, Func<Task<(bool Exito, string? Mensaje)>>? deshacer)
    {
        avisoMensaje = mensaje;
        accionDeshacer = deshacer;
        avisoVersion++;
        avisoVisible = true;
    }

    private async Task DeshacerAsync()
    {
        avisoVisible = false;
        if (accionDeshacer is null)
            return;

        var (exito, mensaje) = await accionDeshacer();
        accionDeshacer = null;
        if (!exito)
        {
            Notifications.Error("No se pudo deshacer el cambio", mensaje);
            return;
        }

        await CargarAsync();
        Notifications.Info("Cambio deshecho");
    }
}
