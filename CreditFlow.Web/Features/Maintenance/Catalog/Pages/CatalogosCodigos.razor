@page "/catalogos-codigos"
@attribute [Authorize(Policy = AuthorizationPolicies.Maintenance)]
@using CreditFlow.Web.Features.Maintenance.Catalog.Components
@using CreditFlow.Web.Features.Maintenance.Catalog.Models
@using CreditFlow.Web.Features.Maintenance.Catalog.Services
@using CreditFlow.Web.Shared.Catalog.Models

<CdsPageHeader Title="Catálogos de códigos"
               Icon="list_alt"
               Path="@(new PagePathItem[] { "Mantenimientos" })"
               Description="Administra los catálogos y los valores que usa el sistema." />

@if (cargando && grupos.Count == 0)
{
    <CdsPageState Kind="CdsPageStateKind.Loading" Title="Cargando catálogos…" />
}
else if (errorCarga is not null && grupos.Count == 0)
{
    <CdsPageState Kind="CdsPageStateKind.Error"
                  Title="No pudimos cargar los catálogos"
                  Message="@errorCarga"
                  OnAction="@(() => CargarAsync())" />
}
else
{
    <div class="cds-page cds-page--fill cat-page" @ref="paginaRootRef">
        <div class="cat-layout">
            <CdsMasterList TItem="CatalogoGrupo"
                           Title="Catálogos"
                           Items="@grupos"
                           ItemKey="@(g => g.Codigo)"
                           ItemCode="@(g => g.Codigo.ToString())"
                           ItemName="@(g => g.Nombre)"
                           ItemDetail="@(g => g.Clave)"
                           ItemCount="@(g => g.Valores.Count.ToString())"
                           ItemCountTitle="@(g => $"{g.Valores.Count} valores")"
                           SelectedKey="@codigoSeleccionado"
                           OnSelect="@Seleccionar"
                           SearchPlaceholder="Buscar por nombre, código o clave">
                <Actions>
                    @if (puedeCrear)
                    {
                        <CdsButton Text="Nuevo"
                                   Icon="add"
                                   Variant="Variant.Outlined"
                                   ButtonStyle="ButtonStyle.Base"
                                   Size="ButtonSize.Small"
                                   title="Crear un catálogo"
                                   Click="@(() => nuevoCatalogoAbierto = true)" />
                    }
                </Actions>
            </CdsMasterList>

            <div class="cat-detail">
                @if (Seleccionado is not { } grupo)
                {
                    <CdsCard>
                        <CdsPageState Kind="CdsPageStateKind.Empty"
                                      Title="Selecciona un catálogo"
                                      Message="Elige un catálogo de la lista para ver y administrar sus valores."
                                      ShowSurface="false"
                                      Compact="true" />
                    </CdsCard>
                }
                else
                {
                    <CdsCard Padding="CdsCardPadding.None" Class="cat-detail-card">
                        <CdsCardHeader Title="@grupo.Nombre"
                                       Subtitle="@($"Clave {grupo.Clave} · {grupo.Activos} activos de {grupo.Valores.Count}")">
                            <Lead>
                                <span class="cat-code cds-mono">@grupo.Codigo</span>
                            </Lead>
                            <Actions>
                                <CdsExportButton Format="CdsExportFormat.Excel"
                                                 Disabled="@(grupo.Valores.Count == 0)"
                                                 Click="@(() => ExportarAsync(grupo))" />
                                @if (puedeCrear)
                                {
                                    <CdsButton Text="Nuevo valor"
                                               Icon="add"
                                               Size="ButtonSize.Small"
                                               Click="@(() => AbrirValor(null))" />
                                }
                            </Actions>
                        </CdsCardHeader>

                        <div class="cat-filters">
                            <CdsTabs AriaLabel="Filtrar valores por estado">
                                <CdsTab Text="Todos" Count="@grupo.Valores.Count" Selected="@(filtroEstado == FiltroEstado.Todos)" OnClick="@(() => filtroEstado = FiltroEstado.Todos)" />
                                <CdsTab Text="Activos" Count="@grupo.Activos" Selected="@(filtroEstado == FiltroEstado.Activos)" OnClick="@(() => filtroEstado = FiltroEstado.Activos)" />
                                <CdsTab Text="Inactivos" Count="@grupo.Inactivos" Selected="@(filtroEstado == FiltroEstado.Inactivos)" OnClick="@(() => filtroEstado = FiltroEstado.Inactivos)" />
                            </CdsTabs>
                            <div class="cat-filters__search">
                                <CdsTextField NativeForm="true"
                                              Value="@filtroTexto"
                                              ValueChanged="@(v => filtroTexto = v)"
                                              Placeholder="Filtrar valores"
                                              aria-label="Filtrar valores" />
                            </div>
                        </div>

                        <div class="cat-table">
                            @if (ValoresFiltrados.Count == 0)
                            {
                                <CdsPageState Kind="CdsPageStateKind.Empty"
                                              Title="@(grupo.Valores.Count == 0 ? "Este catálogo aún no tiene valores" : "No hay valores que coincidan")"
                                              Message="@(grupo.Valores.Count == 0 ? "Crea el primero con «Nuevo valor»." : "Cambia el filtro o la búsqueda.")"
                                              ShowSurface="false"
                                              Compact="true" />
                            }
                            else
                            {
                                <CatalogValuesTable Valores="@ValoresFiltrados"
                                                    OnToggle="@(args => CambiarEstadoAsync(args.Valor, args.Activo))"
                                                    OnEdit="@(v => AbrirValor(v))"
                                                    OnDelete="@EliminarAsync"
                                                    PuedeEditar="@puedeEditar"
                                                    PuedeEliminar="@puedeEliminar" />
                            }
                        </div>

                        <div class="cat-footer">
                            Mostrando @ValoresFiltrados.Count de @grupo.Valores.Count valores
                        </div>
                    </CdsCard>
                }
            </div>
        </div>
    </div>
}

<CatalogValueDrawer Open="@valorAbierto"
                    Grupo="@Seleccionado"
                    Valor="@valorEnEdicion"
                    Guardando="@guardando"
                    OnClose="@(() => valorAbierto = false)"
                    OnSave="@GuardarValorAsync" />

<CatalogNewDrawer Open="@nuevoCatalogoAbierto"
                  CodigosExistentes="@grupos.Select(g => g.Codigo).ToList()"
                  Guardando="@guardando"
                  OnClose="@(() => nuevoCatalogoAbierto = false)"
                  OnSave="@CrearCatalogoAsync" />

<CdsUndoToast Visible="@avisoVisible"
              Version="@avisoVersion"
              Message="@avisoMensaje"
              OnUndo="@DeshacerAsync"
              OnClose="@(() => avisoVisible = false)" />

@code {
    [Inject] private ICatalogoCodigoService CatalogoCodigoService { get; set; } = default!;
    [Inject] private DialogService DialogService { get; set; } = default!;
    [Inject] private ICdsNotificationService Notifications { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private MenuPermissionService Permisos { get; set; } = default!;

    private const string ClaveMenu = "mantenimientos.catalogos";

    private enum FiltroEstado { Todos, Activos, Inactivos }

    private ElementReference paginaRootRef;

    private List<CatalogoGrupo> grupos = [];
    private int? codigoSeleccionado;
    private bool cargando = true;
    private string? errorCarga;
    private bool guardando;
    private bool puedeCrear;
    private bool puedeEditar;
    private bool puedeEliminar;

    private FiltroEstado filtroEstado = FiltroEstado.Todos;
    private string filtroTexto = string.Empty;

    private bool valorAbierto;
    private CatalogoCodigoDto? valorEnEdicion;
    private bool nuevoCatalogoAbierto;

    // Aviso con «Deshacer»: guarda la acción inversa del último cambio.
    private bool avisoVisible;
    private int avisoVersion;
    private string avisoMensaje = string.Empty;
    private Func<Task<(bool Exito, string? Mensaje)>>? accionDeshacer;

    private CatalogoGrupo? Seleccionado => grupos.FirstOrDefault(g => g.Codigo == codigoSeleccionado);

    private List<CatalogoCodigoDto> ValoresFiltrados =>
        (Seleccionado?.Valores ?? [])
            .Where(v => filtroEstado switch
            {
                FiltroEstado.Activos => CatalogoConvenciones.EsActivo(v),
                FiltroEstado.Inactivos => !CatalogoConvenciones.EsActivo(v),
                _ => true
            })
            .Where(v => string.IsNullOrWhiteSpace(filtroTexto) ||
                        v.CNomCod.Contains(filtroTexto.Trim(), StringComparison.OrdinalIgnoreCase) ||
                        v.NValor.ToString().Contains(filtroTexto.Trim()))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        // Acciones según «Permisos por rol» (la API mantiene sus políticas por rol como límite).
        await Permisos.CargarAsync();
        puedeCrear = Permisos.Puede(ClaveMenu, MenuActions.Crear);
        puedeEditar = Permisos.Puede(ClaveMenu, MenuActions.Editar);
        puedeEliminar = Permisos.Puede(ClaveMenu, MenuActions.Eliminar);

        await CargarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.FitAsync(paginaRootRef);
    }

    private async Task CargarAsync(int? seleccionar = null)
    {
        cargando = true;
        var result = await CatalogoCodigoService.ObtenerTodosAsync();
        if (result.IsSuccess)
        {
            grupos = CatalogoGrupo.Agrupar(result.Data ?? []);
            errorCarga = null;
            var destino = seleccionar ?? codigoSeleccionado;
            codigoSeleccionado = grupos.Any(g => g.Codigo == destino) ? destino : grupos.FirstOrDefault()?.Codigo;
        }
        else if (grupos.Count > 0)
        {
            Notifications.Error("No se pudieron actualizar los catálogos", result.Message);
        }
        else
        {
            errorCarga = result.Message ?? "No se pudieron cargar los catálogos.";
        }

        cargando = false;
    }

    private void Seleccionar(int codigo)
    {
        codigoSeleccionado = codigo;
        filtroEstado = FiltroEstado.Todos;
        filtroTexto = string.Empty;
    }

    private void AbrirValor(CatalogoCodigoDto? valor)
    {
        valorEnEdicion = valor;
        valorAbierto = true;
    }

    private async Task GuardarValorAsync(CatalogoCodigoDto valor)
    {
        var anterior = valorEnEdicion is null ? null : Copiar(valorEnEdicion);
        guardando = true;
        var (exito, mensaje) = anterior is null
            ? await CatalogoCodigoService.CrearAsync(valor)
            : await CatalogoCodigoService.ActualizarAsync(valor);
        guardando = false;

        if (!exito)
        {
            Notifications.Error("No se pudo guardar el valor", mensaje);
            return;
        }

        valorAbierto = false;
        await CargarAsync();
        MostrarAviso(
            anterior is null ? $"Valor «{valor.CNomCod}» creado" : $"Valor «{valor.CNomCod}» actualizado",
            anterior is null
                ? () => CatalogoCodigoService.EliminarAsync(valor.NCodigo, valor.NValor)
                : () => CatalogoCodigoService.ActualizarAsync(anterior));
    }

    private async Task CambiarEstadoAsync(CatalogoCodigoDto valor, bool activo)
    {
        var anterior = Copiar(valor);
        var actualizado = Copiar(valor);
        actualizado.NEstados = activo ? CatalogoConvenciones.EstadoActivo : CatalogoConvenciones.EstadoInactivo;

        var (exito, mensaje) = await CatalogoCodigoService.ActualizarAsync(actualizado);
        if (!exito)
        {
            Notifications.Error("No se pudo cambiar el estado", mensaje);
            await CargarAsync();
            return;
        }

        await CargarAsync();
        MostrarAviso(
            $"«{valor.CNomCod}» {(activo ? "activado" : "desactivado")}",
            () => CatalogoCodigoService.ActualizarAsync(anterior));
    }

    private async Task EliminarAsync(CatalogoCodigoDto valor)
    {
        var activo = CatalogoConvenciones.EsActivo(valor);
        object? eleccion = await DialogService.OpenAsync<CdsDeleteDialog>(
            $"¿Eliminar «{valor.CNomCod}»?",
            new Dictionary<string, object?>
            {
                [nameof(CdsDeleteDialog.Nombre)] = valor.CNomCod,
                [nameof(CdsDeleteDialog.Identificador)] = valor.NValor.ToString(),
                [nameof(CdsDeleteDialog.IdentificadorEtiqueta)] = "valor",
                [nameof(CdsDeleteDialog.PuedeDesactivar)] = activo
            },
            new DialogOptions { Width = "min(460px, 92vw)", CloseDialogOnOverlayClick = true });

        if (eleccion is CdsDeleteChoice.Desactivar)
        {
            await CambiarEstadoAsync(valor, false);
            return;
        }

        if (eleccion is not CdsDeleteChoice.Eliminar)
            return;

        var anterior = Copiar(valor);
        var (exito, mensaje) = await CatalogoCodigoService.EliminarAsync(valor.NCodigo, valor.NValor);
        if (!exito)
        {
            Notifications.Error("No se pudo eliminar el valor", mensaje);
            return;
        }

        await CargarAsync();
        MostrarAviso($"«{valor.CNomCod}» eliminado", () => CatalogoCodigoService.CrearAsync(anterior));
    }

    private async Task CrearCatalogoAsync((int Codigo, string Clave) nuevo)
    {
        guardando = true;
        var (exito, mensaje) = await CatalogoCodigoService.CrearAsync(new CatalogoCodigoDto
        {
            // La fila Valor = Código es el encabezado del catálogo.
            NCodigo = nuevo.Codigo,
            NValor = nuevo.Codigo,
            CNomCod = nuevo.Clave,
            NEstados = CatalogoConvenciones.EstadoActivo,
            NTipoCodigo = CatalogoConvenciones.TipoGeneral
        });
        guardando = false;

        if (!exito)
        {
            Notifications.Error("No se pudo crear el catálogo", mensaje);
            return;
        }

        nuevoCatalogoAbierto = false;
        await CargarAsync(nuevo.Codigo);
        MostrarAviso($"Catálogo «{nuevo.Clave}» creado", () => CatalogoCodigoService.EliminarAsync(nuevo.Codigo, nuevo.Codigo));
    }

    private void MostrarAviso(string mensaje, Func<Task<(bool Exito, string? Mensaje)>> deshacer)
    {
        avisoMensaje = mensaje;
        accionDeshacer = deshacer;
        avisoVersion++;
        avisoVisible = true;
    }

    private async Task DeshacerAsync()
    {
        avisoVisible = false;
        if (accionDeshacer is null)
            return;

        var (exito, mensaje) = await accionDeshacer();
        accionDeshacer = null;
        if (!exito)
        {
            Notifications.Error("No se pudo deshacer el cambio", mensaje);
            return;
        }

        await CargarAsync();
        Notifications.Info("Cambio deshecho");
    }

    private async Task ExportarAsync(CatalogoGrupo grupo)
    {
        var bytes = CatalogoExcelExporter.Exportar(grupo);
        await JS.InvokeVoidAsync("Radzen.downloadFile", $"catalogo-{grupo.Codigo}-{grupo.Clave.ToLowerInvariant()}.xlsx", bytes,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private static CatalogoCodigoDto Copiar(CatalogoCodigoDto origen) => new()
    {
        NCodigo = origen.NCodigo,
        NValor = origen.NValor,
        CNomCod = origen.CNomCod,
        NEstados = origen.NEstados,
        NTipoCodigo = origen.NTipoCodigo
    };
}
