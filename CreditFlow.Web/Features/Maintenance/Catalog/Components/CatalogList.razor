@using CreditFlow.Web.Features.Maintenance.Catalog.Models

<div class="catalog-list">
    <CdsCard Padding="CdsCardPadding.None" Class="catalog-list-card">
        <CdsCardHeader Title="Catálogos" Badge="@Grupos.Count.ToString()">
            <Actions>
                <CdsButton Text="Nuevo"
                           Icon="add"
                           Variant="Variant.Outlined"
                           ButtonStyle="ButtonStyle.Base"
                           Size="ButtonSize.Small"
                           title="Crear un catálogo"
                           Click="@OnNew" />
            </Actions>
        </CdsCardHeader>

        <div class="catalog-list__search">
            <CdsTextField NativeForm="true"
                          Value="@busqueda"
                          ValueChanged="@(v => busqueda = v)"
                          Placeholder="Buscar por nombre, código o clave"
                          aria-label="Buscar catálogo" />
        </div>

        <div class="catalog-list__items" role="listbox" aria-label="Catálogos">
            @if (Filtrados.Count == 0)
            {
                <div class="catalog-list__empty">
                    <RadzenIcon Icon="search_off" />
                    <span>No hay catálogos que coincidan con «@busqueda».</span>
                </div>
            }
            else
            {
                @foreach (var grupo in Filtrados)
                {
                    var seleccionado = grupo.Codigo == SelectedCodigo;
                    <button type="button"
                            role="option"
                            aria-selected="@seleccionado"
                            class="catalog-item @(seleccionado ? "catalog-item--selected" : null)"
                            @onclick="() => OnSelect.InvokeAsync(grupo.Codigo)">
                        <span class="catalog-item__code cds-mono">@grupo.Codigo</span>
                        <span class="catalog-item__text">
                            <span class="catalog-item__name">@grupo.Nombre</span>
                            <span class="catalog-item__key cds-mono">@grupo.Clave</span>
                        </span>
                        <span class="catalog-item__count" title="@($"{grupo.Valores.Count} valores")">@grupo.Valores.Count</span>
                    </button>
                }
            }
        </div>
    </CdsCard>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<CatalogoGrupo> Grupos { get; set; } = [];
    [Parameter] public int? SelectedCodigo { get; set; }
    [Parameter] public EventCallback<int> OnSelect { get; set; }
    [Parameter] public EventCallback OnNew { get; set; }

    private string busqueda = string.Empty;

    private List<CatalogoGrupo> Filtrados => string.IsNullOrWhiteSpace(busqueda)
        ? Grupos.ToList()
        : Grupos.Where(g =>
                g.Nombre.Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
                g.Clave.Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase) ||
                g.Codigo.ToString().Contains(busqueda.Trim()))
            .ToList();
}
