@inject DialogService DialogService

@* Contenido del diálogo de eliminación. Devuelve CatalogDeleteChoice (o null si se cancela). *@
<div class="delete-dialog">
    <div class="delete-dialog__icon" aria-hidden="true"><RadzenIcon Icon="delete" /></div>
    <p class="delete-dialog__text">
        Se eliminará <strong>@Nombre</strong> (valor <span class="cds-mono">@Valor</span>) de forma definitiva.
        @if (PuedeDesactivar)
        {
            <span>Si solo quieres dejar de usarlo, desactívalo: podrás reactivarlo cuando quieras.</span>
        }
    </p>
    <div class="delete-dialog__actions">
        <CdsButton Text="Cancelar"
                   Variant="Variant.Outlined"
                   ButtonStyle="ButtonStyle.Base"
                   Size="ButtonSize.Small"
                   Click="@(() => DialogService.Close(null))" />
        @if (PuedeDesactivar)
        {
            <CdsButton Text="Desactivar"
                       Icon="toggle_off"
                       Variant="Variant.Outlined"
                       ButtonStyle="ButtonStyle.Base"
                       Size="ButtonSize.Small"
                       Click="@(() => DialogService.Close(CatalogDeleteChoice.Desactivar))" />
        }
        <CdsButton Text="Eliminar"
                   Icon="delete"
                   ButtonStyle="ButtonStyle.Danger"
                   Size="ButtonSize.Small"
                   Click="@(() => DialogService.Close(CatalogDeleteChoice.Eliminar))" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Nombre { get; set; } = string.Empty;
    [Parameter] public int Valor { get; set; }

    /// <summary>Falso si el valor ya está inactivo (desactivar no tendría efecto).</summary>
    [Parameter] public bool PuedeDesactivar { get; set; } = true;
}
