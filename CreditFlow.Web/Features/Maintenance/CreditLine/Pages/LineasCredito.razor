@page "/lineas-credito"
@attribute [Authorize(Policy = AuthorizationPolicies.Maintenance)]
@using CreditFlow.Web.Features.Maintenance.CreditLine.Components

<CdsPageHeader Title="Líneas de crédito"
               Icon="credit_card"
               Path="@(new PagePathItem[] { "Mantenimientos" })"
               Description="Administra las líneas de crédito, tasas y condiciones." />

@if (cargando && lineas.Count == 0)
{
    <CdsPageState Kind="CdsPageStateKind.Loading" Title="Cargando líneas de crédito…" />
}
else if (errorCarga is not null && lineas.Count == 0)
{
    <CdsPageState Kind="CdsPageStateKind.Error"
                  Title="No pudimos cargar las líneas de crédito"
                  Message="@errorCarga"
                  OnAction="@CargarAsync" />
}
else
{
    <div class="cds-page cds-page--fill line-page" @ref="paginaRootRef">
        <CdsCard>
            <CdsKpiRow>
                <CdsKpi Icon="credit_card" Label="Líneas de crédito" Value="@lineas.Count.ToString()" Strong="true" />
                <CdsKpi Icon="check_circle" Label="Activas" Value="@Activas.ToString()" Strong="true" />
                <CdsKpi Icon="block" Label="Inactivas" Value="@((lineas.Count - Activas).ToString())" Strong="true" />
                <CdsKpi Icon="autorenew" Label="Con refinanciamiento" Value="@lineas.Count(l => l.Refinancia).ToString()" Strong="true" />
            </CdsKpiRow>
        </CdsCard>

        <CdsListCard Title="Catálogo de líneas" Badge="@($"{LineasFiltradas.Count} líneas")">
            <Actions>
                <CdsExportButton Format="CdsExportFormat.Excel"
                                 Disabled="@(LineasFiltradas.Count == 0)"
                                 Click="@(() => grilla.ExportarExcelAsync())" />
                @if (puedeEditar)
                {
                    <CdsButton Text="Nueva línea"
                               Icon="add"
                               Size="ButtonSize.Small"
                               Click="@(() => AbrirFormulario(null))" />
                }
            </Actions>
            <Filters>
                <CdsTabs AriaLabel="Filtrar líneas por estado">
                    <CdsTab Text="Todas" Count="@lineas.Count" Selected="@(filtroEstado == FiltroEstado.Todas)" OnClick="@(() => filtroEstado = FiltroEstado.Todas)" />
                    <CdsTab Text="Activas" Count="@Activas" Selected="@(filtroEstado == FiltroEstado.Activas)" OnClick="@(() => filtroEstado = FiltroEstado.Activas)" />
                    <CdsTab Text="Inactivas" Count="@(lineas.Count - Activas)" Selected="@(filtroEstado == FiltroEstado.Inactivas)" OnClick="@(() => filtroEstado = FiltroEstado.Inactivas)" />
                </CdsTabs>
            </Filters>
            <Search>
                <CdsTextField NativeForm="true"
                              Value="@filtroTexto"
                              ValueChanged="@(v => filtroTexto = v)"
                              Placeholder="Buscar por descripción, código o producto"
                              aria-label="Buscar línea de crédito" />
            </Search>
            <ChildContent>
                <GridEstandar @ref="grilla"
                              TItem="LineaCreditoListItem"
                              Data="@LineasFiltradas"
                              EmptyText="@(lineas.Count == 0 ? "Aún no hay líneas de crédito registradas." : "No hay líneas que coincidan con el filtro.")"
                              ExportFileName="lineas-credito"
                              ShowAddButton="false"
                              ShowExportButton="false"
                              FillHeight="true">
                    <RadzenDataGridColumn TItem="LineaCreditoListItem" Property="@nameof(LineaCreditoListItem.Codigo)" Title="Código" Width="100px" Frozen="true" TextAlign="TextAlign.Center">
                        <Template Context="linea"><span class="cds-mono">@linea.Codigo</span></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LineaCreditoListItem" Property="@nameof(LineaCreditoListItem.Descripcion)" Title="Descripción" Width="240px" Frozen="true" TextAlign="TextAlign.Left">
                        <Template Context="linea"><CdsTruncatedText Text="@linea.Descripcion" /></Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LineaCreditoListItem" Property="@nameof(LineaCreditoListItem.Producto)" Title="Producto" Width="110px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="LineaCreditoListItem" Property="@nameof(LineaCreditoListItem.SubProducto)" Title="Subproducto" Width="120px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="LineaCreditoListItem" Property="@nameof(LineaCreditoListItem.Tasa)" Title="Tasa comisión" Width="130px" TextAlign="TextAlign.Center" Sortable="false" />
                    <RadzenDataGridColumn TItem="LineaCreditoListItem" Property="@nameof(LineaCreditoListItem.Plazo)" Title="Plazo (cuotas)" Width="130px" TextAlign="TextAlign.Center" Sortable="false" />
                    <RadzenDataGridColumn TItem="LineaCreditoListItem" Property="@nameof(LineaCreditoListItem.Monto)" Title="Monto" Width="220px" TextAlign="TextAlign.Center" Sortable="false" />
                    <RadzenDataGridColumn TItem="LineaCreditoListItem" Property="@nameof(LineaCreditoListItem.Prestamos)" Title="Préstamos" Width="120px" TextAlign="TextAlign.Center" Sortable="false" />
                    <RadzenDataGridColumn TItem="LineaCreditoListItem" Property="@nameof(LineaCreditoListItem.RefinanciaTexto)" Title="Refinancia" Width="110px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="LineaCreditoListItem" Property="@nameof(LineaCreditoListItem.EstadoTexto)" Title="Estado" Width="140px" TextAlign="TextAlign.Center">
                        <Template Context="linea">
                            @if (puedeEditar)
                            {
                                <CdsSwitch Value="@linea.Activa"
                                           Text="@linea.EstadoTexto"
                                           AriaLabel="@($"Estado de {linea.Descripcion}")"
                                           Disabled="@guardando"
                                           ValueChanged="@(activa => CambiarEstadoAsync(linea, activa))" />
                            }
                            else
                            {
                                @linea.EstadoTexto
                            }
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="LineaCreditoListItem" Property="@nameof(LineaCreditoListItem.Usuario)" Title="Usuario" Width="140px" TextAlign="TextAlign.Center" />
                    <RadzenDataGridColumn TItem="LineaCreditoListItem" Title="Acciones" Width="110px" Sortable="false" Filterable="false" TextAlign="TextAlign.Center" Visible="@puedeEditar">
                        <Template Context="linea">
                            <CdsButton Icon="edit"
                                       Variant="Variant.Text"
                                       ButtonStyle="ButtonStyle.Base"
                                       Size="ButtonSize.ExtraSmall"
                                       title="Editar línea"
                                       aria-label="@($"Editar {linea.Descripcion}")"
                                       Click="@(() => AbrirFormulario(linea.Linea))" />
                            <CdsButton Icon="delete"
                                       Variant="Variant.Text"
                                       ButtonStyle="ButtonStyle.Base"
                                       Size="ButtonSize.ExtraSmall"
                                       title="Eliminar línea"
                                       aria-label="@($"Eliminar {linea.Descripcion}")"
                                       Click="@(() => EliminarAsync(linea))" />
                        </Template>
                    </RadzenDataGridColumn>
                </GridEstandar>
            </ChildContent>
        </CdsListCard>
    </div>
}

<CreditLineDrawer Open="@formularioAbierto"
                  Linea="@lineaEnEdicion"
                  Guardando="@guardando"
                  OnClose="@(() => formularioAbierto = false)"
                  OnSave="@GuardarAsync" />

<CdsUndoToast Visible="@avisoVisible"
              Version="@avisoVersion"
              Message="@avisoMensaje"
              OnUndo="@(accionDeshacer is null ? default : EventCallback.Factory.Create(this, DeshacerAsync))"
              OnClose="@(() => avisoVisible = false)" />

@code {
    [Inject] private ILineaCreditoService LineaCreditoService { get; set; } = default!;
    [Inject] private DialogService DialogService { get; set; } = default!;
    [Inject] private ICdsNotificationService Notifications { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    private enum FiltroEstado { Todas, Activas, Inactivas }

    private ElementReference paginaRootRef;
    private GridEstandar<LineaCreditoListItem> grilla = default!;

    private List<LineaCreditoListItem> lineas = [];
    private bool cargando = true;
    private string? errorCarga;
    private bool guardando;
    private bool puedeEditar;

    private FiltroEstado filtroEstado = FiltroEstado.Todas;
    private string filtroTexto = string.Empty;

    private bool formularioAbierto;
    private LineaCreditoDto? lineaEnEdicion;

    // Aviso con «Deshacer»: guarda la acción inversa del último cambio (nula si no se puede deshacer).
    private bool avisoVisible;
    private int avisoVersion;
    private string avisoMensaje = string.Empty;
    private Func<Task<(bool Exito, string? Mensaje)>>? accionDeshacer;

    private int Activas => lineas.Count(l => l.Activa);

    private List<LineaCreditoListItem> LineasFiltradas =>
        lineas
            .Where(l => filtroEstado switch
            {
                FiltroEstado.Activas => l.Activa,
                FiltroEstado.Inactivas => !l.Activa,
                _ => true
            })
            .Where(l => string.IsNullOrWhiteSpace(filtroTexto) || l.Coincide(filtroTexto.Trim()))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            puedeEditar = RoleAuthorization.HasAnyRoleId(authState.User, RoleIds.MaintenanceEditAccess);
        }

        await CargarAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.FitAsync(paginaRootRef);
    }

    private async Task CargarAsync()
    {
        cargando = true;
        var result = await LineaCreditoService.ObtenerTodasAsync();
        if (result.IsSuccess)
        {
            lineas = (result.Data ?? [])
                .Select(l => new LineaCreditoListItem { Linea = l })
                .OrderBy(l => l.Codigo)
                .ToList();
            errorCarga = null;
        }
        else if (lineas.Count > 0)
        {
            Notifications.Error("No se pudieron actualizar las líneas de crédito", result.Message);
        }
        else
        {
            errorCarga = result.Message ?? "No se pudieron cargar las líneas de crédito.";
        }

        cargando = false;
    }

    private void AbrirFormulario(LineaCreditoDto? linea)
    {
        lineaEnEdicion = linea;
        formularioAbierto = true;
    }

    private async Task GuardarAsync(LineaCreditoDto linea)
    {
        var anterior = lineaEnEdicion;
        guardando = true;
        var (exito, mensaje) = anterior is null
            ? await LineaCreditoService.CrearAsync(ACrear(linea))
            : await LineaCreditoService.ActualizarAsync(anterior.NCodLinea, AActualizar(linea));
        guardando = false;

        if (!exito)
        {
            Notifications.Error("No se pudo guardar la línea de crédito", mensaje);
            return;
        }

        formularioAbierto = false;
        await CargarAsync();

        // Crear no se deshace aquí: la API asigna el código y la línea podría usarse de inmediato.
        MostrarAviso(
            anterior is null ? $"Línea «{linea.Descripcion}» creada" : $"Línea «{linea.Descripcion}» actualizada",
            anterior is null ? null : () => LineaCreditoService.ActualizarAsync(anterior.NCodLinea, AActualizar(anterior)));
    }

    private async Task CambiarEstadoAsync(LineaCreditoListItem item, bool activa)
    {
        var anterior = item.Linea;
        var request = AActualizar(anterior);
        request.Activa = activa;

        guardando = true;
        var (exito, mensaje) = await LineaCreditoService.ActualizarAsync(anterior.NCodLinea, request);
        guardando = false;

        await CargarAsync();
        if (!exito)
        {
            Notifications.Error("No se pudo cambiar el estado", mensaje);
            return;
        }

        MostrarAviso(
            $"«{item.Descripcion}» {(activa ? "activada" : "desactivada")}",
            () => LineaCreditoService.ActualizarAsync(anterior.NCodLinea, AActualizar(anterior)));
    }

    private async Task EliminarAsync(LineaCreditoListItem item)
    {
        object? eleccion = await DialogService.OpenAsync<CdsDeleteDialog>(
            $"¿Eliminar «{item.Descripcion}»?",
            new Dictionary<string, object?>
            {
                [nameof(CdsDeleteDialog.Nombre)] = item.Descripcion,
                [nameof(CdsDeleteDialog.Identificador)] = item.Codigo.ToString(),
                [nameof(CdsDeleteDialog.PuedeDesactivar)] = item.Activa
            },
            new DialogOptions { Width = "min(460px, 92vw)", CloseDialogOnOverlayClick = true });

        if (eleccion is CdsDeleteChoice.Desactivar)
        {
            await CambiarEstadoAsync(item, false);
            return;
        }

        if (eleccion is not CdsDeleteChoice.Eliminar)
            return;

        // La API rechaza eliminar una línea usada por créditos; en ese caso su mensaje sugiere desactivarla.
        var (exito, mensaje) = await LineaCreditoService.EliminarAsync(item.Codigo);
        if (!exito)
        {
            Notifications.Error("No se pudo eliminar la línea", mensaje);
            return;
        }

        await CargarAsync();
        MostrarAviso($"Línea «{item.Descripcion}» eliminada", null);
    }

    private static CrearLineaCreditoRequest ACrear(LineaCreditoDto linea) => new()
    {
        Descripcion = linea.Descripcion,
        TasaComision = linea.TasaComision,
        Producto = linea.Producto,
        SubProducto = linea.SubProducto,
        PlazoMinimo = linea.PlazoMinimo,
        PlazoMaximo = linea.PlazoMaximo,
        MontoMinimo = linea.MontoMinimo,
        MontoMaximo = linea.MontoMaximo,
        NumeroPrestamosMinimo = linea.NumeroPrestamosMinimo,
        NumeroPrestamosMaximo = linea.NumeroPrestamosMaximo,
        AplicaRefinanciamiento = linea.AplicaRefinanciamiento
    };

    private static ActualizarLineaCreditoRequest AActualizar(LineaCreditoDto linea) => new()
    {
        Descripcion = linea.Descripcion,
        TasaComision = linea.TasaComision,
        Producto = linea.Producto,
        SubProducto = linea.SubProducto,
        PlazoMinimo = linea.PlazoMinimo,
        PlazoMaximo = linea.PlazoMaximo,
        MontoMinimo = linea.MontoMinimo,
        MontoMaximo = linea.MontoMaximo,
        NumeroPrestamosMinimo = linea.NumeroPrestamosMinimo,
        NumeroPrestamosMaximo = linea.NumeroPrestamosMaximo,
        AplicaRefinanciamiento = linea.AplicaRefinanciamiento,
        Activa = linea.Activa
    };

    private void MostrarAviso(string mensaje, Func<Task<(bool Exito, string? Mensaje)>>? deshacer)
    {
        avisoMensaje = mensaje;
        accionDeshacer = deshacer;
        avisoVersion++;
        avisoVisible = true;
    }

    private async Task DeshacerAsync()
    {
        avisoVisible = false;
        if (accionDeshacer is null)
            return;

        var (exito, mensaje) = await accionDeshacer();
        accionDeshacer = null;
        if (!exito)
        {
            Notifications.Error("No se pudo deshacer el cambio", mensaje);
            return;
        }

        await CargarAsync();
        Notifications.Info("Cambio deshecho");
    }
}
