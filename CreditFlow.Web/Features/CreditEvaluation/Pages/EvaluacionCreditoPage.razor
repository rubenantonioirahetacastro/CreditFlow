@page "/otorgamiento/evaluacion/{NCodAge:int}/{NCodCred:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@using System.Globalization
@using CreditFlow.Web.Core.Utils.Format
@using CreditFlow.Web.Features.CreditEvaluation.Models
@using CreditFlow.Web.Features.CreditEvaluation.Services
@using CreditFlow.Web.Shared.Catalog.Models
@using CreditFlow.Web.Shared.Catalog.Services
@using CreditFlow.Web.Shared.Credit.Components

<CdsPageHeader Title="@($"Evaluación {NCodAge}-{NCodCred}")"
               Icon="fact_check"
               Path="@RutaPagina"
               Description="Revisa el expediente del cliente y registra la decisión del crédito." />

@if (cargando)
{
    <CdsPageState Kind="CdsPageStateKind.Loading"
                  Title="Cargando expediente…" />
}
else if (detalle is null)
{
    <CdsPageState Kind="CdsPageStateKind.Error"
                  Title="No pudimos cargar el expediente"
                  Message="@errorCarga"
                  OnAction="@CargarAsync" />
}
else
{
    <div class="cds-page eva-page">
        <div class="eva-main">

            @* Ficha del cliente *@
            <CdsCard>
                <div class="eva-client">
                    <Avatar Iniciales="@Iniciales(NombreCliente)"
                            Tamano="44"
                            ObtenerFotoDataUrl="@(_ => Task.FromResult<string?>(null))" />
                    <div class="eva-client__info">
                        <div class="eva-client__title-row">
                            <span class="eva-client__name">@NombreCliente</span>
                            <CreditStatusBadge StatusId="@detalle.Credito.NEstado"
                                               Text="@(detalle.Credito.EstadoNombre ?? "Sin estado")"
                                               Variant="CdsStatusBadgeVariant.Subtle" />
                        </div>
                        <div class="eva-client__meta">
                            <span>Crédito <strong>@detalle.Credito.NCodAge-@detalle.Credito.NCodCred</strong></span>
                            <span class="eva-client__sep" aria-hidden="true">·</span>
                            <span>@(string.IsNullOrWhiteSpace(detalle.Credito.Agencia) ? "Sin Agencia" : detalle.Credito.Agencia)</span>
                            <span class="eva-client__sep" aria-hidden="true">·</span>
                            <span>Gestiona @(detalle.Credito.UsuarioGestion ?? "—")</span>
                            <span class="eva-client__sep" aria-hidden="true">·</span>
                            <span>@detalle.Credito.DFecVig.ToString("d/M/yyyy HH:mm")</span>
                        </div>
                    </div>
                    <div class="eva-client__actions">
                        <CdsButton Text="Generar calendario"
                                   Icon="calendar_month"
                                   Size="ButtonSize.Small"
                                   title="Generar el calendario de pagos con las condiciones de este crédito"
                                   Click="@ConfigurarCalendario" />
                    </div>
                </div>
            </CdsCard>

            @* Solicitud: mismo resumen con íconos que la Bandeja *@
            <CdsCard>
                <div class="eva-kpis">
                    <CdsKpi Icon="payments" Label="Monto solicitado" Value="@Money(detalle.Credito.NPrestamo)" Strong="true" />
                    <CdsKpi Icon="event_repeat" Label="Cuotas" Value="@detalle.Credito.NNroCuotas.ToString()" Strong="true" />
                    <CdsKpi Icon="date_range" Label="Plazo" Value="@($"{detalle.Credito.PlazoMeses} meses")" Strong="true" />
                    <CdsKpi Icon="percent" Label="Tasa" Value="@(detalle.Credito.NTasaComp is { } tasa ? $"{tasa:0.00} %" : null)" Strong="true" />
                    <CdsKpi Icon="category" Label="Subproducto" Value="@NameFormatter.ToDisplayName(detalle.Credito.SubProducto)" Strong="true" />
                </div>
            </CdsCard>

            <div class="eva-row">
                <CdsCard Padding="CdsCardPadding.None" Class="eva-section">
                    <CdsCardHeader Title="Capacidad de pago declarada">
                        <Actions>
                            <CdsButton Icon="edit"
                                       Variant="Variant.Text"
                                       ButtonStyle="ButtonStyle.Base"
                                       Size="ButtonSize.ExtraSmall"
                                       title="Editar la capacidad de pago"
                                       aria-label="Editar la capacidad de pago"
                                       Click="@MantenimientoPendiente" />
                        </Actions>
                    </CdsCardHeader>
                    <div class="eva-section__body">
                        @if (detalle.CapacidadPago is { } cap)
                        {
                            <div class="eva-flow">
                                @foreach (var (label, valor, esIngreso) in FlujoFilas(cap))
                                {
                                    <div class="eva-flow__row">
                                        <span class="eva-flow__label">@label</span>
                                        <span class="eva-flow__value @(esIngreso ? "eva-flow__value--income" : "eva-flow__value--expense")">@(esIngreso ? "+" : "−")@Money(valor)</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="eva-empty">No se registró capacidad de pago en la solicitud.</div>
                        }
                    </div>
                </CdsCard>

                <CdsCard Padding="CdsCardPadding.None" Class="eva-section">
                    <CdsCardHeader Title="Cliente">
                        <Actions>
                            <CdsButton Icon="edit"
                                       Variant="Variant.Text"
                                       ButtonStyle="ButtonStyle.Base"
                                       Size="ButtonSize.ExtraSmall"
                                       title="Editar los datos del cliente"
                                       aria-label="Editar los datos del cliente"
                                       Click="@MantenimientoPendiente" />
                        </Actions>
                    </CdsCardHeader>
                    <div class="eva-section__body">
                        <div class="eva-fields eva-fields--2">
                            <CdsKpi Label="Documento" Value="@detalle.Cliente.CDocumento" />
                            <CdsKpi Label="Vence" Value="@detalle.Cliente.DFechaVencimientoDocumento.ToString("d/M/yyyy")" />
                            <CdsKpi Label="Edad" Value="@(detalle.Cliente.Edad?.ToString())" />
                            <CdsKpi Label="Celular" Value="@detalle.Cliente.CCelular" />
                            <CdsKpi Label="Correo" Value="@detalle.Cliente.CCorreo" />
                        </div>

                        @* Imágenes del documento de identidad (DUI): se abren en la ventana de galería. *@
                        <div class="eva-id-docs">
                            <CdsButton Text="@($"Ver documento de identidad ({detalle.Cliente.FotosDocumento.Count})")"
                                       Icon="badge"
                                       Variant="Variant.Outlined"
                                       ButtonStyle="ButtonStyle.Base"
                                       Size="ButtonSize.Small"
                                       Disabled="@(detalle.Cliente.FotosDocumento.Count == 0)"
                                       title="@(detalle.Cliente.FotosDocumento.Count == 0 ? "No se registraron imágenes del documento" : "Ver las imágenes del documento de identidad")"
                                       Click="@(() => AbrirGaleriaAsync("Documento de identidad", "persona", FotosDocumentoIdentidad()))" />
                        </div>
                    </div>
                </CdsCard>
            </div>

            @* Expediente *@
            <CdsCard Padding="CdsCardPadding.None" Class="eva-section">
                <div class="eva-tabs">
                    <CdsTabs AriaLabel="Secciones del expediente">
                        @foreach (var (nombre, cantidad) in TabsDisponibles())
                        {
                            <CdsTab Text="@nombre"
                                    Count="@cantidad"
                                    Selected="@(tabActual == nombre)"
                                    OnClick="@(() => tabActual = nombre)" />
                        }
                    </CdsTabs>
                </div>
                <div class="eva-section__body">
                    @if (tabActual == TabNegocio)
                    {
                        @if (detalle.Negocio is { } negocio)
                        {
                            <div class="eva-tab-toolbar">
                                <CdsButton Text="@($"Ver fotos del negocio ({negocio.Fotos.Count})")"
                                           Icon="photo_library"
                                           Variant="Variant.Outlined"
                                           ButtonStyle="ButtonStyle.Base"
                                           Size="ButtonSize.Small"
                                           Disabled="@(negocio.Fotos.Count == 0)"
                                           title="@(negocio.Fotos.Count == 0 ? "No hay fotos registradas del negocio" : "Ver las fotos del negocio en grande")"
                                           Click="@(() => AbrirGaleriaAsync("Fotos del negocio", "negocio", negocio.Fotos.Select(f => new FotoGaleriaItem(f.IdFoto)).ToList()))" />
                            </div>
                            <div class="eva-fields eva-fields--3">
                                <CdsKpi Label="Nombre" Value="@NameFormatter.ToDisplayName(negocio.CNombre)" />
                                <CdsKpi Label="Dirección del negocio">
                                    @if (UrlUbicacionNegocio(negocio.CGeolocalizacion) is { } urlUbicacion)
                                    {
                                        <a href="@urlUbicacion" target="_blank" rel="noopener noreferrer" class="cds-link">@(string.IsNullOrWhiteSpace(negocio.CDireccion) ? "Ver ubicación" : negocio.CDireccion)</a>
                                    }
                                    else
                                    {
                                        @(string.IsNullOrWhiteSpace(negocio.CDireccion) ? "—" : negocio.CDireccion)
                                    }
                                </CdsKpi>
                                <CdsKpi Label="Horario" Value="@HorarioNegocio(negocio)" />
                                <CdsKpi Label="Teléfono" Value="@negocio.CTelefono" />
                                <CdsKpi Label="Tipo de negocio" Value="@NameFormatter.ToDisplayName(NombreTipoNegocio(negocio))" />
                            </div>
                        }
                        else
                        {
                            <div class="eva-empty">No se registró negocio.</div>
                        }
                    }
                    else if (tabActual == TabResidencia)
                    {
                        @if (detalle.Documentacion.Fotos.Count == 0)
                        {
                            <div class="eva-empty">No hay documentos adjuntos.</div>
                        }
                        else
                        {
                            <div class="eva-photos">
                                @foreach (var f in detalle.Documentacion.Fotos)
                                {
                                    <FotoCard TipoFoto="documentacion" IdFoto="@f.IdFoto" ObtenerFoto="EvaluacionCreditoService.ObtenerFotoDataUrlAsync" Pie="@NombreDocumentoResidencia(f)" />
                                }
                            </div>
                        }
                    }
                    else if (tabActual == TabReferencia)
                    {
                        @if (detalle.Fiador is { } fiador)
                        {
                            <div class="eva-fields eva-fields--2">
                                <CdsKpi Label="Nombre" Value="@NameFormatter.ToDisplayName(fiador.NombreCompleto)" />
                                <CdsKpi Label="Documento" Value="@fiador.CDocumento" />
                                <CdsKpi Label="Dirección" Value="@fiador.CDireccion" />
                                <CdsKpi Label="Celular" Value="@fiador.CCelular" />
                            </div>
                        }
                        else
                        {
                            <div class="eva-empty">No se registró fiador o referencia.</div>
                        }
                    }
                    else if (tabActual == TabGarantia)
                    {
                        @if (!TieneGarantia())
                        {
                            <div class="eva-empty">No se registraron garantías.</div>
                        }
                        else
                        {
                            <div class="eva-fields eva-fields--4">
                                <CdsKpi Label="Tipo de garantía" Value="@NombreTipoGarantia()" />
                                <CdsKpi Label="Marca" Value="@NombreMarcaGarantia()" />
                                <CdsKpi Label="Año" Value="@NombreAnioGarantia()" />
                                <CdsKpi Label="Valor verificado" Value="@ValorGarantia()" />
                                @if (detalle.Garantia.ValorTotal > 0)
                                {
                                    <CdsKpi Label="Cobertura" Value="@(detalle.Garantia.CoberturaPorcentaje is { } cobertura ? $"{cobertura:0.0} %" : null)" />
                                }
                            </div>

                            @if (detalle.Garantia.Fotos.Count > 0)
                            {
                                <div class="eva-photos">
                                    @foreach (var f in detalle.Garantia.Fotos)
                                    {
                                        <FotoCard TipoFoto="garantia" IdFoto="@f.IdFoto" ObtenerFoto="EvaluacionCreditoService.ObtenerFotoDataUrlAsync" />
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="eva-empty">Las fotografías todavía no han sido agregadas.</div>
                            }
                        }
                    }
                    else if (tabActual == TabVerificacion)
                    {
                        @if (detalle.Verificaciones.Count == 0)
                        {
                            <div class="eva-empty">Todavía no hay verificaciones registradas para esta solicitud.</div>
                        }
                        else
                        {
                            <div class="eva-verifications">
                                @foreach (var v in detalle.Verificaciones)
                                {
                                    <div class="eva-verification">
                                        <span class="eva-verification__name">@NameFormatter.ToDisplayName(v.CNombre)</span>
                                        <span class="eva-verification__date">@v.DFecha.ToString("d/M/yyyy HH:mm")</span>
                                        <a target="_blank" rel="noopener noreferrer" href="https://www.google.com/maps?q=@v.NLatitud,@v.NLongitud" class="cds-link">Ver ubicación</a>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </CdsCard>
        </div>

        <aside class="eva-side">
            <CdsCard Padding="CdsCardPadding.None" Class="eva-section">
                <CdsCardHeader Title="Decisión" />
                <div class="eva-section__body eva-decision">
                    <div class="eva-decision__options" role="radiogroup" aria-label="Decisión del crédito">
                        @foreach (var estado in estadosCatalogo)
                        {
                            var deshabilitado = estado.NValor == EstadoAprobado && !EstaVerificado();
                            var (icono, descripcion) = PresentacionDecision(estado.NValor, deshabilitado);
                            <CdsOptionCard Text="@estado.CNomCod"
                                           Icon="@icono"
                                           Description="@descripcion"
                                           Selected="@(estadoElegido == estado.NValor)"
                                           Disabled="@deshabilitado"
                                           Title="@(deshabilitado ? "La solicitud debe estar verificada antes de aprobarse" : null)"
                                           OnClick="@(() => estadoElegido = estado.NValor)" />
                        }
                    </div>
                    <CdsTextArea @bind-Value="comentario"
                                 Placeholder="Comentario de la decisión (queda en el expediente)"
                                 Rows="3" />
                    @if (mensajeError is not null)
                    {
                        <CdsFormMessage Message="@mensajeError" />
                    }
                    <CdsButton Text="@(guardando ? "Guardando…" : "Guardar decisión")"
                               Icon="save"
                               Disabled="@(estadoElegido is null || guardando)"
                               Click="@(() => Guardar(estadoElegido))" />
                </div>
            </CdsCard>

            <CdsCard Padding="CdsCardPadding.None" Class="eva-section">
                <CdsCardHeader Title="Historial del expediente" />
                <div class="eva-section__body">
                    <ol class="eva-timeline">
                        @foreach (var (nombre, fecha) in Historial())
                        {
                            <li class="eva-timeline__item">
                                <span class="eva-timeline__marker" aria-hidden="true"></span>
                                <span class="eva-timeline__name">@nombre</span>
                                <span class="eva-timeline__date">@fecha</span>
                            </li>
                        }
                    </ol>
                </div>
            </CdsCard>
        </aside>
    </div>
}

@code {
    [Parameter] public int NCodAge { get; set; }
    [Parameter] public int NCodCred { get; set; }

    [Inject] private IEvaluacionCreditoService EvaluacionCreditoService { get; set; } = default!;
    [Inject] private ObtenerCatalogoCodigos ObtenerCatalogoCodigos { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private ICdsNotificationService Notifications { get; set; } = default!;
    [Inject] private DialogService DialogService { get; set; } = default!;

    private const int CodigoCatalogoEstadosCredito = 116;
    private const int EstadoEnAnalisis = 2;
    private const int EstadoAprobado = 3;
    private const int EstadoCancelado = 50;

    private const string RutaBandeja = "/otorgamiento/procesamiento-datos/bandeja-verificacion";
    private const string TabNegocio = "Negocio";
    private const string TabResidencia = "Confirmación de residencia";
    private const string TabReferencia = "Referencia";
    private const string TabGarantia = "Garantía";
    private const string TabVerificacion = "Verificación";

    private static readonly CultureInfo Cultura = CultureInfo.GetCultureInfo("es-SV");

    private static readonly PagePathItem[] RutaPagina =
    [
        "Otorgamiento",
        "Procesamiento de Datos",
        new("Bandeja de verificación", RutaBandeja)
    ];

    private EvaluacionCreditoDetalleDto? detalle;
    private List<CatalogoCodigoDto> estadosCatalogo = new();
    private bool cargando = true;
    private string? errorCarga;
    private bool guardando;
    private string? mensajeError;
    private int? estadoElegido;
    private string comentario = string.Empty;
    private string tabActual = TabNegocio;

    private string NombreCliente => NameFormatter.ToDisplayName(detalle?.Cliente.NombreCompleto);

    protected override Task OnInitializedAsync() => CargarAsync();

    private async Task CargarAsync()
    {
        cargando = true;
        errorCarga = null;
        var catalogoTask = ObtenerCatalogoCodigos.ObtenerCatalogoCodigo(CodigoCatalogoEstadosCredito);
        var detalleTask = EvaluacionCreditoService.ObtenerDetalleCompletoAsync(NCodAge, NCodCred);

        var catalogo = await catalogoTask;
        estadosCatalogo = catalogo
            .Where(c => c.NValor is EstadoEnAnalisis or EstadoAprobado or EstadoCancelado)
            .OrderBy(c => c.NValor switch
            {
                EstadoEnAnalisis => 0,
                EstadoAprobado => 1,
                EstadoCancelado => 2,
                _ => 3,
            })
            .ToList();
        var detalleResult = await detalleTask;
        detalle = detalleResult.Data;
        errorCarga = detalleResult.IsSuccess
            ? null
            : detalleResult.Message ?? $"No se pudo cargar la solicitud {NCodAge}-{NCodCred}.";
        estadoElegido = estadosCatalogo.Any(e => e.NValor == detalle?.Credito.NEstado)
            ? detalle?.Credito.NEstado
            : null;

        cargando = false;
    }

    private async Task Guardar(int? nuevoEstado)
    {
        if (nuevoEstado is null || detalle is null) return;

        guardando = true;
        mensajeError = null;
        var (exito, mensaje) = await EvaluacionCreditoService.ActualizarEvaluacionAsync(NCodAge, NCodCred, nuevoEstado.Value);
        guardando = false;

        if (!exito)
        {
            mensajeError = mensaje ?? "No se pudo guardar la decisión.";
            return;
        }

        NavigationManager.NavigateTo(RutaBandeja);
    }

    private void ConfigurarCalendario()
    {
        if (detalle is null)
            return;

        var credito = detalle.Credito;
        var invariant = CultureInfo.InvariantCulture;
        var parameters = new List<string>
        {
            $"agencyCode={credito.NCodAge}",
            $"creditCode={credito.NCodCred}",
            $"product={credito.NProd}",
            $"subProduct={credito.NSubProd}",
            $"amount={credito.NPrestamo.ToString(invariant)}",
            $"installments={credito.NNroCuotas}",
            $"startDate={credito.DFecVig:yyyy-MM-dd}"
        };

        if (credito.NCodLinea.HasValue)
            parameters.Add($"creditLineCode={credito.NCodLinea.Value}");

        if (credito.NTasaComp.HasValue)
            parameters.Add($"rate={credito.NTasaComp.Value.ToString(invariant)}");

        NavigationManager.NavigateTo($"/simulador-credito?{string.Join("&", parameters)}");
    }

    // Pendiente: la Web aún no tiene formularios de mantenimiento de cliente ni de capacidad de pago
    // (la API ya expone UpdateClient).
    private void MantenimientoPendiente() =>
        Notifications.Info("Próximamente", "La edición desde el expediente estará disponible en una próxima versión.");

    private Task AbrirGaleriaAsync(string titulo, string tipoFoto, IReadOnlyList<FotoGaleriaItem> fotos) =>
        DialogService.OpenAsync<FotoGaleria>(
            titulo,
            new Dictionary<string, object?>
            {
                [nameof(FotoGaleria.TipoFoto)] = tipoFoto,
                [nameof(FotoGaleria.Fotos)] = fotos,
                [nameof(FotoGaleria.ObtenerFoto)] = (Func<string, int, Task<string?>>)EvaluacionCreditoService.ObtenerFotoDataUrlAsync
            },
            new DialogOptions { Width = "min(960px, 92vw)", CloseDialogOnOverlayClick = true });

    // NTipoFoto de FotoIds lo define la app móvil y la API no guarda su significado: se numeran en orden.
    private IReadOnlyList<FotoGaleriaItem> FotosDocumentoIdentidad() =>
        (detalle?.Cliente.FotosDocumento ?? [])
            .Select((f, i) => new FotoGaleriaItem(f.IdFoto, $"Documento de identidad {i + 1}"))
            .ToList();

    private static string Money(decimal value) => value.ToString("C2", Cultura);

    private static string Iniciales(string nombreCompleto)
    {
        var partes = nombreCompleto.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var a = partes.Length > 0 ? partes[0][0].ToString() : "";
        var b = partes.Length > 1 ? partes[1][0].ToString() : "";
        return (a + b).ToUpperInvariant();
    }

    private bool EstaVerificado() => detalle?.Verificaciones.Count > 0;

    private static (string Icono, string Descripcion) PresentacionDecision(int estado, bool deshabilitado) => estado switch
    {
        EstadoEnAnalisis => ("manage_search", "Mantener la solicitud en revisión"),
        EstadoAprobado when deshabilitado => ("task_alt", "Disponible cuando la solicitud esté verificada"),
        EstadoAprobado => ("task_alt", "Aprobar el crédito con estas condiciones"),
        EstadoCancelado => ("block", "Rechazar y cerrar la solicitud"),
        _ => ("radio_button_unchecked", string.Empty)
    };

    private IEnumerable<(string Label, decimal Valor, bool EsIngreso)> FlujoFilas(CapacidadPagoEvaluacionDto c)
    {
        yield return ("Otros ingresos declarados", c.DOtrosIngresos, true);
        yield return ("Gastos de educación", c.DGastosEducacion, false);
        yield return ("Gastos de alimentación", c.DGastosAlimentacion, false);
        yield return ("Gastos de salud", c.DGastosSalud, false);
        yield return ("Otros gastos", c.DOtrosGastos, false);
    }

    /// <summary>Pestañas del expediente; el contador solo aparece donde indica cuántos registros hay.</summary>
    private IEnumerable<(string Nombre, int? Cantidad)> TabsDisponibles()
    {
        yield return (TabNegocio, null);
        yield return (TabResidencia, detalle?.Documentacion.Fotos.Count);
        yield return (TabReferencia, null);
        yield return (TabGarantia, null);
        yield return (TabVerificacion, detalle?.Verificaciones.Count);
    }

    private bool TieneGarantia() => detalle is not null &&
        (detalle.Garantia.NTipoGarantia > 0 ||
         detalle.Garantia.NMarca > 0 ||
         detalle.Garantia.NAnio > 0 ||
         detalle.Garantia.ValorTotal > 0 ||
         detalle.Garantia.Fotos.Count > 0);

    private string NombreTipoGarantia() => detalle?.Garantia.TipoGarantia
        ?? (detalle?.Garantia.NTipoGarantia > 0 ? detalle.Garantia.NTipoGarantia.ToString() : "Pendiente");

    private string NombreMarcaGarantia() => detalle?.Garantia.Marca
        ?? (detalle?.Garantia.NMarca > 0 ? detalle.Garantia.NMarca.ToString() : "Pendiente");

    private string NombreAnioGarantia() => detalle?.Garantia.Anio
        ?? (detalle?.Garantia.NAnio > 0 ? detalle.Garantia.NAnio.ToString() : "Pendiente");

    private string ValorGarantia() => detalle?.Garantia.ValorTotal > 0
        ? Money(detalle.Garantia.ValorTotal)
        : "Pendiente de verificación";

    private static string NombreDocumentoResidencia(FotoEvaluacionDto foto) =>
        foto.TipoFotoNombre ?? (foto.TipoFoto > 0 ? $"Documento {foto.TipoFoto}" : "Documento de residencia");

    private static string? UrlUbicacionNegocio(string? coordenadas)
    {
        if (string.IsNullOrWhiteSpace(coordenadas)) return null;
        return $"https://www.google.com/maps?q={Uri.EscapeDataString(coordenadas.Trim())}";
    }

    private static string NombreTipoNegocio(NegocioEvaluacionDto negocio) =>
        negocio.TipoNegocio ?? (negocio.CSector > 0 ? negocio.CSector.ToString() : "—");

    private static string HorarioNegocio(NegocioEvaluacionDto negocio)
    {
        if (string.IsNullOrWhiteSpace(negocio.THoraInicio) && string.IsNullOrWhiteSpace(negocio.THoraCierre))
            return "—";

        return $"{negocio.THoraInicio ?? "—"} – {negocio.THoraCierre ?? "—"}";
    }

    private IEnumerable<(string Nombre, string Fecha)> Historial()
    {
        if (detalle is null) yield break;

        var esVerificado = detalle.Credito.EstadoNombre?.Contains(
            "Verific",
            StringComparison.OrdinalIgnoreCase) == true;

        if (!string.Equals(detalle.Credito.EstadoNombre, "Solicitado", StringComparison.OrdinalIgnoreCase) &&
            (!esVerificado || detalle.Verificaciones.Count == 0))
        {
            yield return (detalle.Credito.EstadoNombre ?? "Estado actual", "Actual");
        }

        foreach (var v in detalle.Verificaciones.OrderByDescending(v => v.DFecha))
        {
            yield return ($"Verificado por {NameFormatter.ToDisplayName(v.CNombre)}", v.DFecha.ToString("d/M/yyyy HH:mm"));
        }

        yield return ("Solicitado", detalle.Credito.DFecVig.ToString("d/M/yyyy HH:mm"));
    }
}
