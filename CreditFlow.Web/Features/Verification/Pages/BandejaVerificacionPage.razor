@page "/otorgamiento/procesamiento-datos/bandeja-verificacion"
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using CreditFlow.Web.Features.Verification.Models
@using CreditFlow.Web.Features.Verification.Services

<CdsPageHeader Title="Bandeja de verificación"
               Icon="inbox"
               Path="@(new PagePathItem[] { "Otorgamiento", "Procesamiento de Datos" })"
               Description="Créditos pendientes de verificación y aprobación." />

<div class="cds-page cds-page--fill ver-page" @ref="paginaRootRef">
    <VerificationSummary QueueCount="@Creditos.Count"
                         NewToday="@NuevosHoy"
                         RepeatLoans="@ConRepretamo"
                         TotalAmount="@MontoTotal" />

    <CdsCard Padding="CdsCardPadding.None" Class="ver-table-card">
        <CdsCardHeader Title="Créditos en cola" Badge="@($"{CreditosFiltrados.Count()} créditos")">
            <Actions>
                <CdsStatusBadge Variant="CdsStatusBadgeVariant.Chip"
                                Appearance="@CdsStatusAppearance.Success"
                                Text="@($"En vivo · hace {SegundosDesdeActualizacion} s")"
                                title="La bandeja se actualiza automáticamente cada 2 minutos"
                                role="status" />
                <CdsExportButton Format="CdsExportFormat.Excel"
                                 Disabled="@(!CreditosFiltrados.Any())"
                                 Click="@(() => grilla.ExportarExcelAsync())" />
            </Actions>
        </CdsCardHeader>

        <div class="ver-filters">
            <EstadoFilterTabs TItem="VerificacionListItem"
                              Items="@Creditos"
                              EstadoSelector="@(c => c.NEstado)"
                              Selected="@EstadoSeleccionado"
                              VisibleStates="@EstadosBandeja"
                              SelectedChanged="@(estado => EstadoSeleccionado = estado)" />
        </div>

        <div class="ver-grid">
            <GridEstandar @ref="grilla"
                          TItem="VerificacionListItem"
                          Data="@CreditosFiltrados"
                          IsLoading="@Cargando"
                          LoadingText="Cargando bandeja de verificación…"
                          ErrorMessage="@ErrorCarga"
                          OnRetry="@CargarAsync"
                          EmptyText="No hay créditos pendientes en la bandeja."
                          ExportFileName="bandeja-verificacion"
                          ShowAddButton="false"
                          ShowExportButton="false"
                          FillHeight="true"
                          SelectionMode="DataGridSelectionMode.Single"
                          RowSelect="@AbrirEvaluacion">
                <RadzenDataGridColumn TItem="VerificacionListItem" Property="@nameof(VerificacionListItem.CodigoCredito)" Title="Crédito" Width="110px" Frozen="true" TextAlign="TextAlign.Center">
                    <Template Context="credito">
                        @* stopPropagation: el clic en la fila ya navega; evita una segunda navegación. *@
                        <a class="cds-link" href="@RutaEvaluacion(credito)" @onclick:stopPropagation="true">@credito.CodigoCredito</a>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VerificacionListItem" Property="@nameof(VerificacionListItem.NombreClienteVisible)" Title="Nombre" Width="240px" TextAlign="TextAlign.Left" Frozen="true" />
                <RadzenDataGridColumn TItem="VerificacionListItem" Property="@nameof(VerificacionListItem.DFecVig)" Title="Fecha de solicitud" Width="150px" FormatString="{0:dd/MM/yyyy HH:mm}" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="VerificacionListItem" Property="@nameof(VerificacionListItem.AgenciaCredito)" Title="Agencia" Width="160px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="VerificacionListItem" Property="@nameof(VerificacionListItem.SubProducto)" Title="Subproducto" Width="180px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="VerificacionListItem" Property="@nameof(VerificacionListItem.MontoSolicitado)" Title="Monto" Width="140px" FormatString="{0:C2}" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="VerificacionListItem" Property="@nameof(VerificacionListItem.UsuarioGestion)" Title="Gestionado por" Width="160px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="VerificacionListItem" Property="@nameof(VerificacionListItem.Estado)" Title="Estado" Width="170px" TextAlign="TextAlign.Center" />
            </GridEstandar>
        </div>
    </CdsCard>
</div>

@code {
    [Inject] private IVerificacionService VerificacionService { get; set; } = default!;
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private ICdsNotificationService Notifications { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private ElementReference paginaRootRef;
    private GridEstandar<VerificacionListItem> grilla = default!;

    private const int SegundosEntreRefrescos = 120;

    // Estados que la API incluye en la bandeja (Solicitado, En análisis, Aprobado, Verificado);
    // misma lista que ObtenerBandejaVerificacionHandler.EstadosVisibles.
    private static readonly int[] EstadosBandeja = [1, 2, 3, 5];

    private List<VerificacionListItem> Creditos { get; set; } = new();
    private bool Cargando = true;
    private bool CargaInicialCompleta;
    private string? ErrorCarga;
    private int? EstadoSeleccionado;

    private System.Timers.Timer? _timerRefresco;
    private System.Timers.Timer? _timerReloj;
    private int SegundosDesdeActualizacion;

    private IEnumerable<VerificacionListItem> CreditosFiltrados => EstadoSeleccionado is null
        ? Creditos
        : Creditos.Where(c => c.NEstado == EstadoSeleccionado);

    private int NuevosHoy => Creditos.Count(c => c.DFecVig.Date == DateTime.Today);
    private int ConRepretamo => Creditos.Count(c => c.ConRepretamo);
    private decimal MontoTotal => Creditos.Sum(c => c.MontoSolicitado);

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();

        _timerReloj = new System.Timers.Timer(1000);
        _timerReloj.Elapsed += async (_, _) =>
        {
            SegundosDesdeActualizacion++;
            await InvokeAsync(StateHasChanged);
        };
        _timerReloj.Start();

        _timerRefresco = new System.Timers.Timer(SegundosEntreRefrescos * 1000);
        _timerRefresco.Elapsed += async (_, _) => await InvokeAsync(CargarAsync);
        _timerRefresco.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.FitAsync(paginaRootRef);
    }

    private async Task CargarAsync()
    {
        if (!CargaInicialCompleta)
            Cargando = true;

        var result = await VerificacionService.ObtenerBandejaAsync();
        if (result.IsSuccess)
        {
            Creditos = result.Data ?? [];
            SegundosDesdeActualizacion = 0;
            ErrorCarga = null;
            CargaInicialCompleta = true;
        }
        else if (CargaInicialCompleta)
        {
            Notifications.Error("No se pudo actualizar la bandeja", result.Message);
        }
        else
        {
            ErrorCarga = result.Message;
        }

        Cargando = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        _timerRefresco?.Dispose();
        _timerReloj?.Dispose();
    }

    private static string RutaEvaluacion(VerificacionListItem credito) =>
        $"/otorgamiento/evaluacion/{credito.NCodAge}/{credito.NCodCred}";

    private void AbrirEvaluacion(VerificacionListItem credito)
    {
        NavigationManager.NavigateTo(RutaEvaluacion(credito));
    }
}
