@typeparam TItem
@using CreditFlow.Web.Shared.Catalog.Models
@using CreditFlow.Web.Shared.Catalog.Services
@using CreditFlow.Web.Shared.Credit.Presentation
@inject ObtenerCatalogoCodigos ObtenerCatalogoCodigos

<div class="status-tabs">
    <button type="button" class="status-tab @(Selected is null ? "status-tab--selected" : null)" @onclick="() => Seleccionar(null)" style="@ColorVariable("var(--cds-status-default-content)")">
        <span class="status-tab__dot"></span>
        <span>Todos</span>
        <span class="status-tab__count">@Items.Count()</span>
    </button>

    @foreach (var estado in estados)
    {
        var nValor = estado.NValor;
        var color = CreditStatusPalette.Resolve(nValor).ContentColor;
        var cantidad = Items.Count(i => EstadoSelector(i) == nValor);

        <button type="button" class="status-tab @(Selected == nValor ? "status-tab--selected" : null)" @onclick="() => Seleccionar(nValor)" style="@ColorVariable(color)">
            <span class="status-tab__dot"></span>
            <span>@estado.CNomCod</span>
            <span class="status-tab__count">@cantidad</span>
        </button>
    }
</div>

@code {
    private const int CodigoCatalogoEstadosCredito = 116;

    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();

    [Parameter, EditorRequired] public Func<TItem, int> EstadoSelector { get; set; } = default!;

    [Parameter] public int? Selected { get; set; }

    [Parameter] public EventCallback<int?> SelectedChanged { get; set; }

    private List<CatalogoCodigoDto> estados = new();

    protected override async Task OnInitializedAsync()
    {
        var catalogo = await ObtenerCatalogoCodigos.ObtenerCatalogoCodigo(CodigoCatalogoEstadosCredito);

        estados = catalogo.Where(c => c.NValor != c.NCodigo).ToList();
    }

    private Task Seleccionar(int? estado) => SelectedChanged.InvokeAsync(estado);

    private static string ColorVariable(string color) => $"--status-tab-color:{color};";
}
