@using CreditFlow.Web.Core.Navigation
@implements IDisposable
@inject MenuPermissionService Permisos

@* Menú lateral armado desde MenuCatalog: cada usuario ve solo las opciones que permiten sus roles
   (mantenimiento «Permisos por rol»). El buscador filtra por título en cualquier nivel. *@
<AuthorizeView>
    <Authorized>
        <div class="nav-shell">
            <div class="nav-search">
                <label class="nav-search-box">
                    <RadzenIcon Icon="search" class="nav-search-icon" />
                    <input type="text" placeholder="Buscar en el menú" aria-label="Buscar en el menú"
                           value="@busqueda" @oninput="OnBusquedaChanged" />
                </label>
            </div>

            <nav class="nav-scroll flex-column">
                @if (Permisos.ErrorDeCarga)
                {
                    <div class="nav-item px-3">
                        <button type="button" class="nav-link btn btn-link text-start w-100" @onclick="ReintentarAsync">
                            <RadzenIcon Icon="refresh" />
                            <span>No se pudo cargar el menú. Reintentar</span>
                        </button>
                    </div>
                }

                @foreach (var nodo in MenuCatalog.Tree.Where(Visible))
                {
                    @Nivel0(nodo)
                }
            </nav>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private string busqueda = string.Empty;
    private readonly HashSet<string> expandidos = [];

    private bool Buscando => !string.IsNullOrWhiteSpace(busqueda);

    protected override async Task OnInitializedAsync()
    {
        Permisos.Changed += OnPermisosChanged;
        await Permisos.CargarAsync();
    }

    private void OnPermisosChanged() => InvokeAsync(StateHasChanged);

    private async Task ReintentarAsync() => await Permisos.RecargarAsync();

    private void OnBusquedaChanged(ChangeEventArgs e) => busqueda = e.Value?.ToString() ?? string.Empty;

    private void Toggle(string clave)
    {
        if (!expandidos.Remove(clave))
            expandidos.Add(clave);
    }

    private bool Abierto(MenuNode nodo) => nodo.Kind == MenuNodeKind.Section || Buscando || expandidos.Contains(nodo.Key);

    /// <summary>Permitido y, si hay búsqueda, el título coincide en el nodo, en un ancestro o en algún descendiente.</summary>
    private bool Visible(MenuNode nodo) => Permisos.PuedeVer(nodo) && (!Buscando || CoincideEnRama(nodo));

    private bool VisibleBajo(MenuNode padre, MenuNode hijo) =>
        Permisos.PuedeVer(hijo) && (!Buscando || Coincide(padre) || CoincideEnRama(hijo));

    private bool Coincide(MenuNode nodo) => nodo.Title.Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase);

    private bool CoincideEnRama(MenuNode nodo) => Coincide(nodo) || nodo.Items.Any(CoincideEnRama);

    private RenderFragment Nivel0(MenuNode nodo) => __builder =>
    {
        switch (nodo.Kind)
        {
            case MenuNodeKind.Page:
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="@nodo.Href" Match="@(nodo.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)" title="@nodo.Title">
                        <RadzenIcon Icon="@nodo.Icon" />
                        <span>@nodo.Title</span>
                    </NavLink>
                </div>
                break;

            case MenuNodeKind.Section:
                @* Encabezado fijo de sección: siempre desplegado, sin interacción. *@
                <div class="nav-item px-3">
                    <div class="nav-link nav-section-title">
                        <RadzenIcon Icon="@nodo.Icon" />
                        <span>@nodo.Title</span>
                    </div>
                </div>
                <div class="nav-subgroup">
                    @foreach (var hijo in nodo.Items.Where(h => VisibleBajo(nodo, h)))
                    {
                        @Nivel1(nodo, hijo)
                    }
                </div>
                break;

            default:
                <div class="nav-item px-3">
                    <button type="button" class="nav-link nav-link-toggle btn btn-link text-start w-100"
                            aria-expanded="@Abierto(nodo)" @onclick="() => Toggle(nodo.Key)">
                        <RadzenIcon Icon="@nodo.Icon" />
                        <span>@nodo.Title</span>
                        <RadzenIcon Icon="@(Abierto(nodo) ? "expand_less" : "expand_more")" class="nav-toggle-icon" />
                    </button>
                </div>
                @if (Abierto(nodo))
                {
                    <div class="nav-subgroup">
                        @foreach (var hijo in nodo.Items.Where(h => VisibleBajo(nodo, h)))
                        {
                            @Nivel1(nodo, hijo)
                        }
                    </div>
                }
                break;
        }
    };

    private RenderFragment Nivel1(MenuNode padre, MenuNode nodo) => __builder =>
    {
        if (nodo.IsPage)
        {
            <div class="nav-item nav-item-sub px-3">
                <NavLink class="nav-link" href="@nodo.Href" title="@nodo.Title">
                    <RadzenIcon Icon="@nodo.Icon" />
                    <span>@nodo.Title</span>
                </NavLink>
            </div>
            return;
        }

        <div class="nav-item nav-item-sub px-3">
            <button type="button" class="nav-link nav-link-toggle btn btn-link text-start w-100"
                    aria-expanded="@Abierto(nodo)" @onclick="() => Toggle(nodo.Key)">
                <RadzenIcon Icon="@nodo.Icon" />
                <span>@nodo.Title</span>
                <RadzenIcon Icon="@(Abierto(nodo) ? "expand_less" : "expand_more")" class="nav-toggle-icon" />
            </button>
        </div>
        @if (Abierto(nodo))
        {
            <div class="nav-subgroup nav-subgroup-nivel2">
                @foreach (var hoja in nodo.Items.Where(h => VisibleBajo(nodo, h) || (Buscando && Permisos.PuedeVer(h) && Coincide(padre))))
                {
                    <div class="nav-item nav-item-sub2 px-3">
                        <NavLink class="nav-link" href="@hoja.Href" title="@hoja.Title">
                            <RadzenIcon Icon="@hoja.Icon" />
                            <span>@hoja.Title</span>
                        </NavLink>
                    </div>
                }
            </div>
        }
    };

    public void Dispose() => Permisos.Changed -= OnPermisosChanged;
}
