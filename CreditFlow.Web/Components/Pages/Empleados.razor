@page "/empleados"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Supervisor,Tecnologia")]
@inject IJSRuntime JS

<PageTitle>Mantenimiento de Empleados</PageTitle>

<h3>Empleados</h3>

@if (!string.IsNullOrEmpty(ErrorMensaje))
{
    <div class="alert alert-danger" role="alert">@ErrorMensaje</div>
}

@if (!string.IsNullOrEmpty(ExitoMensaje))
{
    <div class="alert alert-success" role="alert">@ExitoMensaje</div>
}

<AuthorizeView Roles="Admin">
    <Authorized>
        @if (Modo == FormMode.None)
        {
            <button class="btn btn-primary mb-3" @onclick="MostrarFormularioCrearAsync">
                Nuevo empleado
            </button>
        }
        else if (Modo == FormMode.Crear)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5>Nuevo empleado</h5>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">Documento</label>
                            <input class="form-control" @bind="NuevoEmpleado.Documento" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Nombres</label>
                            <input class="form-control" @bind="NuevoEmpleado.Nombres" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Primer apellido</label>
                            <input class="form-control" @bind="NuevoEmpleado.PrimerApellido" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Segundo apellido</label>
                            <input class="form-control" @bind="NuevoEmpleado.SegundoApellido" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Sexo</label>
                            <input type="number" class="form-control" @bind="NuevoEmpleado.Sexo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Código de agencia</label>
                            <input type="number" class="form-control" @bind="NuevoEmpleado.CodAgencia" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Correo</label>
                            <input class="form-control" @bind="NuevoEmpleado.Correo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Teléfono</label>
                            <input class="form-control" @bind="NuevoEmpleado.Telefono" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Contraseña</label>
                            <input type="password" class="form-control" @bind="NuevoEmpleado.Password" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Rol</label>
                            <select class="form-select" @bind="NuevoEmpleado.IdRol">
                                <option value="0">-- Seleccionar --</option>
                                @foreach (var rol in Roles)
                                {
                                    <option value="@rol.IdRol">@rol.Nombre</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-success" @onclick="GuardarCreacionAsync" disabled="@Guardando">
                            @(Guardando ? "Guardando..." : "Guardar")
                        </button>
                        <button class="btn btn-secondary" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </div>
            </div>
        }
        else if (Modo == FormMode.Editar)
        {
            <div class="card mb-4">
                <div class="card-body">
                    <h5>Editar empleado (@EditandoDocumento)</h5>
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">Nombres</label>
                            <input class="form-control" @bind="EditandoEmpleado.Nombres" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Primer apellido</label>
                            <input class="form-control" @bind="EditandoEmpleado.PrimerApellido" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Segundo apellido</label>
                            <input class="form-control" @bind="EditandoEmpleado.SegundoApellido" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Sexo</label>
                            <input type="number" class="form-control" @bind="EditandoEmpleado.Sexo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Código de agencia</label>
                            <input type="number" class="form-control" @bind="EditandoEmpleado.CodAgencia" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Correo</label>
                            <input class="form-control" @bind="EditandoEmpleado.Correo" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Teléfono</label>
                            <input class="form-control" @bind="EditandoEmpleado.Telefono" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Rol</label>
                            <select class="form-select" @bind="EditandoEmpleado.IdRol">
                                <option value="0">-- Seleccionar --</option>
                                @foreach (var rol in Roles)
                                {
                                    <option value="@rol.IdRol">@rol.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Estado</label>
                            <select class="form-select" @bind="EditandoEmpleado.Estado">
                                <option value="1">Activo</option>
                                <option value="0">Inactivo</option>
                            </select>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-success" @onclick="GuardarEdicionAsync" disabled="@Guardando">
                            @(Guardando ? "Guardando..." : "Guardar")
                        </button>
                        <button class="btn btn-secondary" @onclick="CancelarFormulario">Cancelar</button>
                    </div>
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@if (Cargando)
{
    <p><em>Cargando...</em></p>
}
else if (ListaEmpleados.Count == 0)
{
    <p><em>No hay empleados registrados.</em></p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Documento</th>
                <th>Nombres</th>
                <th>Apellidos</th>
                <th>Agencia</th>
                <th>Correo</th>
                <th>Teléfono</th>
                <th>Rol</th>
                <th>Estado</th>
                <AuthorizeView Roles="Admin" Context="accionesContext">
                    <Authorized><th>Acciones</th></Authorized>
                </AuthorizeView>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in ListaEmpleados)
            {
                <tr>
                    <td>@e.Documento</td>
                    <td>@e.Nombres</td>
                    <td>@e.PrimerApellido @e.SegundoApellido</td>
                    <td>@e.CodAgencia</td>
                    <td>@e.Correo</td>
                    <td>@e.Telefono</td>
                    <td>@(e.Rol ?? "-")</td>
                    <td>@(e.Estado == 1 ? "Activo" : "Inactivo")</td>
                    <AuthorizeView Roles="Admin" Context="filaContext">
                        <Authorized>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => MostrarFormularioEditarAsync(e)">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarAsync(e)">Eliminar</button>
                            </td>
                        </Authorized>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Inject] private IEmpleadoService EmpleadoService { get; set; } = default!;
    [Inject] private IAuthService AuthService { get; set; } = default!;

    private enum FormMode { None, Crear, Editar }

    private List<EmpleadoDto> ListaEmpleados { get; set; } = new();
    private List<RoleDto> Roles { get; set; } = new();
    private CrearEmpleadoRequest NuevoEmpleado { get; set; } = new();
    private ActualizarEmpleadoRequest EditandoEmpleado { get; set; } = new();

    private FormMode Modo = FormMode.None;
    private int EditandoId;
    private string EditandoDocumento = string.Empty;

    private bool Cargando = true;
    private bool Guardando;
    private string? ErrorMensaje;
    private string? ExitoMensaje;

    protected override async Task OnInitializedAsync()
    {
        await CargarEmpleadosAsync();
    }

    private async Task CargarEmpleadosAsync()
    {
        Cargando = true;
        ListaEmpleados = await EmpleadoService.ObtenerTodosAsync();
        Cargando = false;
    }

    private async Task AsegurarRolesCargadosAsync()
    {
        if (Roles.Count == 0)
            Roles = await AuthService.ObtenerRolesAsync();
    }

    private async Task MostrarFormularioCrearAsync()
    {
        ErrorMensaje = null;
        ExitoMensaje = null;
        NuevoEmpleado = new CrearEmpleadoRequest();
        await AsegurarRolesCargadosAsync();
        Modo = FormMode.Crear;
    }

    private async Task MostrarFormularioEditarAsync(EmpleadoDto empleado)
    {
        ErrorMensaje = null;
        ExitoMensaje = null;
        await AsegurarRolesCargadosAsync();

        EditandoId = empleado.IdEmpleado;
        EditandoDocumento = empleado.Documento;
        EditandoEmpleado = new ActualizarEmpleadoRequest
        {
            Nombres = empleado.Nombres,
            PrimerApellido = empleado.PrimerApellido,
            SegundoApellido = empleado.SegundoApellido,
            Sexo = empleado.Sexo,
            CodAgencia = empleado.CodAgencia,
            Correo = empleado.Correo,
            Telefono = empleado.Telefono,
            Estado = empleado.Estado,
            IdRol = Roles.FirstOrDefault(r => r.Nombre == empleado.Rol)?.IdRol ?? 0
        };

        Modo = FormMode.Editar;
    }

    private void CancelarFormulario()
    {
        Modo = FormMode.None;
    }

    private async Task GuardarCreacionAsync()
    {
        ErrorMensaje = null;
        ExitoMensaje = null;

        if (string.IsNullOrWhiteSpace(NuevoEmpleado.Documento) || string.IsNullOrWhiteSpace(NuevoEmpleado.Password))
        {
            ErrorMensaje = "Documento y contraseña son obligatorios.";
            return;
        }

        if (NuevoEmpleado.IdRol <= 0)
        {
            ErrorMensaje = "Debe seleccionar un rol.";
            return;
        }

        Guardando = true;
        var (exito, mensaje) = await EmpleadoService.CrearAsync(NuevoEmpleado);
        Guardando = false;

        if (!exito)
        {
            ErrorMensaje = mensaje;
            return;
        }

        ExitoMensaje = "Empleado creado correctamente.";
        Modo = FormMode.None;
        await CargarEmpleadosAsync();
    }

    private async Task GuardarEdicionAsync()
    {
        ErrorMensaje = null;
        ExitoMensaje = null;

        if (EditandoEmpleado.IdRol <= 0)
        {
            ErrorMensaje = "Debe seleccionar un rol.";
            return;
        }

        Guardando = true;
        var (exito, mensaje) = await EmpleadoService.ActualizarAsync(EditandoId, EditandoEmpleado);
        Guardando = false;

        if (!exito)
        {
            ErrorMensaje = mensaje;
            return;
        }

        ExitoMensaje = "Empleado actualizado correctamente.";
        Modo = FormMode.None;
        await CargarEmpleadosAsync();
    }

    private async Task EliminarAsync(EmpleadoDto empleado)
    {
        ErrorMensaje = null;
        ExitoMensaje = null;

        var confirmado = await JS.InvokeAsync<bool>("confirm", $"¿Dar de baja a {empleado.Nombres} {empleado.PrimerApellido}?");
        if (!confirmado)
            return;

        var (exito, mensaje) = await EmpleadoService.EliminarAsync(empleado.IdEmpleado);

        if (!exito)
        {
            ErrorMensaje = mensaje;
            return;
        }

        ExitoMensaje = "Empleado dado de baja correctamente.";
        await CargarEmpleadosAsync();
    }
}
