@page "/simulador-credito"
@attribute [Authorize(Policy = AuthorizationPolicies.CalendarConfiguration)]
@using CreditFlow.Web.Models.Mantenimientos
@implements IDisposable
@inject CreditFlow.Web.Services.PageHeaderService Header

<PageTitle>Simulador de Crédito</PageTitle>

<div class="sim-page" @ref="paginaRootRef">

  <div class="sim-body">

    <div class="sim-sidebar">
      <div class="sim-card">
        <div class="sim-card-head">
          <span class="sim-kick">Condiciones</span>
          <button class="sim-btn-mini" @onclick="RestablecerAsync">Restablecer</button>
        </div>

        <div class="sim-field">
          <label class="sim-label">Agencia</label>
          <select class="sim-input" @bind="nCodAge" @bind:after="SimularAsync">
            <option value="0">Seleccione...</option>
            @foreach (var a in agencias)
            {
              <option value="@a.NCodAge">@a.Nombre</option>
            }
          </select>
        </div>

        <div class="sim-field">
          <div class="sim-row-between">
            <span class="sim-label">Préstamo</span>
            <input type="number" class="sim-input-num" min="50" max="@MontoMaximoSlider" step="1" @bind="monto" @bind:event="onchange" @bind:after="SimularAsync" />
          </div>
          <input type="range" min="50" max="@MontoMaximoSlider" step="1" class="sim-slider" @bind="monto" @bind:event="onchange" @bind:after="SimularAsync" />
        </div>

        <div class="sim-field">
          <div class="sim-row-between">
            <span class="sim-label">Nro. de cuotas</span>
            <input type="number" class="sim-input-num" min="1" max="@CuotasMaximasSlider" step="1" @bind="cuotas" @bind:event="onchange" @bind:after="SimularAsync" />
          </div>
          <input type="range" min="1" max="@CuotasMaximasSlider" step="1" class="sim-slider" @bind="cuotas" @bind:event="onchange" @bind:after="SimularAsync" />
        </div>

        <div class="sim-field">
          <label class="sim-label">Subproducto</label>
          <select class="sim-input" @bind="nSubProd" @bind:after="SimularAsync">
            @foreach (var p in Periodicidades)
            {
              <option value="@p.NSubProd">@p.Label</option>
            }
          </select>
        </div>

        <div class="sim-field-grid">
          <div class="sim-field">
            <label class="sim-label">Tasa (override)</label>
            <input type="text" class="sim-input" placeholder="Auto" @bind="tasaOverrideStr" @bind:after="SimularAsync" />
          </div>
          <div class="sim-field">
            <label class="sim-label">Desembolso</label>
            <input type="date" class="sim-input" @bind="fechaInicio" @bind:after="SimularAsync" />
          </div>
        </div>

        <div class="sim-field">
          <span class="sim-label">
            Cobrar también en
            <span class="sim-info" title="Los vencimientos que caen en día no habilitado se corren al siguiente día hábil.">i</span>
          </span>
          <div class="sim-pill-row">
            <button class="sim-pill @(permiteSabado ? "on" : "")" @onclick="() => ToggleDiaAsync(() => permiteSabado = !permiteSabado)">Sábado</button>
            <button class="sim-pill @(permiteDomingo ? "on" : "")" @onclick="() => ToggleDiaAsync(() => permiteDomingo = !permiteDomingo)">Domingo</button>
            <button class="sim-pill @(permiteFeriado ? "on" : "")" @onclick="() => ToggleDiaAsync(() => permiteFeriado = !permiteFeriado)">Feriados</button>
          </div>
        </div>

        <div class="sim-section">
          <span class="sim-label">Avanzado</span>
          <div class="sim-field-grid">
            <div class="sim-field">
              <label class="sim-label">Refinanciado</label>
              <select class="sim-input" @bind="bRefinanciadoStr" @bind:after="SimularAsync">
                <option value="false">No</option>
                <option value="true">Sí</option>
              </select>
            </div>
            <div class="sim-field">
              <label class="sim-label">
                Categoría
                <span class="sim-info" title="Determina qué línea de tarifario aplica. No todas las combinaciones de monto, plazo y periodicidad existen para todas las categorías.">i</span>
              </label>
              <select class="sim-input" @bind="nCategoria" @bind:after="SimularAsync">
                @for (int c = 1; c <= 16; c++)
                {
                  <option value="@c">Categoría @c</option>
                }
              </select>
            </div>
          </div>
          <div class="sim-field">
            <label class="sim-label">Gasto por cuota (override)</label>
            <input type="text" class="sim-input" placeholder="Auto" @bind="gastoOverrideStr" @bind:after="SimularAsync" />
          </div>
        </div>
      </div>
    </div>

    <div class="sim-main">

      @if (cargando)
      {
        <div class="sim-overlay">
          <div class="sim-spinner"></div>
          <span>Generando cronograma...</span>
        </div>
      }

      @if (error is not null)
      {
        <div class="sim-alert">
          <span class="sim-alert-dot"></span>
          <div>@error</div>
        </div>
      }
      else if (resultado is not null)
      {
        <div class="sim-card sim-summary-card">
          <div class="sim-summary-top">
            <div class="sim-cuota-block">
              <div class="sim-kick">Cuota @PeriodicidadLabel(nSubProd).ToLower()</div>
              <div class="sim-cuota-num">@Money(resultado.CuotaFija)</div>
            </div>
            <div class="sim-summary-grid">
              @foreach (var s in ResumenItems())
              {
                <div class="sim-summary-item">
                  <div class="sim-summary-key">@s.Key</div>
                  <div class="sim-num @(s.Strong ? "sim-summary-val-strong" : "sim-summary-val")">@s.Value</div>
                </div>
              }
            </div>
          </div>

          <div class="sim-bar">
            <div class="sim-bar-seg cap" style="width:@Pct(resultado.TotalCapital, resultado.TotalPagado)%"></div>
            <div class="sim-bar-seg int" style="width:@Pct(resultado.TotalInteres, resultado.TotalPagado)%"></div>
            <div class="sim-bar-seg iva" style="width:@Pct(resultado.TotalIva, resultado.TotalPagado)%"></div>
            <div class="sim-bar-seg gas" style="width:@Pct(resultado.TotalGasto, resultado.TotalPagado)%"></div>
          </div>
          <div class="sim-legend">
            <div class="sim-legend-item"><span class="sim-dot cap"></span>Capital <span class="sim-num">@Money(resultado.TotalCapital)</span></div>
            <div class="sim-legend-item"><span class="sim-dot int"></span>Interés <span class="sim-num">@Money(resultado.TotalInteres)</span></div>
            <div class="sim-legend-item"><span class="sim-dot iva"></span>IVA <span class="sim-num">@Money(resultado.TotalIva)</span></div>
            <div class="sim-legend-item"><span class="sim-dot gas"></span>Gastos <span class="sim-num">@Money(resultado.TotalGasto)</span></div>
          </div>
        </div>

        <div class="sim-card sim-table-card">
          <div class="sim-table-head">
            <div class="sim-table-title">
              Detalle de cuotas
              <span class="sim-badge">@resultado.Cronograma.Count pagos</span>
            </div>
            <div class="sim-status-wrap">
              <span class="sim-status @(EstaCuadrado ? "ok" : "bad")">
                <span class="sim-status-dot"></span>
                @(EstaCuadrado ? "Cronograma cuadrado" : $"Descuadre de {Money(SaldoFinal)}")
              </span>
              <button class="sim-btn-outline" @onclick="ExportarCsvAsync">Exportar CSV</button>
            </div>
          </div>

          <div class="sim-table-scroll">
            <div class="sim-table-grid sim-table-header">
              <div class="sim-th">Cuota</div>
              <div class="sim-th">Vencimiento</div>
              <div class="sim-th">Capital</div>
              <div class="sim-th">Interés</div>
              <div class="sim-th">IVA</div>
              <div class="sim-th">Gastos</div>
              <div class="sim-th">Total</div>
              <div class="sim-th">Saldo</div>
            </div>

            @foreach (var r in FilasVisibles())
            {
              <div class="sim-table-grid sim-table-row">
                <div class="sim-td muted">@r.NroCuota</div>
                <div class="sim-td">@r.FechaVencimiento.ToString("dd MMM yy")</div>
                <div class="sim-td strong">@Money(r.Capital)</div>
                <div class="sim-td">@Money(r.Interes)</div>
                <div class="sim-td">@Money(r.Iva)</div>
                <div class="sim-td">@Money(r.Gasto)</div>
                <div class="sim-td strong verde">@Money(r.TotalCuota)</div>
                <div class="sim-td @(r.SaldoDespues == 0 ? "verde" : "")">@Money(r.SaldoDespues)</div>
              </div>
            }

            <div class="sim-table-grid sim-table-footer">
              <div class="sim-td strong">Total</div>
              <div></div>
              <div class="sim-td strong">@Money(resultado.TotalCapital)</div>
              <div class="sim-td strong">@Money(resultado.TotalInteres)</div>
              <div class="sim-td strong">@Money(resultado.TotalIva)</div>
              <div class="sim-td strong">@Money(resultado.TotalGasto)</div>
              <div class="sim-td strong verde">@Money(resultado.TotalPagado)</div>
              <div></div>
            </div>
          </div>

          <div class="sim-pager">
            <RadzenPager @key="paginaKey"
                         HorizontalAlign="HorizontalAlign.Center"
                         Count="@resultado.Cronograma.Count"
                         PageSize="@FilasPorPagina"
                         PageNumbersCount="5"
                         ShowPagingSummary="true"
                         PagingSummaryFormat="Página {0} de {1} ({2} elementos)"
                         PageChanged="@OnPageChanged" />
          </div>
        </div>
      }
      else if (!cargando)
      {
        <div class="sim-card sim-loading">Seleccione una agencia para generar el cronograma.</div>
      }
    </div>
  </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "agencyCode")] public int? AgencyCode { get; set; }
    [SupplyParameterFromQuery(Name = "creditCode")] public int? CreditCode { get; set; }
    [SupplyParameterFromQuery(Name = "creditLineCode")] public int? CreditLineCode { get; set; }
    [SupplyParameterFromQuery(Name = "product")] public int? Product { get; set; }
    [SupplyParameterFromQuery(Name = "subProduct")] public int? SubProduct { get; set; }
    [SupplyParameterFromQuery(Name = "amount")] public decimal? Amount { get; set; }
    [SupplyParameterFromQuery(Name = "installments")] public int? Installments { get; set; }
    [SupplyParameterFromQuery(Name = "startDate")] public DateTime? StartDate { get; set; }
    [SupplyParameterFromQuery(Name = "rate")] public decimal? Rate { get; set; }

    [Inject] private CreditFlow.Web.Services.Mantenimientos.IAgenciaService AgenciaService { get; set; } = default!;
    [Inject] private CreditFlow.Web.Services.ISimulacionCalendarioService SimulacionService { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private ElementReference paginaRootRef;

    private List<AgenciaDto> agencias = new();

    private int nCodAge;
    private int nProd = 4;
    private decimal monto = 500m;
    private int cuotas = 12;
    private int nSubProd = 4;
    private DateTime fechaInicio = DateTime.Today;
    private bool permiteSabado;
    private bool permiteDomingo;
    private bool permiteFeriado;
    private int nCategoria = 1;
    private bool bRefinanciado;
    private string bRefinanciadoStr
    {
        get => bRefinanciado.ToString().ToLowerInvariant();
        set => bRefinanciado = value == "true";
    }
    private string? tasaOverrideStr;
    private string? gastoOverrideStr;

    private bool cargando;
    private string? error;
    private CreditFlow.Web.Models.SimularCalendarioResponse? resultado;

    private int paginaSkip = 0;
    private int paginaKey = 0;
    private const int FilasPorPagina = 10;
    private decimal MontoMaximoSlider => Math.Max(10_000m, Math.Ceiling(monto));
    private int CuotasMaximasSlider => Math.Max(48, cuotas);
    private bool TieneContextoCredito => AgencyCode > 0 && CreditCode > 0;

    private record OpcionPeriodicidad(string Label, int NSubProd);
    private static readonly List<OpcionPeriodicidad> Periodicidades = new()
    {
        new("Diario", 1),
        new("Semanal", 2),
        new("Quincenal", 3),
        new("Mensual", 4),
    };

    protected override async Task OnInitializedAsync()
    {
        ActualizarTituloPagina();

        agencias = await AgenciaService.ObtenerTodasAsync();
        if (!AplicarContextoCredito() && agencias.Count > 0)
            nCodAge = agencias[0].NCodAge;

        await SimularAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // El alto exacto disponible depende del tema/layout de Radzen (barra
        // superior, paddings) y puede variar por zoom o DPI; se mide en el
        // navegador en vez de asumir un valor fijo en CSS, para que la página
        // siempre quepa exacto y nunca produzca scroll del documento.
        await JS.InvokeVoidAsync("simuladorFitViewport", paginaRootRef);
    }

    private void ActualizarTituloPagina()
    {
        Header.Set(TieneContextoCredito
            ? $"Configurar calendario · Crédito {AgencyCode}-{CreditCode}"
            : "Simulador de cronograma de cuotas");
    }

    public void Dispose()
    {
        Header.Clear();
    }

    private static string PeriodicidadLabel(int nSubProd) => Periodicidades.FirstOrDefault(p => p.NSubProd == nSubProd)?.Label ?? "Mensual";

    private async Task ToggleDiaAsync(Action toggle)
    {
        toggle();
        await SimularAsync();
    }

    private async Task RestablecerAsync()
    {
        if (AplicarContextoCredito())
        {
            ActualizarTituloPagina();
            await SimularAsync();
            return;
        }

        nProd = 4;
        monto = 500m;
        cuotas = 12;
        nSubProd = 4;
        fechaInicio = DateTime.Today;
        permiteSabado = permiteDomingo = permiteFeriado = false;
        nCategoria = 1;
        bRefinanciado = false;
        tasaOverrideStr = null;
        gastoOverrideStr = null;
        ActualizarTituloPagina();
        await SimularAsync();
    }

    private bool AplicarContextoCredito()
    {
        if (!TieneContextoCredito || Amount is not > 0 || Installments is not > 0 ||
            Product is not > 0 || SubProduct is not > 0)
            return false;

        nCodAge = AgencyCode!.Value;
        nProd = Product!.Value;
        nSubProd = SubProduct!.Value;
        monto = Amount!.Value;
        cuotas = Installments!.Value;
        fechaInicio = StartDate?.Date ?? DateTime.Today;
        tasaOverrideStr = Rate?.ToString(System.Globalization.CultureInfo.InvariantCulture);
        gastoOverrideStr = null;
        permiteSabado = permiteDomingo = permiteFeriado = false;
        nCategoria = 1;
        bRefinanciado = false;
        return true;
    }

    private async Task SimularAsync()
    {
        error = null;

        if (nCodAge <= 0 || monto <= 0 || cuotas <= 0)
        {
            resultado = null;
            return;
        }

        cargando = true;
        StateHasChanged();

        decimal? tasaOverride = decimal.TryParse(tasaOverrideStr, out var t) ? t : null;
        decimal? gastoOverride = decimal.TryParse(gastoOverrideStr, out var g) ? g : null;

        var request = new CreditFlow.Web.Models.SimularCalendarioRequest
        {
            NProd = nProd,
            NSubProd = nSubProd,
            NPlazo = cuotas,
            Monto = monto,
            FechaInicio = fechaInicio,
            TasaOverride = tasaOverride,
            GastoOverride = gastoOverride,
            NCodAge = nCodAge,
            NMoneda = 1,
            NCodCamp = 0,
            NCodLinea = CreditLineCode ?? 0,
            NCategoria = nCategoria,
            BRefinanciado = bRefinanciado,
            BCustodia = false,
            PermiteSabado = permiteSabado,
            PermiteDomingo = permiteDomingo,
            PermiteFeriado = permiteFeriado
        };

        var (exito, mensaje, data) = await SimulacionService.SimularAsync(request);

        cargando = false;
        if (exito)
        {
            resultado = data;
            paginaSkip = 0;
            paginaKey++;
        }
        else
        {
            resultado = null;
            error = (mensaje ?? "No se pudo generar el cronograma.")
                + " Probá con otra categoría, monto, plazo o periodicidad — no todas las combinaciones tienen línea configurada.";
        }
    }

    private bool EstaCuadrado => SaldoFinal == 0m;

    private decimal SaldoFinal => resultado?.Cronograma.Count > 0 ? resultado.Cronograma[^1].SaldoDespues : 0m;

    private static string Money(decimal v) => v.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-SV"));

    private static decimal Pct(decimal parte, decimal total) => total <= 0 ? 0 : Math.Round(parte / total * 100, 2);

    private record ResumenItem(string Key, string Value, bool Strong);

    private List<ResumenItem> ResumenItems()
    {
        if (resultado is null) return new();

        return new List<ResumenItem>
        {
            new("Total a pagar", Money(resultado.TotalPagado), true),
            new("Capital", Money(resultado.MontoSolicitado), false),
            new("Costo del crédito", Money(resultado.CostoTotalCredito), false),
            new("Tasa mensual", resultado.TasaNominalMensual.ToString("0.00") + " %", false),
            new("TEA real", (resultado.TeaReal * 100).ToString("0.00") + " %", false),
            new("Saldo final", Money(SaldoFinal), false),
        };
    }

    private List<CreditFlow.Web.Models.CuotaDetalleResponse> FilasVisibles()
    {
        if (resultado is null) return new();
        return resultado.Cronograma.Skip(paginaSkip).Take(FilasPorPagina).ToList();
    }

    private void OnPageChanged(Radzen.PagerEventArgs args)
    {
        paginaSkip = args.Skip;
    }

    private async Task ExportarCsvAsync()
    {
        if (resultado is null) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Cuota,Vencimiento,Capital,Interes,IVA,Gasto,Total,Saldo");
        foreach (var r in resultado.Cronograma)
        {
            sb.AppendLine($"{r.NroCuota},{r.FechaVencimiento:dd/MM/yyyy},{r.Capital},{r.Interes},{r.Iva},{r.Gasto},{r.TotalCuota},{r.SaldoDespues}");
        }

        var bytes = new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: true).GetBytes(sb.ToString());
        await JS.InvokeVoidAsync("Radzen.downloadFile", "cronograma.csv", bytes, "text/csv");
    }
}
