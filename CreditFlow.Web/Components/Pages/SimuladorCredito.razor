@page "/simulador-credito"
@attribute [Authorize(Roles = "Admin,Supervisor,Tecnologia")]
@using CreditFlow.Web.Models.Mantenimientos

<PageTitle>Simulador de Crédito</PageTitle>

<div class="sim-page">

  <header class="sim-header">
    <div class="sim-header-inner">
      <div>
        <h1 class="sim-title">Simulador de cronograma de cuotas</h1>
        <div class="sim-subtitle">Microcréditos · @PeriodicidadLabel(nSubProd) · Moneda nacional</div>
      </div>
      @if (resultado is not null)
      {
        <div class="sim-status-wrap">
          <span class="sim-status @(EstaCuadrado ? "ok" : "bad")">
            <span class="sim-status-dot"></span>
            @(EstaCuadrado ? "Cronograma cuadrado" : $"Descuadre de {Money(SaldoFinal)}")
          </span>
          <button class="sim-btn-outline" @onclick="ExportarCsvAsync" disabled="@(resultado is null)">Exportar CSV</button>
        </div>
      }
    </div>
  </header>

  <div class="sim-body">

    <div class="sim-sidebar">
      <div class="sim-card">
        <div class="sim-card-head">
          <span class="sim-kick">Condiciones</span>
          <button class="sim-btn-mini" @onclick="RestablecerAsync">Restablecer</button>
        </div>

        <div class="sim-field">
          <label class="sim-label">Agencia</label>
          <select class="sim-input" @bind="nCodAge" @bind:after="SimularAsync">
            <option value="0">Seleccione...</option>
            @foreach (var a in agencias)
            {
              <option value="@a.NCodAge">@a.Nombre</option>
            }
          </select>
        </div>

        <div class="sim-field">
          <div class="sim-row-between"><span class="sim-label">Préstamo</span><span class="sim-num sim-num-strong">@Money(monto)</span></div>
          <input type="range" min="50" max="10000" step="50" class="sim-slider" @bind="monto" @bind:event="onchange" @bind:after="SimularAsync" />
        </div>

        <div class="sim-field">
          <div class="sim-row-between"><span class="sim-label">Nro. de cuotas</span><span class="sim-num sim-num-strong">@cuotas</span></div>
          <input type="range" min="1" max="48" step="1" class="sim-slider" @bind="cuotas" @bind:event="onchange" @bind:after="SimularAsync" />
        </div>

        <div class="sim-field">
          <span class="sim-label">Periodicidad</span>
          <div class="sim-pill-row">
            @foreach (var p in Periodicidades)
            {
              <button class="sim-pill @(nSubProd == p.NSubProd ? "on" : "")" @onclick="() => SeleccionarPeriodicidadAsync(p.NSubProd)">@p.Label</button>
            }
          </div>
        </div>

        <div class="sim-field-grid">
          <div class="sim-field">
            <label class="sim-label">Categoría del cliente</label>
            <select class="sim-input" @bind="nCategoria" @bind:after="SimularAsync">
              @for (int c = 1; c <= 16; c++)
              {
                <option value="@c">Categoría @c</option>
              }
            </select>
          </div>
          <div class="sim-field">
            <label class="sim-label">Desembolso</label>
            <input type="date" class="sim-input" @bind="fechaInicio" @bind:after="SimularAsync" />
          </div>
        </div>
        <span class="sim-note">La categoría del cliente (según su evaluación crediticia) determina qué línea de tarifario aplica — no todas las combinaciones de monto/plazo/periodicidad existen para todas las categorías.</span>

        <div class="sim-field">
          <span class="sim-label">Cobrar también en</span>
          <div class="sim-pill-row">
            <button class="sim-pill @(permiteSabado ? "on" : "")" @onclick="() => ToggleDiaAsync(d => permiteSabado = !permiteSabado)">Sábado</button>
            <button class="sim-pill @(permiteDomingo ? "on" : "")" @onclick="() => ToggleDiaAsync(d => permiteDomingo = !permiteDomingo)">Domingo</button>
            <button class="sim-pill @(permiteFeriado ? "on" : "")" @onclick="() => ToggleDiaAsync(d => permiteFeriado = !permiteFeriado)">Feriados</button>
          </div>
          <span class="sim-note">Los vencimientos que caen en día no habilitado se corren al siguiente día hábil.</span>
        </div>

        <details class="sim-details">
          <summary class="sim-summary">Parámetros avanzados</summary>
          <div class="sim-field-grid">
            <div class="sim-field">
              <label class="sim-label">Refinanciado</label>
              <select class="sim-input" @bind="bRefinanciadoStr" @bind:after="SimularAsync">
                <option value="false">No</option>
                <option value="true">Sí</option>
              </select>
            </div>
            <div class="sim-field">
              <label class="sim-label">Tasa mensual (override)</label>
              <input type="text" class="sim-input" placeholder="Automática" @bind="tasaOverrideStr" @bind:after="SimularAsync" />
            </div>
            <div class="sim-field">
              <label class="sim-label">Gasto por cuota (override)</label>
              <input type="text" class="sim-input" placeholder="Automático" @bind="gastoOverrideStr" @bind:after="SimularAsync" />
            </div>
          </div>
        </details>
      </div>
    </div>

    <div class="sim-main">

      @if (cargando)
      {
        <div class="sim-card sim-loading">Calculando cronograma...</div>
      }
      else if (error is not null)
      {
        <div class="sim-alert">
          <span class="sim-alert-dot"></span>
          <div>@error</div>
        </div>
      }
      else if (resultado is not null)
      {
        <div class="sim-card sim-summary-card">
          <div class="sim-summary-top">
            <div class="sim-cuota-block">
              <div class="sim-kick">Cuota @PeriodicidadLabel(nSubProd).ToLower()</div>
              <div class="sim-cuota-num">@Money(resultado.CuotaFija)</div>
              <div class="sim-linea-nota">@resultado.LineaUsada</div>
            </div>
            <div class="sim-summary-grid">
              @foreach (var s in ResumenItems())
              {
                <div class="sim-summary-item">
                  <div class="sim-summary-key">@s.Key</div>
                  <div class="sim-num @(s.Strong ? "sim-summary-val-strong" : "sim-summary-val")">@s.Value</div>
                </div>
              }
            </div>
          </div>

          <div class="sim-bar">
            <div class="sim-bar-seg cap" style="width:@Pct(resultado.TotalCapital, resultado.TotalPagado)%"></div>
            <div class="sim-bar-seg int" style="width:@Pct(resultado.TotalInteres, resultado.TotalPagado)%"></div>
            <div class="sim-bar-seg iva" style="width:@Pct(resultado.TotalIva, resultado.TotalPagado)%"></div>
            <div class="sim-bar-seg gas" style="width:@Pct(resultado.TotalGasto, resultado.TotalPagado)%"></div>
          </div>
          <div class="sim-legend">
            <div class="sim-legend-item"><span class="sim-dot cap"></span>Capital <span class="sim-num">@Money(resultado.TotalCapital)</span></div>
            <div class="sim-legend-item"><span class="sim-dot int"></span>Interés <span class="sim-num">@Money(resultado.TotalInteres)</span></div>
            <div class="sim-legend-item"><span class="sim-dot iva"></span>IVA <span class="sim-num">@Money(resultado.TotalIva)</span></div>
            <div class="sim-legend-item"><span class="sim-dot gas"></span>Gastos <span class="sim-num">@Money(resultado.TotalGasto)</span></div>
          </div>
        </div>

        <div class="sim-card sim-table-card">
          <div class="sim-table-head">
            <div class="sim-table-title">
              Detalle de cuotas
              <span class="sim-badge">@resultado.Cronograma.Count pagos</span>
            </div>
            <div class="sim-pill-row">
              @foreach (var v in new[] { "Todas", "Primeras 6", "Últimas 6" })
              {
                <button class="sim-pill sm @(vista == v ? "on" : "")" @onclick="() => vista = v">@v</button>
              }
            </div>
          </div>

          <div class="sim-table-scroll">
            <div class="sim-table-grid sim-table-header">
              <div class="sim-th">Cuota</div>
              <div class="sim-th">Vencimiento</div>
              <div class="sim-th num">Capital</div>
              <div class="sim-th num">Interés</div>
              <div class="sim-th num">IVA</div>
              <div class="sim-th num">Gastos</div>
              <div class="sim-th num">Total</div>
              <div class="sim-th num">Saldo</div>
            </div>

            @foreach (var r in FilasVisibles())
            {
              <div class="sim-table-grid sim-table-row">
                <div class="sim-td muted">@r.NroCuota</div>
                <div class="sim-td num">@r.FechaVencimiento.ToString("dd MMM yy")</div>
                <div class="sim-td num strong">@Money(r.Capital)</div>
                <div class="sim-td num">@Money(r.Interes)</div>
                <div class="sim-td num">@Money(r.Iva)</div>
                <div class="sim-td num">@Money(r.Gasto)</div>
                <div class="sim-td num strong">@Money(r.TotalCuota)</div>
                <div class="sim-td num @(r.SaldoDespues == 0 ? "verde" : "")">@Money(r.SaldoDespues)</div>
              </div>
            }

            <div class="sim-table-grid sim-table-footer">
              <div class="sim-td strong">Total</div>
              <div></div>
              <div class="sim-td num strong">@Money(resultado.TotalCapital)</div>
              <div class="sim-td num strong">@Money(resultado.TotalInteres)</div>
              <div class="sim-td num strong">@Money(resultado.TotalIva)</div>
              <div class="sim-td num strong">@Money(resultado.TotalGasto)</div>
              <div class="sim-td num strong">@Money(resultado.TotalPagado)</div>
              <div></div>
            </div>
          </div>
        </div>
      }
      else
      {
        <div class="sim-card sim-loading">Seleccione una agencia para generar el cronograma.</div>
      }
    </div>
  </div>
</div>

@code {
    [Inject] private CreditFlow.Web.Services.Mantenimientos.IAgenciaService AgenciaService { get; set; } = default!;
    [Inject] private CreditFlow.Web.Services.ISimulacionCalendarioService SimulacionService { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private List<AgenciaDto> agencias = new();

    private int nCodAge;
    private decimal monto = 500m;
    private int cuotas = 12;
    private int nSubProd = 4;
    private DateTime fechaInicio = DateTime.Today;
    private bool permiteSabado;
    private bool permiteDomingo;
    private bool permiteFeriado;
    private int nCategoria = 1;
    private bool bRefinanciado;
    private string bRefinanciadoStr
    {
        get => bRefinanciado.ToString().ToLowerInvariant();
        set => bRefinanciado = value == "true";
    }
    private string? tasaOverrideStr;
    private string? gastoOverrideStr;

    private bool cargando;
    private string? error;
    private CreditFlow.Web.Models.SimularCalendarioResponse? resultado;
    private string vista = "Todas";

    private record OpcionPeriodicidad(string Label, int NSubProd);
    private static readonly List<OpcionPeriodicidad> Periodicidades = new()
    {
        new("Diario", 1),
        new("Semanal", 2),
        new("Quincenal", 3),
        new("Mensual", 4),
    };

    protected override async Task OnInitializedAsync()
    {
        agencias = await AgenciaService.ObtenerTodasAsync();
        if (agencias.Count > 0)
        {
            nCodAge = agencias[0].NCodAge;
            await SimularAsync();
        }
    }

    private static string PeriodicidadLabel(int nSubProd) => Periodicidades.FirstOrDefault(p => p.NSubProd == nSubProd)?.Label ?? "Mensual";

    private async Task SeleccionarPeriodicidadAsync(int subProd)
    {
        nSubProd = subProd;
        await SimularAsync();
    }

    private async Task ToggleDiaAsync(Action<bool> _)
    {
        await SimularAsync();
    }

    private async Task RestablecerAsync()
    {
        monto = 500m;
        cuotas = 12;
        nSubProd = 4;
        fechaInicio = DateTime.Today;
        permiteSabado = permiteDomingo = permiteFeriado = false;
        nCategoria = 1;
        bRefinanciado = false;
        tasaOverrideStr = null;
        gastoOverrideStr = null;
        await SimularAsync();
    }

    private async Task SimularAsync()
    {
        error = null;

        if (nCodAge <= 0 || monto <= 0 || cuotas <= 0)
        {
            resultado = null;
            return;
        }

        cargando = true;
        StateHasChanged();

        decimal? tasaOverride = decimal.TryParse(tasaOverrideStr, out var t) ? t : null;
        decimal? gastoOverride = decimal.TryParse(gastoOverrideStr, out var g) ? g : null;

        var request = new CreditFlow.Web.Models.SimularCalendarioRequest
        {
            NProd = 4,
            NSubProd = nSubProd,
            NPlazo = cuotas,
            Monto = monto,
            FechaInicio = fechaInicio,
            TasaOverride = tasaOverride,
            GastoOverride = gastoOverride,
            NCodAge = nCodAge,
            NMoneda = 1,
            NCodCamp = 0,
            NCategoria = nCategoria,
            BRefinanciado = bRefinanciado,
            BCustodia = false,
            PermiteSabado = permiteSabado,
            PermiteDomingo = permiteDomingo,
            PermiteFeriado = permiteFeriado
        };

        var (exito, mensaje, data) = await SimulacionService.SimularAsync(request);

        cargando = false;
        if (exito)
        {
            resultado = data;
        }
        else
        {
            resultado = null;
            error = (mensaje ?? "No se pudo generar el cronograma.")
                + " Probá con otra categoría, monto, plazo o periodicidad — no todas las combinaciones tienen línea configurada.";
        }
    }

    private bool EstaCuadrado => SaldoFinal == 0m;

    private decimal SaldoFinal => resultado?.Cronograma.Count > 0 ? resultado.Cronograma[^1].SaldoDespues : 0m;

    private static string Money(decimal v) => v.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("es-SV"));

    private static decimal Pct(decimal parte, decimal total) => total <= 0 ? 0 : Math.Round(parte / total * 100, 2);

    private record ResumenItem(string Key, string Value, bool Strong);

    private List<ResumenItem> ResumenItems()
    {
        if (resultado is null) return new();
        var primera = resultado.Cronograma.FirstOrDefault();
        var ultima = resultado.Cronograma.LastOrDefault();

        return new List<ResumenItem>
        {
            new("Total a pagar", Money(resultado.TotalPagado), true),
            new("Capital", Money(resultado.MontoSolicitado), false),
            new("Costo del crédito", Money(resultado.CostoTotalCredito), false),
            new("Tasa mensual", resultado.TasaNominalMensual.ToString("0.00") + " %", false),
            new("Primera cuota", primera?.FechaVencimiento.ToString("dd MMM yyyy") ?? "-", false),
            new("Última cuota", ultima?.FechaVencimiento.ToString("dd MMM yyyy") ?? "-", false),
            new("TEA real", (resultado.TeaReal * 100).ToString("0.00") + " %", false),
            new("Saldo final", Money(SaldoFinal), false),
        };
    }

    private List<CreditFlow.Web.Models.CuotaDetalleResponse> FilasVisibles()
    {
        if (resultado is null) return new();
        return vista switch
        {
            "Primeras 6" => resultado.Cronograma.Take(6).ToList(),
            "Últimas 6" => resultado.Cronograma.TakeLast(6).ToList(),
            _ => resultado.Cronograma
        };
    }

    private async Task ExportarCsvAsync()
    {
        if (resultado is null) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Cuota,Vencimiento,Capital,Interes,IVA,Gasto,Total,Saldo");
        foreach (var r in resultado.Cronograma)
        {
            sb.AppendLine($"{r.NroCuota},{r.FechaVencimiento:dd/MM/yyyy},{r.Capital},{r.Interes},{r.Iva},{r.Gasto},{r.TotalCuota},{r.SaldoDespues}");
        }

        var bytes = new System.Text.UTF8Encoding(encoderShouldEmitUTF8Identifier: true).GetBytes(sb.ToString());
        await JS.InvokeVoidAsync("Radzen.downloadFile", "cronograma.csv", bytes, "text/csv");
    }
}
