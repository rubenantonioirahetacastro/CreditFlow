@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<CdsPageState Kind="CdsPageStateKind.Error"
              Title="Ocurrió un error inesperado"
              Message="@ErrorMessage"
              ActionText="Volver a intentar"
              OnAction="@Reload" />

@code{
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);
    private string ErrorMessage => ShowRequestId
        ? $"No pudimos completar la operación. Código de referencia: {RequestId}"
        : "No pudimos completar la operación. Intentá nuevamente.";

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

    private void Reload() => NavigationManager.Refresh(forceReload: true);
}
