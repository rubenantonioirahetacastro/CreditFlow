@* Avatar genérico con foto/iniciales, usado por Empleados (editable) y por la
   Bandeja de verificación (solo lectura). Cada pantalla le pasa cómo pedir la
   foto vía ObtenerFotoDataUrl en vez de que este componente sepa de Empleado
   o de Persona/SolicitudCredito. *@
<div class="avatar-contenedor">
    @if (UrlMostrada is not null)
    {
        <img src="@UrlMostrada" alt="Foto de @Iniciales" class="avatar-foto" />
    }
    else
    {
        <span class="avatar-iniciales" style="background-color:@Color">@Iniciales</span>
    }

    @if (Editable)
    {
        <label class="avatar-upload-overlay">
            <span class="avatar-upload-icono">
                <RadzenIcon Icon="photo_camera" />
            </span>
            <InputFile OnChange="OnFotoSeleccionada" accept="image/png,image/jpeg,image/webp" class="avatar-upload-input" />
        </label>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public bool TieneFoto { get; set; }
    [Parameter] public string? PreviewUrl { get; set; }
    [Parameter] public string Iniciales { get; set; } = string.Empty;
    [Parameter] public string Color { get; set; } = "#142143";
    [Parameter] public bool Editable { get; set; }
    [Parameter] public EventCallback<InputFileChangeEventArgs> OnFotoSeleccionada { get; set; }

    // Cada pantalla decide cómo se pide la foto (EmpleadoService, VerificacionService, etc.)
    [Parameter, EditorRequired] public Func<int, Task<string?>> ObtenerFotoDataUrl { get; set; } = default!;

    private string? fotoUrl;
    private int idCargado = -1;

    private string? UrlMostrada => PreviewUrl ?? fotoUrl;

    protected override async Task OnParametersSetAsync()
    {
        if (!TieneFoto || PreviewUrl is not null || Id == 0)
            return;

        if (idCargado == Id)
            return;

        idCargado = Id;
        fotoUrl = await ObtenerFotoDataUrl(Id);
    }
}
