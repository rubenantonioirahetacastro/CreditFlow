@* Chip de estado reutilizable (columna "Estado" de cualquier grid). El color
   sale de EstadoSolicitudCatalogo por NValor; el nombre se recibe ya
   resuelto (viene de CatalogoCodigo desde el backend) para no tener que
   volver a pedir el catálogo solo para pintar un chip.

   Estilo inline a propósito: el CSS aislado (.razor.css) de Blazor se
   bundlea en build y en este proyecto se ha quedado desactualizado varias
   veces con dotnet watch, dejando el chip sin forma/color hasta reiniciar
   el proceso a mano. Inline evita depender de ese bundle. *@
<span style="@EstiloChip">
    <span style="@EstiloPunto"></span>
    @(Nombre ?? "Desconocido")
</span>

@code {
    [Parameter] public int EstadoId { get; set; }
    [Parameter] public string? Nombre { get; set; }

    private EstadoColor color => EstadoSolicitudCatalogo.Resolver(EstadoId);

    private string EstiloChip =>
        "display:inline-flex;align-items:center;gap:6px;padding:3px 12px;border-radius:999px;" +
        "font-size:0.8rem;font-weight:600;line-height:1.4;white-space:nowrap;" +
        $"color:{color.Color};background-color:{color.ColorFondo};border:1px solid {color.Color};";

    private string EstiloPunto =>
        $"width:7px;height:7px;border-radius:50%;background-color:{color.Color};flex:0 0 auto;display:inline-block;";
}
