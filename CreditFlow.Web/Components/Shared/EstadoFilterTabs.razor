@* Barra de chips de filtro por estado, reutilizable en cualquier listado de
   créditos. Los estados vienen del catálogo real (CatalogoCodigo, código
   116 "Estados del Credito") vía ObtenerCatalogoCodigos — no de una lista
   fija en código — así nunca se desincroniza con lo que hay en BD. El color
   de cada uno sale de EstadoSolicitudCatalogo por NValor.

   Este componente solo cuenta cuántos ítems caen en cada estado y avisa
   cuál quedó seleccionado; identifica por NValor (int), no por nombre, para
   no romperse con typos o cambios de redacción del catálogo. *@
@typeparam TItem
@using CreditFlow.Web.Shared.CatalogoCodigos.Services
@inject ObtenerCatalogoCodigos ObtenerCatalogoCodigos

<div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:14px;">
    <button type="button" @onclick="() => Seleccionar(null)" style="@EstiloTab(Selected is null, "#374151")">
        <span style="@EstiloPunto("#374151")"></span>
        <span>Todos</span>
        <span style="@EstiloContador">@Items.Count()</span>
    </button>

    @foreach (var estado in estados)
    {
        var nValor = estado.NValor;
        var color = EstadoSolicitudCatalogo.Resolver(nValor).Color;
        var cantidad = Items.Count(i => EstadoSelector(i) == nValor);

        <button type="button" @onclick="() => Seleccionar(nValor)" style="@EstiloTab(Selected == nValor, color)">
            <span style="@EstiloPunto(color)"></span>
            <span>@estado.CNomCod</span>
            <span style="@EstiloContador">@cantidad</span>
        </button>
    }
</div>

@code {
    private const int CodigoCatalogoEstadosCredito = 116;

    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = Enumerable.Empty<TItem>();

    [Parameter, EditorRequired] public Func<TItem, int> EstadoSelector { get; set; } = default!;

    // null = "Todos" seleccionado.
    [Parameter] public int? Selected { get; set; }

    [Parameter] public EventCallback<int?> SelectedChanged { get; set; }

    private List<CatalogoCodigoDto> estados = new();

    protected override async Task OnInitializedAsync()
    {
        var catalogo = await ObtenerCatalogoCodigos.ObtenerCatalogoCodigo(CodigoCatalogoEstadosCredito);

        // Descarta cualquier fila "de encabezado" del catálogo (NValor == NCodigo,
        // p. ej. NValor=116 "Estados del Credito"), que no es un estado real.
        estados = catalogo.Where(c => c.NValor != c.NCodigo).ToList();
    }

    private Task Seleccionar(int? estado) => SelectedChanged.InvokeAsync(estado);

    private const string EstiloContador =
        "background:#F3F4F6;color:#6B7280;border-radius:999px;padding:1px 8px;font-size:0.75rem;font-weight:700;";

    // Orillita del color del estado cuando el tab está activo; gris suave cuando no.
    private static string EstiloTab(bool activo, string color) =>
        "display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:999px;" +
        $"border:1px solid {(activo ? color : "#E5E7EB")};background:#FFFFFF;cursor:pointer;" +
        "font-size:0.85rem;font-weight:600;color:#374151;";

    private static string EstiloPunto(string color) =>
        $"width:8px;height:8px;border-radius:50%;background-color:{color};flex:0 0 auto;display:inline-block;";
}
