<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/material-base.css" />
    <link rel="stylesheet" href="@VersionedAsset("app.css")" />
    <link rel="stylesheet" href="@VersionedAsset("CreditFlow.Web.styles.css")" />
    <link rel="icon" type="image/svg+xml" href="images/crediflow-mark.svg" />
    <link rel="alternate icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    <script src="@VersionedAsset("js/simulador.js")"></script>
</body>

</html>

@code {
    private static readonly string AssetVersion = typeof(App).Assembly.ManifestModule.ModuleVersionId.ToString("N");

    private static string VersionedAsset(string path) => $"{path}?v={AssetVersion}";
}
