@using CreditFlow.Web.Core.Utils.Format

<CdsTextField Value="@Value"
              ValueChanged="@OnValueChanged"
              Placeholder="@EffectivePlaceholder"
              Disabled="@Disabled"
              ReadOnly="@ReadOnly"
              MaxLength="@MaxLength"
              Style="@Style"
              NativeForm="@NativeForm"
              inputmode="numeric"
              @attributes="AdditionalAttributes" />

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public DocumentType DocumentType { get; set; } = DocumentType.Dui;
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>Input nativo con el estilo de formulario (paneles laterales), igual que <see cref="CdsTextField.NativeForm"/>.</summary>
    [Parameter] public bool NativeForm { get; set; }
    [Parameter] public string Style { get; set; } = "width:100%";
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string EffectivePlaceholder => Placeholder
        ?? (DocumentType == DocumentType.Dui ? "00000000-0" : "0000-000000-000-0");

    private long MaxLength => DocumentType == DocumentType.Dui ? 10 : 17;

    private Task OnValueChanged(string value) =>
        ValueChanged.InvokeAsync(DocumentFormatter.Format(value, DocumentType));
}
