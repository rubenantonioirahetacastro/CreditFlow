@* Panel lateral derecho (440px) con fondo oscuro difuminado para crear o editar sin salir de la pantalla. *@
@if (Open)
{
    <div class="cds-drawer" role="dialog" aria-modal="true" aria-label="@Title" @onkeydown="OnKeyDown">
        <div class="cds-drawer__backdrop" @onclick="CerrarAsync"></div>
        <aside class="cds-drawer__panel">
            <header class="cds-drawer__header">
                <div class="cds-drawer__titles">
                    <span class="cds-drawer__title">@Title</span>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <span class="cds-drawer__subtitle">@Subtitle</span>
                    }
                </div>
                <button type="button" class="cds-drawer__close" title="Cerrar" aria-label="Cerrar" @onclick="CerrarAsync">
                    <RadzenIcon Icon="close" />
                </button>
            </header>
            <div class="cds-drawer__body">
                @ChildContent
            </div>
            @if (Footer is not null)
            {
                <footer class="cds-drawer__footer">
                    @Footer
                </footer>
            }
        </aside>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Footer { get; set; }

    private Task CerrarAsync() => OnClose.InvokeAsync();

    private Task OnKeyDown(KeyboardEventArgs e) => e.Key == "Escape" ? CerrarAsync() : Task.CompletedTask;
}
