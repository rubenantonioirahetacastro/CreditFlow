@using Radzen

@if (NativeForm)
{
    <input type="text"
           class="cds-native-field"
           value="@Value"
           placeholder="@Placeholder"
           disabled="@Disabled"
           readonly="@ReadOnly"
           maxlength="@MaxLength"
           @oninput="OnNativeInput"
           @attributes="AdditionalAttributes" />
}
else
{
    <RadzenTextBox Value="@Value"
                   Change="@OnValueChanged"
                   Placeholder="@Placeholder"
                   Disabled="@Disabled"
                   ReadOnly="@ReadOnly"
                   MaxLength="@MaxLength"
                   Style="@Style"
                   @attributes="AdditionalAttributes" />
}

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool NativeForm { get; set; }
    [Parameter] public long? MaxLength { get; set; }
    [Parameter] public string Style { get; set; } = "width:100%";
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private Task OnValueChanged(string value) => ValueChanged.InvokeAsync(value);

    private Task OnNativeInput(ChangeEventArgs args) =>
        OnValueChanged(args.Value?.ToString() ?? string.Empty);
}
