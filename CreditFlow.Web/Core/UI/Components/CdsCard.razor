<div class="@CssClass" style="@Style" @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
    [Parameter] public CdsCardPadding Padding { get; set; } = CdsCardPadding.Default;
    [Parameter] public bool ShowSurface { get; set; } = true;
    [Parameter] public bool Interactive { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => string.Join(" ", new[]
    {
        "cds-card",
        ShowSurface ? null : "cds-card-plain",
        $"cds-card-{Padding.ToString().ToLowerInvariant()}",
        Interactive ? "cds-card-interactive" : null,
        Class
    }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
