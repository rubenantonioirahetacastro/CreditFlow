@typeparam TItem where TItem : notnull
@attribute [CascadingTypeParameter(nameof(TItem))]
@using ClosedXML.Excel
@inject IJSRuntime JS

@* Contenedor propio: da ancla a los estilos ::deep y aplica la especificación de tabla de DESIGN.md. *@
<div class="cds-grid @(FillHeight ? "cds-grid--fill" : null)">
@if (IsLoading)
{
    <CdsPageState Kind="CdsPageStateKind.Loading"
                  Title="@LoadingText"
                  Compact="true" />
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <CdsPageState Kind="CdsPageStateKind.Error"
                  Title="No pudimos cargar la información"
                  Message="@ErrorMessage"
                  OnAction="@OnRetry"
                  Compact="true" />
}
else
{
    @if (ShowExportButton && Data?.Any() == true)
    {
        <div class="cds-grid__toolbar">
            <CdsExportButton Format="CdsExportFormat.Excel" Click="@ExportarExcelAsync" />
        </div>
    }

    <RadzenDataGrid @ref="Grid"
                TItem="TItem"
                Data="@Data"
                IsLoading="@IsLoading"
                EmptyText="@EmptyText"
                Style="@GridStyle"
                AllowFiltering="true"
                AllowSorting="true"
                AllowGrouping="false"
                AllowAlternatingRows="false"
                AllowPaging="true"
                PagerAlwaysVisible="true"
                PagerHorizontalAlign="HorizontalAlign.Center"
                PageSize="@PageSize"
                ShowPagingSummary="true"
                PagingSummaryFormat="Página {0} de {1} ({2} elementos)"
                FilterMode="FilterMode.Advanced"
                EditMode="@EditMode"
                RowEdit="@RowEdit"
                RowUpdate="@RowUpdate"
                RowCreate="@RowCreate"
                RowRender="@RowRender"
                SelectionMode="@(SelectionMode ?? DataGridSelectionMode.Single)"
                Value="@seleccionados"
                ValueChanged="@ValueChangedCallback"
                RowSelect="@RowSelect"
                RowDeselect="@RowDeselect">
        <EmptyTemplate>
            <CdsPageState Kind="CdsPageStateKind.Empty"
                          Title="@EmptyText"
                          ShowSurface="false"
                          Compact="true" />
        </EmptyTemplate>
        <Columns>
            @ChildContent
        </Columns>
    </RadzenDataGrid>

    @if (ShowAddButton)
    {
        <RadzenFab Icon="add"
                   ButtonStyle="ButtonStyle.Primary"
                   Size="ButtonSize.Large"
                   Disabled="@AddDisabled"
                   Click="@OnAdd"
                   title="@AddButtonTitle"
                   class="fab-add-btn"
                   Style="position: fixed; bottom: 2rem; right: 2rem; z-index: 1000;" />
    }
}
</div>

@code {
    /// <summary>
    /// Muestra el botón Excel encima de la grilla. Las páginas que tienen encabezado de tarjeta
    /// (<see cref="CdsCardHeader"/>) lo ocultan y llaman a <see cref="ExportarExcelAsync"/> desde sus acciones.
    /// </summary>
    [Parameter] public bool ShowExportButton { get; set; } = true;

    /// <summary>
    /// Ocupa todo el alto disponible del contenedor (tarjeta con altura definida). Si es falso usa la altura clásica
    /// relativa a la ventana.
    /// </summary>
    [Parameter] public bool FillHeight { get; set; }

    [Parameter] public int PageSize { get; set; } = 10;

    private string? GridStyle => FillHeight ? null : "height: calc(100vh - 240px);";

    [Parameter] public IEnumerable<TItem>? Data { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public bool IsLoading { get; set; }

    [Parameter] public string LoadingText { get; set; } = "Cargando información…";

    [Parameter] public string? ErrorMessage { get; set; }

    [Parameter] public EventCallback OnRetry { get; set; }

    [Parameter] public string EmptyText { get; set; } = "No hay datos para mostrar.";

    public RadzenDataGrid<TItem> Grid { get; set; } = default!;

    [Parameter] public string ExportFileName { get; set; } = "export";

    [Parameter] public DataGridEditMode EditMode { get; set; } = DataGridEditMode.Single;

    [Parameter] public EventCallback<TItem> RowEdit { get; set; }

    [Parameter] public EventCallback<TItem> RowUpdate { get; set; }

    [Parameter] public EventCallback<TItem> RowCreate { get; set; }

    [Parameter] public Action<RowRenderEventArgs<TItem>>? RowRender { get; set; }

    [Parameter] public bool ShowAddButton { get; set; } = true;

    [Parameter] public bool AddDisabled { get; set; }

    [Parameter] public string AddButtonTitle { get; set; } = "Agregar";

    [Parameter] public EventCallback OnAdd { get; set; }

    [Parameter] public DataGridSelectionMode? SelectionMode { get; set; }

    [Parameter] public EventCallback<TItem> RowSelect { get; set; }

    [Parameter] public EventCallback<TItem> RowDeselect { get; set; }

    private IList<TItem> seleccionados = new List<TItem>();

    private EventCallback<IList<TItem>> ValueChangedCallback => SelectionMode.HasValue
        ? EventCallback.Factory.Create<IList<TItem>>(this, valor => seleccionados = valor)
        : default;

    /// <summary>Descarga las filas actuales (con los filtros de la página) como .xlsx con las columnas visibles.</summary>
    public async Task ExportarExcelAsync()
    {
        if (Grid is null)
            return;

        var columnas = Grid.ColumnsCollection
            .Where(c => c.Visible && !string.IsNullOrEmpty(c.Property))
            .ToList();

        using var libro = new XLWorkbook();
        var hoja = libro.Worksheets.Add("Datos");

        for (var i = 0; i < columnas.Count; i++)
            hoja.Cell(1, i + 1).Value = columnas[i].Title;
        hoja.Range(1, 1, 1, Math.Max(columnas.Count, 1)).Style.Font.SetBold()
            .Border.SetBottomBorder(XLBorderStyleValues.Thin);

        var fila = 1;
        foreach (var item in Data ?? Enumerable.Empty<TItem>())
        {
            fila++;
            for (var i = 0; i < columnas.Count; i++)
                EscribirCelda(hoja.Cell(fila, i + 1), ObtenerValor(item, columnas[i].Property), columnas[i].FormatString);
        }

        hoja.SheetView.FreezeRows(1);
        hoja.Columns(1, Math.Max(columnas.Count, 1)).AdjustToContents();

        using var stream = new MemoryStream();
        libro.SaveAs(stream);
        await JS.InvokeVoidAsync("Radzen.downloadFile", $"{ExportFileName}.xlsx", stream.ToArray(),
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
    }

    private static void EscribirCelda(IXLCell celda, object? valor, string? formatString)
    {
        switch (valor)
        {
            case null:
                return;
            case DateTime fecha:
                celda.Value = fecha;
                celda.Style.NumberFormat.Format = "dd/mm/yyyy";
                return;
            case decimal or double or float or int or long or short:
                celda.Value = Convert.ToDouble(valor);
                if (formatString?.Contains(":C", StringComparison.OrdinalIgnoreCase) == true)
                    celda.Style.NumberFormat.Format = "$#,##0.00";
                return;
            case bool b:
                celda.Value = b ? "Sí" : "No";
                return;
            default:
                celda.Value = valor.ToString();
                return;
        }
    }

    private static object? ObtenerValor(TItem item, string propertyPath)
    {
        object? valorActual = item;
        foreach (var parte in propertyPath.Split('.'))
        {
            if (valorActual is null)
                return null;

            valorActual = valorActual.GetType().GetProperty(parte)?.GetValue(valorActual);
        }

        return valorActual;
    }
}
