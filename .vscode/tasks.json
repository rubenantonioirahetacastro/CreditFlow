{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/CreditFlow.API/CreditFlow.API.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-web",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/CreditFlow.Web/CreditFlow.Web.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "watch-api",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/CreditFlow.API/CreditFlow.API.csproj",
        "--launch-profile",
        "https",
        "--non-interactive"
      ],
      "options": {
        "cwd": "${workspaceFolder}/CreditFlow.API",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet-watch-api",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*watch.*Building.*$",
          "endsPattern": "^.*(Application started|watch.*Started).*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "watch"
      }
    },
    {
      "label": "watch-web",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/CreditFlow.Web/CreditFlow.Web.csproj",
        "--launch-profile",
        "https",
        "--non-interactive"
      ],
      "options": {
        "cwd": "${workspaceFolder}/CreditFlow.Web",
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet-watch-web",
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*watch.*Building.*$",
          "endsPattern": "^.*(Application started|watch.*Started).*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "watch"
      }
    },
    {
      "label": "watch-all",
      "dependsOn": ["watch-api", "watch-web"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
